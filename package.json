{
  "name": "corelith",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --filter=@corelithzw/enterprise",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @corelithzw/enterprise run test:e2e",
    "enterprise": "pnpm --filter @corelithzw/enterprise run",
    "compose": "node scripts/compose-host.mjs",
    "db:generate": "pnpm --filter @corelithzw/db run generate",
    "db:validate": "pnpm --filter @corelithzw/db run validate",
    "db:push": "pnpm --filter @corelithzw/db run push",
    "db:migrate:dev": "pnpm --filter @corelithzw/db run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @corelithzw/db run migrate:deploy",
    "db:migrate:status": "pnpm --filter @corelithzw/db run migrate:status",
    "db:studio": "pnpm --filter @corelithzw/db run studio",
    "db:check:drift": "pnpm --filter @corelithzw/db run check:drift",
    "db:check:deps": "pnpm --filter @corelithzw/db run check:deps",
    "campus": "pnpm --filter @corelithzw/campus run",
    "dev:campus": "turbo run dev --filter=@corelithzw/campus",
    "sell": "pnpm --filter @corelithzw/sell run",
    "dev:sell": "turbo run dev --filter=@corelithzw/sell",
    "crm": "pnpm --filter @corelithzw/crm run",
    "dev:crm": "turbo run dev --filter=@corelithzw/crm",
    "people": "pnpm --filter @corelithzw/people run",
    "dev:people": "turbo run dev --filter=@corelithzw/people"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
