{
  "extends": "@corelithzw/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    "tsBuildInfoFile": ".next/cache/tsbuildinfo.json",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "scripts", "e2e"]
}
