{
  "name": "@corelithzw/campus",
  "version": "0.1.0",
  "private": true,
  "description": "The Campus host: the school product, composed from the school module, the books, compliance, people, documents, notifications, records and the offline runtime on the kernel and the shell.",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @corelithzw/db run generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node --max-old-space-size=7168 ./node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@corelithzw/db": "workspace:*",
    "@corelithzw/module-books": "workspace:*",
    "@corelithzw/module-campus": "workspace:*",
    "@corelithzw/module-compliance": "workspace:*",
    "@corelithzw/module-documents": "workspace:*",
    "@corelithzw/module-notifications": "workspace:*",
    "@corelithzw/module-offline": "workspace:*",
    "@corelithzw/module-people": "workspace:*",
    "@corelithzw/module-records": "workspace:*",
    "@corelithzw/module-workflow": "workspace:*",
    "@corelithzw/platform": "workspace:*",
    "@corelithzw/react": "^0.4.1",
    "@corelithzw/shell": "workspace:*",
    "@corelithzw/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@rtcamp/frappe-ui-react": "^1.1.0",
    "@sparticuz/chromium": "^143.0.4",
    "@tanstack/react-query": "^5.90.16",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.2.3",
    "next": "16.1.1",
    "next-auth": "^4.24.13",
    "puppeteer-core": "^24.37.5",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@corelithzw/config": "workspace:*",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4"
  }
}
