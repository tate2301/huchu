{"nodes": [{"id": "docs_expansion_plan_schools_doc", "label": "Schools Module Expansion Plan (Codebase-Aligned)", "file_type": "document", "source_file": "docs/expansion-plan/schools.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The schools implementation contract for the repository, translating the gameplan and the school implementation plan into exact modules, routes, services and models."}, {"id": "docs_expansion_plan_schools_fee_first_wedge", "label": "Fee-first wedge design principle", "file_type": "rationale", "source_file": "docs/expansion-plan/schools.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "School fees and receipts are the primary entry point; academics and boarding follow. Fees are what a school will pay for first."}, {"id": "docs_expansion_plan_schools_portal_isolation", "label": "Portal isolation architecture", "file_type": "concept", "source_file": "docs/expansion-plan/schools.md", "source_location": "\u00a72, \u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Portal users see only their shell and no main dashboard; portal routes gated by portal.* feature keys with a portalContext {role, entityId} on the session that API endpoints validate."}, {"id": "docs_expansion_plan_schools_fee_receipt_posting", "label": "End-to-end fee receipt posting architecture", "file_type": "concept", "source_file": "docs/expansion-plan/schools.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Receipt \u2192 allocate to invoices \u2192 createJournalEntryFromSource \u2192 resolve PostingRule for SCHOOL_FEE_RECEIPT \u2192 JournalEntry+JournalLine \u2192 syncPaymentLedgerEntryForSource \u2192 AR aging. Source key SCHOOL:FEE_RECEIPT:{receiptId}; journal lines must balance; overpayment carried as