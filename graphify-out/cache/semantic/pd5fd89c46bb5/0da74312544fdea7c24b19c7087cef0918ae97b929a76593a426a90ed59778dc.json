{"nodes": [{"id": "docs_industry_implementation_plans_posting_engine_housekeeping_doc", "label": "Posting Engine Housekeeping Plan", "file_type": "document", "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Addresses idempotency drift, monitoring gaps, schema/version coupling, retry policy variance, missing reconciliation and ad-hoc journal edits that bypass posting rules."}, {"id": "docs_industry_implementation_plans_posting_engine_housekeeping_idempotency", "label": "Source-key idempotency standardization", "file_type": "concept", "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforce a source key schema per module, reject duplicate keys at ingestion, carry the key into journal metadata, and validate referential integrity before posting \u2014 the mechanism every pack's 'posts with idempotent keys' criterion depends on."}, {"id": "docs_industry_implementation_plans_posting_engine_housekeeping_dlq", "label": "Retry and DLQ policy", "file_type": "concept", "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uniform capped exponential backoff, a DLQ review workflow with reprocess/ignore and an audit trail, and auto-suppression of classified permanent failures (schema mismatch, permission denied, missing config)."}, {"id": "docs_industry_implementation_plans_posting_engine_housekeeping_reconciliation", "label": "Daily source-vs-ledger reconciliation", "file_type": "concept", "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts and totals reconciled per module daily, a variance report with drill-down and export, annotated resolutions, and a per-period closing checklist covering trial balance, aging, inventory/COGS parity and tax payable."}, {"id": "docs_industry_implementation_plans_posting_engine_housekeeping_access_controls", "label": "Posting-managed account access controls", "file_type": "rationale", "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct journal edits on posting-managed accounts are locked and need approval, manual adjustments are linked back to a source or ticket, and configuring rules, posting journals and approving overrides are separated permissions."}], "edges": [{"source": "docs_industry_implementation_plans_posting_engine_housekeeping_doc", "target": "docs_industry_implementation_plans_posting_engine_housekeeping_idempotency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a71", "weight": 1}, {"source": "docs_industry_implementation_plans_posting_engine_housekeeping_doc", "target": "docs_industry_implementation_plans_posting_engine_housekeeping_dlq", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a73", "weight": 1}, {"source": "docs_industry_implementation_plans_posting_engine_housekeeping_doc", "target": "docs_industry_implementation_plans_posting_engine_housekeeping_reconciliation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a75", "weight": 1}, {"source": "docs_industry_implementation_plans_posting_engine_housekeeping_doc", "target": "docs_industry_implementation_plans_posting_engine_housekeeping_access_controls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a76", "weight": 1}, {"source": "docs_industry_implementation_plans_posting_engine_housekeeping_dlq", "target": "docs_gold_epic_13_mvp_2026_05_10_sli_accounting_backlog", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a73", "weight": 1}, {"source": "docs_industry_implementation_plans_posting_engine_housekeeping_idempotency", "target": "docs_expansion_plan_schools_fee_receipt_posting", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a71", "weight": 1}, {"source": "docs_industry_implementation_plans_posting_engine_housekeeping_reconciliation", "target": "docs_gold_module_review_2026_05_09_operational_runbook", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a75", "weight": 1}, {"source": "docs_industry_implementation_plans_posting_engine_housekeeping_idempotency", "target": "docs_gold_module_review_2026_05_09_accounting_outside_tx", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/industry-implementation-plans/posting-engine-housekeeping.md", "source_location": "Plan \u00a71", "weight": 1}], "hyperedges": []}