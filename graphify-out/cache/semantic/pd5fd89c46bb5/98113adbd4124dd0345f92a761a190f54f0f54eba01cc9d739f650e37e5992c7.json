{"nodes": [{"id": "docs_expansion_plan_zim_smb_market_gameplan_doc", "label": "Huchu Zimbabwe SMB Expansion Gameplan", "file_type": "document", "source_file": "docs/expansion-plan/zim-smb-market-gameplan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Become a configurable business platform rather than a bespoke ERP clone: thin sector packs atop shared finance/inventory/posting rails, ERP-grade integrity with SMB-friendly UX."}, {"id": "docs_expansion_plan_zim_smb_market_gameplan_platform_contract", "label": "Platform contract for every module", "file_type": "rationale", "source_file": "docs/expansion-plan/zim-smb-market-gameplan.md", "source_location": "Platform Contract", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draft \u2192 Submitted \u2192 Approved \u2192 Posted \u2192 Reversed/Cancelled with no deletes after post; posting outputs GL, AR/AP, stock ledger, compliance events and notifications with idempotent source keys, retry and dead-letter; configuration-first sector templates."}, {"id": "docs_expansion_plan_zim_smb_market_gameplan_accounting_modes", "label": "Accounting Lite and Accounting Pro modes", "file_type": "concept", "source_file": "docs/expansion-plan/zim-smb-market-gameplan.md", "source_location": "Accounting Modes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lite is the default and hides accountant jargon \u2014 CoA templates, opening balances, AR/AP basics, cashbook, VAT profiles, period locks, reversal-only corrections. Pro is opt-in for manual journals, bank reconciliation, fixed assets and budgeting when demanded."}, {"id": "docs_expansion_plan_zim_smb_market_gameplan_sector_packs", "label": "Sector packs \u2014 schools, retail/thrift, generic SMB", "file_type": "concept", "source_file": "docs/expansion-plan/zim-smb-market-gameplan.md", "source_location": "Sector Packs", "so