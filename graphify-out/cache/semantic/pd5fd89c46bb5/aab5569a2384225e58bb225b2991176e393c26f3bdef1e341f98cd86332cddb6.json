2026-05-09.md", "source_location": "\u00a73.3 P0-2", "weight": 1}, {"source": "docs_gold_module_review_2026_05_09_ignored_accounting_events", "target": "docs_gold_module_review_2026_05_09_captureaccountingevent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/gold-module-review-2026-05-09.md", "source_location": "\u00a72 #6", "weight": 1}, {"source": "docs_gold_module_review_2026_05_09_float_money_columns", "target": "docs_gold_module_review_2026_05_09_goldinventoryevent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/gold-module-review-2026-05-09.md", "source_location": "\u00a73.3 P1-13", "weight": 1}, {"source": "docs_gold_module_review_2026_05_09_architectural_opportunities", "target": "docs_gold_module_review_2026_05_09_import_workflow_redesign", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/gold-module-review-2026-05-09.md", "source_location": "\u00a73.6, \u00a79", "weight": 1}, {"source": "docs_gold_module_review_2026_05_09_float_money_columns", "target": "docs_expansion_plan_schools_production_readiness_d1_school_money_float", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/gold-module-review-2026-05-09.md", "source_location": "\u00a72 #3", "weight": 1}, {"source": "docs_gold_module_review_2026_05_09_missing_role_gates", "target": "docs_expansion_plan_schools_production_readiness_authorization_gap", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/gold-module-review-2026-05-09.md", "source_location": "\u00a72 #5", "weight": 1}, {"source": "docs_gold_module_review_2026_05_09_fifo_race", "target": "docs_expansion_plan_schools_production_readiness_d3_check_then_write_races", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/gold-module-review-2026-05-09.md", "source_location": "\u00a73.3 P0-1", "weight": 1}, {"source": "docs_gold_module_review_2026_05_09_import_workflow_redesign", "target": "docs_gold_module_review_2026_05_09_import_studio", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/gold-module-review-2026-05-09.md", "source_location": "\u00a716.4", "weight": 1}], "hyperedges": [{"id": "gold_ledger_integrity_program", "label": "Gold ledger integrity \u2014 finding, plan, execution, monitoring", "nodes": ["docs_gold_module_review_2026_05_09_append_only_violation", "docs_gold_module_review_2026_05_09_fifo_race", "docs_gold_module_review_2026_05_09_float_money_columns", "docs_gold_team_dev_brief_2026_05_09_epic_sequence", "docs_gold_team_status_2026_05_10_epic_6_decimal_companyid", "docs_gold_epic_13_mvp_2026_05_10_sli_fifo_double_link"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/gold-module-review-2026-05-09.md"}]}