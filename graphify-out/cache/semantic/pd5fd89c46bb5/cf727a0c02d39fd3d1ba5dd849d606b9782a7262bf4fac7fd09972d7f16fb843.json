{"nodes": [{"id": "docs_expansion_plan_thrift_pack_spec_doc", "label": "Thrift Pack Spec (Full Scope Implementation Contract)", "file_type": "document", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full thrift operations pack from bale intake through grading, lot inventory, sales, returns and margin reporting with strict traceability. Normative references: platform-holy-grail.md and the UX playbook."}, {"id": "docs_expansion_plan_thrift_pack_spec_addon_thrift_pack", "label": "ADDON_THRIFT_PACK bundle and gating matrix", "file_type": "concept", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nine route groups each mapped to a page prefix, an API prefix, a thrift.* feature key and a role set \u2014 the same page/API/feature/role shape the platform gating registry expects."}, {"id": "docs_expansion_plan_thrift_pack_spec_bale_lifecycle", "label": "Bale lifecycle state machine", "file_type": "concept", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a77.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RECEIVED \u2192 IN_GRADING \u2192 GRADED \u2192 CLOSED once lots are created and balanced, with void transitions out of RECEIVED and IN_GRADING."}, {"id": "docs_expansion_plan_thrift_pack_spec_lot_lifecycle", "label": "Lot lifecycle state machine", "file_type": "concept", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a77.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OPEN cycles on sales/returns, DEPLETED at zero on-hand and back to OPEN on a positive return or adjustment, with managerial close and reversal void paths."}, {"id": "docs_expansion_plan_thrift_pack_spec_sale_lifecycle", "label": "Sale lifecycle state machine", "file_type": "concept", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a77.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DRAFT \u2192 POSTED \u2192 PART_RETURNED \u2192 RETURNED, with authorized voids from POSTED and PART_RETURNED."}, {"id": "docs_expansion_plan_thrift_pack_spec_traceability", "label": "Bale-to-sale traceability invariant", "file_type": "rationale", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a710.1, \u00a711 THR-R4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every sale line links to a lot and every lot to a bale; weak traceability is mitigated by non-null references on movements plus periodic integrity checks, because an audit has to walk sale \u2192 lot \u2192 bale."}, {"id": "docs_expansion_plan_thrift_pack_spec_posting_mappings", "label": "Thrift accounting posting mappings", "file_type": "concept", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight events from bale receipt through sale, COGS, returns and voids, each with an explicit debit/credit pair; voids are idempotent reversal events rather than deletions."}, {"id": "docs_expansion_plan_thrift_pack_spec_thriftbale", "label": "ThriftBale model", "file_type": "code", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gross/tare/net weight plus currency and landed cost, unique on (companyId, baleNo); landed cost lines must be complete before grading closure or margin is distorted."}, {"id": "docs_expansion_plan_thrift_pack_spec_thriftlot", "label": "ThriftLot model", "file_type": "code", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The traceable inventory unit \u2014 carries baleId, skuId, on-hand/reserved quantities and unit cost, and is what oversell prevention and cost reversal are measured against."}, {"id": "docs_expansion_plan_thrift_pack_spec_thriftstockmovement", "label": "ThriftStockMovement model", "file_type": "code", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One ledger of typed movements (INTAKE, GRADE_IN/OUT, SALE, RETURN_IN, adjustments, VOID_REVERSAL) with referenceType/referenceId, so stock history is append-style rather than mutated."}, {"id": "docs_expansion_plan_thrift_pack_spec_thriftstockadjustment", "label": "ThriftStockAdjustment approval workflow", "file_type": "concept", "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a75.5, \u00a711 THR-R5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DRAFT \u2192 APPROVED \u2192 POSTED with separate requestedBy and approvedBy, guarding against unauthorized stock write-downs; posting a draft without approval must fail with ADJUSTMENT_NOT_APPROVED."}], "edges": [{"source": "docs_expansion_plan_thrift_pack_spec_doc", "target": "docs_expansion_plan_thrift_pack_spec_addon_thrift_pack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a74", "weight": 1}, {"source": "docs_expansion_plan_thrift_pack_spec_doc", "target": "docs_expansion_plan_thrift_pack_spec_bale_lifecycle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/expansion-plan/thrift-pack-spec.md", "source_location": "\u00a77.1", "weigh