{"nodes": [{"id": "docs_expansion_plan_schools_production_readiness_doc", "label": "Schools Pack Production Readiness Assessment", "file_type": "document", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audit dated 2026-08-04 assessing whether a tenant can be provisioned as a school and transact end to end without per-customer engineering."}, {"id": "docs_expansion_plan_schools_production_readiness_b1_no_academic_year", "label": "Blocker B1 \u2014 No way to create an academic year or term", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a72 B1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SchoolAcademicYear/SchoolTerm exist in schema but nothing creates them; every downstream entity is keyed by termId, so a fresh school cannot enrol a student. Named the single hard stop."}, {"id": "docs_expansion_plan_schools_production_readiness_b2_no_provisioning_path", "label": "Blocker B2 \u2014 No school provisioning path", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a72 B2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The org-provision wizard creates company, admin user, tier, TEMPLATE_SCHOOLS bundle and subdomain but no school domain data; seed-staging-tenant.ts has no schools branch."}, {"id": "docs_expansion_plan_schools_production_readiness_b3_fees_never_reach_gl", "label": "Blocker B3 \u2014 Fee money never reaches the general ledger", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a72 B3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "emitSchoolFeeAccountingEvent only writes a PENDING AccountingIntegrationEvent; retail by contrast calls createJournalEntryFromSource and actually posts. AccountingSourceType has no school members, so posting rules cannot distinguish tuition from any other sale."}, {"id": "docs_expansion_plan_schools_production_readiness_b4_portal_identity_email_match", "label": "Blocker B4 \u2014 Portal identity resolved by string-matching email", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a72 B4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Student identity from email local-part vs studentNo, guardian by nullable non-unique email. SchoolStudent and SchoolGuardian carry no userId, so two guardians sharing a household email cross the tenant data boundary."}, {"id": "docs_expansion_plan_schools_production_readiness_d1_school_money_float", "label": "Defect D1 \u2014 School money is Float", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a73 D1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invoice, receipt, allocation and waiver amounts are Float compensated by toMoney() and > 0.009 epsilon comparisons. Gold already migrated to Decimal (46 declarations); schools is the outlier and fees are the product's wedge."}, {"id": "docs_expansion_plan_schools_production_readiness_d2_no_currency", "label": "Defect D2 \u2014 No currency in school fee models", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a73 D2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every other money-bearing model carries currency; the accounting event hardcodes USD. Disqualifying in Zimbabwe where fees settle in USD or ZWG at a rate captured on the receipt."}, {"id": "docs_expansion_plan_schools_production_readiness_d3_check_then_write_races", "label": "Defect D3 \u2014 Check-then-write races on allocation", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a73 D3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bed allocation and receipt allocation both read the constraint outside the transaction and write inside a later one; refreshFeeInvoiceBalance clamps with Math.max(...,0) so overpayment silently disappears rather than becoming a credit."}, {"id": "docs_expansion_plan_schools_production_readiness_d4_duplicate_term_invoices", "label": "Defect D4 \u2014 Duplicate term invoices", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a73 D4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SchoolFeeInvoice has no unique on (companyId, studentId, termId) and bulk generation's skipExisting is opt-in, so running bulk generate twice double-invoices the whole school."}, {"id": "docs_expansion_plan_schools_production_readiness_d5_unenforced_boarding_policy", "label": "Defect D5 \u2014 Unenforced boarding gender and capacity policy", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a73 D5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SchoolHostel.genderPolicy and SchoolStudent.gender exist but the allocation route never reads either; room and hostel capacity are unchecked, so the spec's acceptance criterion is not met."}, {"id": "docs_expansion_plan_schools_production_readiness_d6_multiple_active_terms", "label": "Defect D6 \u2014 Multiple active terms are possible", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a73 D6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "isActive is a plain boolean with no partial unique index; 'current term' is resolved ad hoc at each call site."}, {"id": "docs_expansion_plan_schools_production_readiness_authorization_gap", "label": "Schools authorization gap \u2014 56 of 72 routes unguarded", "file_type": "rationale", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feature gating in proxy.ts is per-feature-key, not per-action; ROLE_PREFIX_ALLOWLIST grants TEACHER the whole schools. prefix including schools.fees, so a teacher can post receipts and write off debt."}, {"id": "docs_expansion_plan_schools_production_readiness_fabricated_surfaces", "label": "Navigation surfaces that are not real", "file_type": "concept", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timetable slots fabricated by deriveSlot(index), refunds a 501 stub, notices GET-only, documents via window.print(), report exports placeholder \u2014 functionality reimplemented badly alongside a working platform capability."}, {"id": "docs_expansion_plan_schools_production_readiness_layered_plan", "label": "Layered remediation plan (Layers 0\u20134)", "file_type": "concept", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered so the tenant is usable at the end of every layer, per the AGENTS.md principles: transact, then money correctness, then access control, then academics, then the parent-facing product."}, {"id": "docs_expansion_plan_schools_production_readiness_provisionschool", "label": "provisionSchool service", "file_type": "code", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a78 Layer 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeds current academic year, three terms, class ladder, subject catalogue, grading scale, one fee structure, accounting defaults and school roles; invoked by the org-provision wizard on TEMPLATE_SCHOOLS."}, {"id": "docs_expansion_plan_schools_production_readiness_emitschoolfeeaccountingevent", "label": "emitSchoolFeeAccountingEvent", "file_type": "code", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "app/api/v2/schools/fees/_helpers.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expansion_plan_schools_production_readiness_createjournalentryfromsource", "label": "createJournalEntryFromSource", "file_type": "code", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "app/api/v2/retail/_helpers.ts:130", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expansion_plan_schools_production_readiness_route_registry", "label": "Schools route registry gating", "file_type": "code", "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "lib/platform/gating/route-registry.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers every /schools page and API prefix and is enforced in proxy.ts, but gates on the tenant's features rather than on the caller."}], "edges": [{"source": "docs_expansion_plan_schools_production_readiness_doc", "target": "docs_expansion_plan_schools_production_readiness_b1_no_academic_year", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/expansion-plan/schools-production-readiness.md", "source_location": "\u00a72", "weight": 1}, {"source": "docs_expansion_plan_schools_production_readin