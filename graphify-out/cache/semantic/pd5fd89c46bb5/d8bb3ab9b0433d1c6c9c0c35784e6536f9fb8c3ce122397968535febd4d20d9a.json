{"nodes": [{"id": "docs_gold_team_status_2026_05_10_doc", "label": "Gold Team Overnight Run \u2014 Status Log", "file_type": "document", "source_file": "docs/gold-team-status-2026-05-10.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Claude (autonomous)", "contributor": null, "rationale": "Records what the autonomous overnight run landed per epic with commit hashes, the decisions taken without a human, and the follow-ups left for daylight."}, {"id": "docs_gold_team_status_2026_05_10_epic_6_decimal_companyid", "label": "Epic 6 \u2014 Decimal and companyId denormalisation", "file_type": "concept", "source_file": "docs/gold-team-status-2026-05-10.md", "source_location": "Epic 6 row", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~50 weight/USD columns converted across three staged migrations with values rounded via ROUND(...::numeric, scale) inside parity tolerance; companyId denormalised onto 7 transactional models enabling compound uniques, and nested site:{companyId} filters flattened across 18 files. Suite 4 (1000 \u00d7 0.001g = exactly 1.000g) proves the migration."}, {"id": "docs_gold_team_status_2026_05_10_epic_9a_deferred", "label": "Epic 9a deferred as an XL refactor", "file_type": "rationale", "source_file": "docs/gold-team-status-2026-05-10.md", "source_location": "Decisions made autonomously #5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The importer worker rebuild \u2014 queue, SSE progress, decomposing the 985-line route into per-domain projectors, repair flow \u2014 needs a larger change window and a design discussion than an overnight run allows."}, {"id": "docs_gold_team_status_2026_05_10_enum_shortfall_followups", "label": "Enum shortfall follow-ups (Epic 7b, GOLD_* notifications)", "file_type": "rationale", "source_file": "docs/gold-team-status-2026-05-10.md", "source_location": "Decisions #7, #8", "source_url": null, "ca