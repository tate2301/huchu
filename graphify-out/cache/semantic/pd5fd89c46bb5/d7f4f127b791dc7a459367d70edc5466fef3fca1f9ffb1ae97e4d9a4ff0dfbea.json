{"nodes": [{"id": "docs_gold_team_dev_brief_2026_05_09_doc", "label": "Gold Module \u2014 Agent Team Development Brief", "file_type": "document", "source_file": "docs/gold-team-dev-brief-2026-05-09.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operational brief for running the agent team against the review doc's roadmap: current state, agent charters, epic-by-epic runbook, day-to-day workflow and failure modes."}, {"id": "docs_gold_team_dev_brief_2026_05_09_agent_charters", "label": "Seven Gold agent charters", "file_type": "concept", "source_file": "docs/gold-team-dev-brief-2026-05-09.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each agent owns a file territory and is forbidden the rest \u2014 tech-lead and reviewer write no code, data-foundation owns prisma and migrations, domain-backend owns lib/gold and app/api/gold, import-workflow owns the importer, frontend owns app/gold and components/gold, integration owns the cross-module seams."}, {"id": "docs_gold_team_dev_brief_2026_05_09_hook_scripts", "label": "Charter and paired-test hook scripts", "file_type": "code", "source_file": "docs/gold-team-dev-brief-2026-05-09.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "agent-charter-check.js warns on out-of-charter edits, agent-paired-test-check.js warns when source is edited without a test, agent-stop-summary.js prints the session footprint. Warning-only by design (exit 0); promoted to blocking by changing to exit 2."}, {"id": "docs_gold_team_dev_brief_2026_05_09_epic_sequence", "label": "Gold epic sequence (Epic 0 through 13)", "file_type": "concept", "source_file": "docs/gold-team-dev-brief-2026-05-09.md", "source_location": "\u00a75, \u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered so each epic's prerequisite is the previous one green: smoke test, test harness, append-only ledger, role gates, FIFO/dispatch/crews, atomic accounting, Decimal+companyId, corrections, import stabilisation, worker, period-close, reconciliation, UI polish, boundary cleanup, operational readiness."}, {"id": "docs_gold_team_dev_brief_2026_05_09_human_decision_points", "label": "Human decision points \u2014 never delegate", "file_type": "rationale", "source_file": "docs/gold-team-dev-brief-2026-05-09.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approving a migration against prod Neon, merging a PR, choosing between competing approaches the lead presents, period-close overrides, and declaring Epic 0 done after the manual smoke test."}], "edges": [{"source": "docs_gold_team_dev_brief_2026_05_09_doc", "target": "docs_gold_module_review_2026_05_09_doc", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/gold-team-dev-brief-2026-05-09.md", "source_location": "Companion doc, \u00a710", "weight": 1}, {"source": "docs_gold_team_dev_brief_2026_05_09_doc", "target": "docs_gold_team_dev_brief_2026_05_09_agent_charters", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/gold-team-dev-brief-2026-05-09.md", "source_location": "\u00a72", "weight": 1}, {"source": "docs_gold_team_dev_brief_2026_05_09_doc", "target": "docs_gold_team_dev_brief_2026_05_09_hook_scripts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/gold-team-dev-brief-2026-05-09.md", "source_location": "\u00a72", "weight": 1}, {"source": "docs_gold_team_dev_brief_2026_05_09_doc", "target": "docs_gold_team_dev_brief_2026_05_09_epic_sequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/gold-team-dev-brief-2026-05-09.md", "source_location": "\u00