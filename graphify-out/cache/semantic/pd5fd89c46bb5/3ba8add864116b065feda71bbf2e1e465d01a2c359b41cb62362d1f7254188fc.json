{"nodes": [{"id": "docs_platform_pricing_feature_flags_and_modules_doc", "label": "Platform Pricing, Feature Bundles, Subscriptions and Feature Flags", "file_type": "document", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source of truth for tiers, add-ons, templates, pricing logic and feature-flag behaviour. Its price figures are superseded by the rollout program, but its mechanism content \u2014 the formula, flag behaviour and the checklist for adding a feature \u2014 remains normative."}, {"id": "docs_platform_pricing_feature_flags_and_modules_pricing_formula", "label": "Multi-site pricing formula", "file_type": "concept", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Subscription Pricing Model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "total_monthly = tier base + site overage above included sites + add-on base + add-on per-site + standalone billable features, computed against the active site count in lib/platform/entitlements.ts and the TUI commercial service."}, {"id": "docs_platform_pricing_feature_flags_and_modules_tiers", "label": "Subscription tiers (BASIC to ENTERPRISE)", "file_type": "concept", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Subscription Tiers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tier inclusions are code-defined in TIERS and must not be changed directly in the database; higher tiers include selected add-ons free through includedBundles."}, {"id": "docs_platform_pricing_feature_flags_and_modules_feature_catalog", "label": "FEATURE_CATALOG and feature keys", "file_type": "code", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "lib/platform/feature-catalog.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stable dot keys with add-on-only features set defaultEnabled: false so they stay off until an entitled tier or add-on turns them on; pricing lives on bundles unless a feature is sold standalone."}, {"id": "docs_platform_pricing_feature_flags_and_modules_feature_bundles", "label": "FEATURE_BUNDLES and bundle dependencies", "file_type": "code", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "lib/platform/feature-catalog.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enabling an add-on auto-enables its features and disabling removes only those no longer entitled elsewhere. BUNDLE_DEPENDENCIES enforces that advanced accounting and ZIMRA require Accounting Core and Gold Advanced requires Gold Core."}, {"id": "docs_platform_pricing_feature_flags_and_modules_addon_schools_suite", "label": "ADDON_SCHOOLS_SUITE", "file_type": "concept", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Bundle Feature Mapping", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grants schools.core, admissions, students, attendance, fees, boarding, teachers, results and the three portal feature keys \u2014 the commercial unit the schools roadmap is built to fill."}, {"id": "docs_platform_pricing_feature_flags_and_modules_addon_retail_suite", "label": "ADDON_RETAIL_SUITE", "file_type": "concept", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Bundle Feature Mapping", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grants retail core, POS, catalog, purchasing, promotions, shifts, reports plus crm.customers and portal.pos \u2014 the same feature also lives in ADDON_CRM_CORE so both bundles grant it."}, {"id": "docs_platform_pricing_feature_flags_and_modules_route_registry", "label": "Route registry and feature resolution", "file_type": "code", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "lib/platform/gating/route-registry.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PAGE_FEATURE_ROUTES and API_FEATURE_ROUTES resolved by resolveFeatureKeyForPath; child routes must be mapped before broad fallbacks like /retail or /api/v2/retail or a specific module falls through to the wrong feature key."}, {"id": "docs_platform_pricing_feature_flags_and_modules_crm_gap_lesson", "label": "Why a bundle may not show after Sync Catalog", "file_type": "rationale", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Why a Bundle May Not Show After Sync", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sync Catalog is an upsert from code, not discovery from routes or UI labels. CRM screens existed under /retail/customers and charts were labelled CRM, but with no crm domain, no crm.customers key and no ADDON_CRM_CORE entry the route fell through to retail.core and the bundle could never appear."}, {"id": "docs_platform_pricing_feature_flags_and_modules_add_feature_checklist", "label": "Checklist for adding a feature, module or bundle", "file_type": "concept", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "How to Add a New Feature, Module, or Bundle", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thirteen ordered steps binding catalog, bundles, route mappings, navigation and workspace presentation, role registry, templates, marketing pricing and regression coverage together before Sync Catalog runs \u2014 the surfaces that must move in step or a module is half-registered."}, {"id": "docs_platform_pricing_feature_flags_and_modules_role_registry", "label": "Vertical and feature role registry", "file_type": "code", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "lib/platform/vertical-role-registry.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profile-wide roles go in VERTICAL_ROLE_REGISTRY and module-driven roles in FEATURE_ROLE_REGISTRY, mirrored in user-entitlements so new users inherit the right access. Role dropdowns must consume getAllowedUserRoleOptionsForWorkspace rather than being hard-coded."}, {"id": "docs_platform_pricing_feature_flags_and_modules_client_templates", "label": "Client template bundles", "file_type": "code", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "lib/platform/client-templates.ts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TEMPLATE_CORE_STARTER, GOLD_MINE, TECH_WORKSHOP, SCHOOLS, RETAIL and ALL_FEATURES, with disabledFeatureKeys to subtract inherited features. Retired vertical aliases still resolve \u2014 degrading to CORE_STARTER rather than throwing for a tenant provisioned before the drop."}, {"id": "docs_platform_pricing_feature_flags_and_modules_scope_trim", "label": "Scope trim ST-1 / ST-2 / ST-3", "file_type": "rationale", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Scope-trim notice", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CCTV, vehicle sales, scrap metal, fixed assets and budgets are no longer sold or shipped \u2014 bundles, keys, templates, code and tables all removed \u2014 but legacy template codes were deliberately kept resolvable so older provisioning does not throw."}, {"id": "docs_platform_pricing_feature_flags_and_modules_subscription_health", "label": "Subscription lifecycle and health states", "file_type": "concept", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Subscription Lifecycle and Health", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Statuses TRIALING through EXPIRED map onto health states from MISSING_SUBSCRIPTION to EXPIRED_BLOCKED, with a persisted pricing snapshot (effectiveMonthlyAmount, priceSnapshotJson, lastPriceComputedAt) on CompanySubscription."}, {"id": "docs_platform_pricing_feature_flags_and_modules_platform_tui", "label": "Platform TUI commercial operations", "file_type": "concept", "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "TUI Operations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pnpm platform exposes subscription status, tier assignment, template application, add-on management, pricing recompute and catalog sync through selector-first wizards with input lock to avoid hotkey conflicts."}], "edges": [{"source": "docs_platform_pricing_feature_flags_and_modules_doc", "target": "docs_platform_pricing_feature_flags_and_modules_pricing_formula", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Subscription Pricing Model", "weight": 1}, {"source": "docs_platform_pricing_feature_flags_and_modules_doc", "target": "docs_platform_pricing_feature_flags_and_modules_tiers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Subscription Tiers", "weight": 1}, {"source": "docs_platform_pricing_feature_flags_and_modules_doc", "target": "docs_platform_pricing_feature_flags_and_modules_feature_bundles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/platform-pricing-feature-flags-and-modules.md", "source_location": "Add-on Bundles", "weight": 1}, {"source": "docs_platform_pricing_feature_flags_and_modules_doc", "target": "docs_pl