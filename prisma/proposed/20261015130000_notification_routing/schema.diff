+/// Who hears about a kind of notification, and where: the workspace's rule
+/// (userId null, set in Management → Notifications) or one person's own
+/// (set in My account → Notifications), per kind and channel.
+model NotificationSetting {
+  id          String              @id @default(uuid())
+  companyId   String
+  userId      String?
+  kind        String              @db.VarChar(32)
+  channel     NotificationChannel
+  enabled     Boolean
+  updatedById String?
+  createdAt   DateTime            @default(now())
+  updatedAt   DateTime            @updatedAt
+
+  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
+  user    User?   @relation("NotificationSettingUser", fields: [userId], references: [id], onDelete: Cascade)
+
+  @@unique([companyId, userId, kind, channel])
+  @@index([userId])
+}
+
+/// When notifications go: quiet hours for the phone and WhatsApp, the morning
+/// message from Vane, and repeats grouped into one.
+model NotificationPolicy {
+  companyId      String   @id
+  quietFrom      String   @default("20:00") @db.VarChar(5)
+  quietTo        String   @default("06:00") @db.VarChar(5)
+  morningMessage Boolean  @default(false)
+  groupRepeats   Boolean  @default(true)
+  updatedById    String?
+  updatedAt      DateTime @updatedAt
+
+  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
+}
+
+enum NotificationChannel {
+  IN_APP
+  EMAIL
+  WHATSAPP
+  PHONE
+}
