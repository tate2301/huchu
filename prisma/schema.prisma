  id          String   @id @default(uuid())
  companyId   String
  invoiceId   String
  feeCode     String
  description String
  /// A multiplier, not money: four places so a term billed a third at a time
  /// is representable. Matches the repo's `Decimal(12,4)` rate convention.
  quantity    Decimal  @default(1) @db.Decimal(12, 4)
  unitAmount  Decimal  @db.Decimal(14, 2)
  /// A percentage between 0 and 100, not money.
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice SchoolFeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, feeCode])
  @@index([invoiceId])
}

model SchoolFeeReceipt {
  id                String                 @id @default(uuid())
  companyId         String
  receiptNo         String
  studentId         String
  receiptDate       DateTime
  paymentMethod     SchoolFeePaymentMethod
  reference         String?
  amountReceived    Decimal                @db.Decimal(14, 2)
  amountAllocated   Decimal                @default(0) @db.Decimal(14, 2)
  /// S-2.5 — the credit this payment left on the family's account.
  ///
  /// A parent who hands over 500 against a 450 bill has 50, and this is where
  /// it lives until it is allocated to the next invoice or refunded. A CHECK
  /// constraint holds `amountAllocated + amountUnallocated = amountReceived`,
  /// so the surplus cannot be quietly dropped by any code path.
  amountUnallocated Decimal                @default(0) @db.Decimal(14, 2)
  /// S-2.6 — the part of `amountUnallocated` already promised to a refund.
  /// Held at request, released on cancellation; CHECK-bounded by
  /// `amountUnallocated`, which also stops credit being allocated away from
  /// under a refund that is waiting to be paid.
  refundedAmount    Decimal                @default(0) @db.Decimal(14, 2)
  /// The currency the money was actually handed over in. A receipt may only be
  /// allocated to invoices carrying the same currency.
  currency          String                 @default("USD")
  /// Quote units per one base unit — see `SchoolFeeInvoice.exchangeRate`.
  exchangeRate      Decimal                @default(1) @db.Decimal(12, 4)
  /// `amountReceived` in the company's base currency.
  baseAmount        Decimal                @default(0) @db.Decimal(14, 2)
  status            SchoolFeeReceiptStatus @default(DRAFT)
  notes             String?
  postedById        String?
  postedAt          DateTime?
  voidedById        String?
  voidedAt          DateTime?
  createdById       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  company     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student     SchoolStudent                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations SchoolFeeReceiptAllocation[]
  refunds     SchoolFeeRefund[]
  /// S-2.7 — at most one, and only on a tenant with the fiscalisation add-on.
  fiscalReceipt FiscalReceipt?             @relation("SchoolFeeReceiptFiscalReceipt")

  @@unique([companyId, receiptNo])
  @@index([companyId, status])
  @@index([studentId, receiptDate])
}

model SchoolFeeReceiptAllocation {
  id              String   @id @default(uuid())
  companyId       String
  receiptId       String
  invoiceId       String
  /// In the receipt's currency, which the route holds equal to the invoice's.
  allocatedAmount Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receipt SchoolFeeReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice SchoolFeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([companyId, receiptId, invoiceId])
  @@index([invoiceId])
}

model SchoolFeeWaiver {
  id           String                @id @default(uuid())
  companyId    String
  studentId    String
  termId       String
  invoiceId    String?
  waiverType   SchoolFeeWaiverType
  reason       String?
  amount       Decimal               @db.Decimal(14, 2)
  /// The currency the waiver is expressed in — held equal to the invoice's.
  currency     String                @default("USD")
  /// Quote units per one base unit — see `SchoolFeeInvoice.exchangeRate`.
  exchangeRate Decimal               @default(1) @db.Decimal(12, 4)
  /// `amount` in the company's base currency.
