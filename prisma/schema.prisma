generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE ENTITIES - Company, Sites, Users
// ============================================

model Company {
  id                            String             @id @default(uuid())
  name                          String
  slug                          String             @unique
  tenantStatus                  TenantStatus       @default(PROVISIONING)
  workspaceProfile              WorkspaceProfile   @default(GENERAL)
  isProvisioned                 Boolean            @default(false)
  suspendedAt                   DateTime?
  disabledAt                    DateTime?
  payrollCycle                  PayrollCycle       @default(MONTHLY)
  cashDisbursementOnly          Boolean            @default(true)
  autoGeneratePayrollPeriods    Boolean            @default(true)
  periodGenerationHorizon       Int                @default(3)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  sites                         Site[]
  users                         User[]
  employees                     Employee[]
  employeeModuleAssignments     EmployeeModuleAssignment[]
  shiftGroups                   ShiftGroup[]
  attendances                   Attendance[]
  shiftGroupSchedules           ShiftGroupSchedule[]
  departments                   Department[]
  jobGrades                     JobGrade[]
  compensationRules             CompensationRule[]
  compensationTemplates         CompensationTemplate[]
  payeTables                    PayeTable[]
  statutoryRates                StatutoryRate[]
  taxCredits                    TaxCredit[]
  necAgreements                 NecAgreement[]
  payrollPeriods                PayrollPeriod[]
  payrollRuns                   PayrollRun[]
  disbursementBatches           DisbursementBatch[]
  approvalActions               ApprovalAction[]
  adjustmentEntries             AdjustmentEntry[]
  notifications                 Notification[]
  hrIncidents                   HrIncident[]
  disciplinaryActions           DisciplinaryAction[]
  subscriptions                 CompanySubscription[]
  featureFlags                  CompanyFeatureFlag[]
  userPermissionOverrides       UserPermissionOverride[]
  crmTemplates                  CrmTemplate[]
  crmTemplateEvents             CrmTemplateEvent[]
  crmFieldChanges               CrmFieldChange[]
  provisioningEvents            ProvisioningEvent[]
  subdomainReservations         SubdomainReservation[]
  branding                      CompanyBranding?
  domains                       CompanyDomain[]
  supportAccessRequests         SupportAccessRequest[]
  supportSessions               SupportSession[]
  runbookDefinitions            RunbookDefinition[]
  runbookExecutions             RunbookExecution[]
  sloMetricSnapshots            TenantSloMetricSnapshot[]
  healthIncidents               HealthIncident[]
  contractEnforcementEvents     ContractEnforcementEvent[]
  auditLedgerEvents             PlatformAuditEvent[]
  subscriptionAddons            CompanySubscriptionAddon[]
  accountingSettings            AccountingSettings?
  chartOfAccounts               ChartOfAccount[]
  accountingPeriods             AccountingPeriod[]
  journalEntries                JournalEntry[]
  postingRules                  PostingRule[]
  tenderAccountMappings         TenderAccountMapping[]
  taxCodes                      TaxCode[]
  taxCategories                 TaxCategory[]
  taxTemplates                  TaxTemplate[]
  taxRules                      TaxRule[]
  currencyDefinitions           CurrencyDefinition[]
  customers                     Customer[]
  vendors                       Vendor[]
  salesInvoices                 SalesInvoice[]
  salesQuotations               SalesQuotation[]
  salesReceipts                 SalesReceipt[]
  creditNotes                   CreditNote[]
  salesWriteOffs                SalesWriteOff[]
  purchaseBills                 PurchaseBill[]
  purchasePayments              PurchasePayment[]
  debitNotes                    DebitNote[]
  purchaseWriteOffs             PurchaseWriteOff[]
  bankAccounts                  BankAccount[]
  bankTransactions              BankTransaction[]
  bankReconciliations           BankReconciliation[]
  paymentLedgerEntries          PaymentLedgerEntry[]
  vatReturnSummaries            VatReturnSummary[]
  vatReturns                    VatReturn[]
  periodCloseVouchers           PeriodCloseVoucher[]
  openingBalanceImports         OpeningBalanceImport[]
  fixedAssets                   FixedAsset[]
  budgets                       Budget[]
  budgetLines                   BudgetLine[]
  costCenters                   CostCenter[]
  currencyRates                 CurrencyRate[]
  fiscalProviderConfigs         FiscalisationProviderConfig[]
  fiscalReceipts                FiscalReceipt[]
  accountingIntegrationEvents   AccountingIntegrationEvent[]
  accountingSeedExecutions      AccountingSeedExecution[]
  documentTemplates             DocumentTemplate[]
  documentRenderJobs            DocumentRenderJob[]
  documentArtifacts             DocumentArtifact[]
  idSequences                   IdSequence[]
  schoolAcademicYears           SchoolAcademicYear[]
  schoolTerms                   SchoolTerm[]
  schoolClasses                 SchoolClass[]
  schoolStreams                 SchoolStream[]
  schoolStudents                SchoolStudent[]
  schoolGuardians               SchoolGuardian[]
  schoolStudentGuardians        SchoolStudentGuardian[]
  schoolEnrollments             SchoolEnrollment[]
  schoolHostels                 SchoolHostel[]
  schoolHostelRooms             SchoolHostelRoom[]
  schoolHostelBeds              SchoolHostelBed[]
  schoolBoardingAllocations     SchoolBoardingAllocation[]
  schoolLeaveRequests           SchoolLeaveRequest[]
  schoolBoardingMovementLogs    SchoolBoardingMovementLog[]
  schoolResultSheets            SchoolResultSheet[]
  schoolResultLines             SchoolResultLine[]
  schoolResultModerationActions SchoolResultModerationAction[]
  schoolTeacherProfiles         SchoolTeacherProfile[]
  schoolSubjects                SchoolSubject[]
  schoolSchemesOfWork           SchoolSchemeOfWork[]
  schoolMessageThreads          SchoolMessageThread[]
  schoolMessages                SchoolMessage[]
  schoolClassSubjects           SchoolClassSubject[]
  schoolPublishWindows          SchoolPublishWindow[]
  schoolFeeStructures           SchoolFeeStructure[]
  schoolFeeStructureLines       SchoolFeeStructureLine[]
  schoolFeeInvoices             SchoolFeeInvoice[]
  schoolFeeInvoiceLines         SchoolFeeInvoiceLine[]
  schoolFeeReceipts             SchoolFeeReceipt[]
  schoolFeeReceiptAllocations   SchoolFeeReceiptAllocation[]
  schoolFeeWaivers              SchoolFeeWaiver[]
  schoolFeeRefunds              SchoolFeeRefund[]
  schoolAttendanceSessions      SchoolAttendanceSession[]
  schoolPeriods                 SchoolPeriod[]
  schoolRooms                   SchoolRoom[]
  schoolTimetableSlots          SchoolTimetableSlot[]
  schoolCalendarEvents          SchoolCalendarEvent[]
  schoolGradingSchemes          SchoolGradingScheme[]
  schoolGradingBands            SchoolGradingBand[]
  schoolAssessments             SchoolAssessment[]
  schoolAssessmentScores        SchoolAssessmentScore[]
  schoolApplications            SchoolApplication[]
  schoolApplicationEvents       SchoolApplicationEvent[]
  schoolHealthRecords           SchoolHealthRecord[]
  schoolHealthEvents            SchoolHealthEvent[]
  schoolAssignments             SchoolAssignment[]
  schoolAssignmentSubmissions   SchoolAssignmentSubmission[]
  schoolBooks                   SchoolBook[]
  schoolBookCopies              SchoolBookCopy[]
  schoolBookLoans               SchoolBookLoan[]
  schoolBookReservations        SchoolBookReservation[]
  schoolLessonPlans             SchoolLessonPlan[]
  schoolCoverAssignments        SchoolCoverAssignment[]
  schoolTeachingResources       SchoolTeachingResource[]
  schoolStudentGoals            SchoolStudentGoal[]
  schoolParentMeetings          SchoolParentMeeting[]
  schoolTransportRoutes         SchoolTransportRoute[]
  schoolTransportStops          SchoolTransportStop[]
  schoolTransportRiders         SchoolTransportRider[]
  schoolTransportBoardings      SchoolTransportBoarding[]
  schoolPortalInvites           SchoolPortalInvite[]
  schoolAttendanceSessionLines  SchoolAttendanceSessionLine[]
  schoolImportJobs              SchoolImportJob[]
  schoolImportRows              SchoolImportRow[]
  schoolImportArtifacts         SchoolImportArtifact[]
  carSalesLeads                 CarSalesLead[]
  carSalesVehicles              CarSalesVehicle[]
  carSalesDeals                 CarSalesDeal[]
  carSalesPayments              CarSalesPayment[]
  goldPurchases                 GoldPurchase[]
  goldPrices                    GoldPrice[]
  goldExpenseTypes              GoldExpenseType[]
  leaveTypes                    LeaveType[]
  leaveEntitlements             LeaveEntitlement[]
  leaveRequests                 LeaveRequest[]
  publicHolidays                PublicHoliday[]
  settlementIntakes             SettlementIntake[]
  settlementRuns                SettlementRun[]
  settlementBatches             SettlementBatch[]
  settlementPayments            SettlementPayment[]
  scrapMaterials                ScrapMaterial[]
  scrapMetalPrices              ScrapMetalPrice[]
  scrapSellerProfiles           ScrapSellerProfile[]
  scrapMetalEmployeeBalances    ScrapMetalEmployeeBalance[]
  scrapMetalBalanceEntries      ScrapMetalBalanceEntry[]
  scrapMetalPurchases           ScrapMetalPurchase[]
  scrapMetalBatches             ScrapMetalBatch[]
  scrapMetalSales               ScrapMetalSale[]
  scrapTicketComplianceRules    ScrapTicketComplianceRule[]
  goldInventoryEvents           GoldInventoryEvent[]
  goldExceptions                GoldException[]
  goldLedgerImports             GoldLedgerImport[]
  goldPours                     GoldPour[]                     @relation("GoldPourCompany")
  goldShiftAllocations          GoldShiftAllocation[]          @relation("GoldShiftAllocationCompany")
  goldDispatches                GoldDispatch[]                 @relation("GoldDispatchCompany")
  buyerReceipts                 BuyerReceipt[]                 @relation("BuyerReceiptCompany")
  goldLedgerEntries             GoldLedgerEntry[]              @relation("GoldLedgerEntryCompany")
  goldDispatchBatches           GoldDispatchBatch[]            @relation("GoldDispatchBatchCompany")
  buyerReceiptBatches           BuyerReceiptBatch[]            @relation("BuyerReceiptBatchCompany")
  goldLedgerCorrections         GoldLedgerCorrection[]         @relation("GoldLedgerCorrectionCompany")
  buyerReceiptCorrections       BuyerReceiptCorrection[]       @relation("BuyerReceiptCorrectionCompany")
  goldLedgerImportPresets       GoldLedgerImportPreset[]
  goldImportSavedViews          GoldImportSavedView[]
  goldPeriodCloses              GoldPeriodClose[]
  goldConfig                    GoldCompanyConfig?
  crmClients                    CrmClient[]
  crmLeads                      CrmLead[]
  crmLeadDocuments              CrmLeadDocument[]
  crmDocumentApprovals          CrmDocumentApproval[]
  crmActivities                 CrmActivity[]
  crmFollowUps                  CrmFollowUp[]
  crmAppointments               CrmAppointment[]
  crmSiteVisitItems             CrmSiteVisitItem[]
  crmSavedViews                 CrmSavedView[]
  crmIntakeForms                CrmIntakeForm[]
  crmIntakeSubmissions          CrmIntakeSubmission[]
  crmApiKeys                    CrmApiKey[]
  crmLeadSources                CrmLeadSource[]
  crmCommissionRules            CrmCommissionRule[]
  crmCommissionEntries          CrmCommissionEntry[]
  crmPeople                     CrmPerson[]
  crmPersonCompanies            CrmPersonCompany[]
  crmSites                      CrmSite[]
  crmDeals                      CrmDeal[]
  crmDealContacts               CrmDealContact[]
  crmPipelines                  CrmPipeline[]
  crmPipelineStages             CrmPipelineStage[]
  crmFieldDefinitions           CrmFieldDefinition[]
  crmLists                      CrmList[]
  crmOverviewLayouts            CrmOverviewLayout[]
  crmCustomWidgets              CrmCustomWidget[]
  crmListMembers                CrmListMember[]
  crmTasks                      CrmTask[]
  crmComments                   CrmComment[]
  crmRecordFiles                CrmRecordFile[]
  crmMentions                   CrmMention[]
  crmFollowers                  CrmFollower[]
  crmAutomations                CrmAutomation[]
  crmAutomationRuns             CrmAutomationRun[]
  crmDiscountApprovals          CrmDiscountApproval[]
  crmCollectionNotes            CrmCollectionNote[]
  crmWorkOrders                 CrmWorkOrder[]
  crmWorkOrderItems             CrmWorkOrderItem[]
  products                      Product[]
  priceLists                    PriceList[]
  productPrices                 ProductPrice[]
  retailRegisters               RetailRegister[]
  retailPromotions              RetailPromotion[]
  retailPurchaseOrders          RetailPurchaseOrder[]
  retailPurchaseOrderLines      RetailPurchaseOrderLine[]
  retailGoodsReceipts           RetailGoodsReceipt[]
  retailGoodsReceiptLines       RetailGoodsReceiptLine[]
  retailShifts                  RetailShift[]
  retailHeldCarts               RetailHeldCart[]
  retailSales                   RetailSale[]
  retailSaleLines               RetailSaleLine[]
  retailSalePayments            RetailSalePayment[]
  retailCashMovements           RetailCashMovement[]
  retailZReports                RetailZReport[]
  retailTillPins                RetailTillPin[]

  @@index([tenantStatus])
  @@index([isProvisioned])
}

model IdSequence {
  id         String   @id @default(uuid())
  companyId  String
  entityKey  String
  scopeKey   String   @default("GLOBAL")
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entityKey, scopeKey])
  @@index([companyId])
}

// Sequences that must be globally unique across all companies (e.g. StockMovement.referenceId).
// No companyId FK so the counter is shared across tenants.
model GlobalIdSequence {
  id         String   @id @default(uuid())
  entityKey  String
  scopeKey   String   @default("GLOBAL")
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityKey, scopeKey])
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum WorkspaceProfile {
  GOLD_MINE
  SCRAP_METAL
  SCHOOLS
  AUTOS
  RETAIL      @map("THRIFT")
  /// A workspace that bought payroll and nothing else. Must exist here as well
  /// as in `lib/workspace-products.ts` — the TypeScript list is what the app
  /// reasons with, this is what the column can actually hold.
  PAYROLL
  GENERAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  monthlyPrice Float
  annualPrice  Float?
  currency     String   @default("USD")
  maxSites     Int?
  maxUsers     Int?
  warningDays  Int      @default(14)
  graceDays    Int      @default(7)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions CompanySubscription[]

  @@index([isActive])
}

model CompanySubscription {
  id                     String             @id @default(uuid())
  companyId              String
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  externalSubscriptionId String?            @unique
  startedAt              DateTime           @default(now())
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  endedAt                DateTime?
  effectiveMonthlyAmount Float?
  priceSnapshotJson      String?
  lastPriceComputedAt    DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([companyId, status])
  @@index([planId])
  @@index([currentPeriodEnd])
}

model PlatformFeature {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  description    String?
  domain         String?
  defaultEnabled Boolean  @default(false)
  isBillable     Boolean  @default(false)
  monthlyPrice   Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyFlags CompanyFeatureFlag[]
  bundleItems  FeatureBundleItem[]
  userFlags    UserFeatureFlag[]

  @@index([isActive])
}

model CompanyFeatureFlag {
  id        String    @id @default(uuid())
  companyId String
  featureId String
  isEnabled Boolean   @default(true)
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureId])
  @@index([featureId])
  @@index([companyId, isEnabled])
}

model UserFeatureFlag {
  id        String   @id @default(uuid())
  userId    String
  featureId String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
  @@index([featureId])
  @@index([userId, isEnabled])
}

/// A permission one person has, or has had taken away, against what their role
/// would otherwise give them. Feature access already has UserFeatureFlag; this
/// is its twin for the capabilities a module gates on, so the admin screen can
/// show one list instead of two systems that disagree.
model UserPermissionOverride {
  id            String   @id @default(uuid())
  companyId     String
  userId        String
  permissionKey String
  isAllowed     Boolean
  grantedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation("UserPermissionOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?   @relation("UserPermissionOverrideGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionKey])
  @@index([companyId, permissionKey])
  @@index([userId])
}

model FeatureBundle {
  id                         String   @id @default(uuid())
  code                       String   @unique
  name                       String
  description                String?
  monthlyPrice               Float    @default(0)
  additionalSiteMonthlyPrice Float    @default(0)
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  items         FeatureBundleItem[]
  companyAddons CompanySubscriptionAddon[]

  @@index([isActive])
}

model FeatureBundleItem {
  id        String   @id @default(uuid())
  bundleId  String
  featureId String
  createdAt DateTime @default(now())

  bundle  FeatureBundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([bundleId, featureId])
  @@index([featureId])
}

model CompanySubscriptionAddon {
  id        String   @id @default(uuid())
  companyId String
  bundleId  String
  isEnabled Boolean  @default(true)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bundle  FeatureBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([companyId, bundleId])
  @@index([bundleId, isEnabled])
}

model ProvisioningEvent {
  id          String    @id @default(uuid())
  companyId   String
  eventType   String
  status      String    @default("PENDING")
  message     String?
  payloadJson String?
  errorJson   String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([status])
}

enum SubdomainReservationStatus {
  RESERVED
  ACTIVE
  RELEASED
}

enum CompanyDomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  FAILED
  DISABLED
}

enum CompanyDomainVerificationType {
  TXT
}

model SubdomainReservation {
  id            String                     @id @default(uuid())
  companyId     String
  subdomain     String                     @unique
  status        SubdomainReservationStatus @default(RESERVED)
  provider      String                     @default("registry-stub")
  providerRef   String?
  lastCheckedAt DateTime?
  reservedAt    DateTime                   @default(now())
  activatedAt   DateTime?
  releasedAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model CompanyBranding {
  companyId           String   @id
  displayName         String?
  primaryColor        String?
  secondaryColor      String?
  accentColor         String?
  fontFamilyKey       String?
  logoUrl             String?
  secondaryLogoUrl    String?
  signatureUrl        String?
  stampUrl            String?
  legalName           String?
  tradingName         String?
  registrationNumber  String?
  vatNumber           String?
  taxNumber           String?
  email               String?
  phone               String?
  website             String?
  physicalAddress     String?
  postalAddress       String?
  bankName            String?
  bankAccountName     String?
  bankAccountNumber   String?
  bankSwiftCode       String?
  bankIban            String?
  defaultFooterText   String?
  legalDisclaimer     String?
  paymentTerms        String?
  documentLocale      String?
  dateFormat          String?
  timeFormat          String?
  numberFormat        String?
  currencyDisplayMode String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyDomain {
  id                String                        @id @default(uuid())
  companyId         String
  hostname          String                        @unique
  status            CompanyDomainStatus           @default(PENDING_VERIFICATION)
  verificationType  CompanyDomainVerificationType @default(TXT)
  verificationHost  String
  verificationValue String
  lastCheckedAt     DateTime?
  verifiedAt        DateTime?
  activatedAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([status])
}

enum SupportAccessStatus {
  REQUESTED
  APPROVED
  ACTIVE
  EXPIRED
  REVOKED
  DENIED
}

enum SupportAccessScope {
  READ_ONLY
  READ_WRITE
}

enum SupportSessionMode {
  IMPERSONATE
  SHADOW
}

model SupportAccessRequest {
  id          String              @id @default(uuid())
  companyId   String
  requestedBy String
  approvedBy  String?
  reason      String
  scope       SupportAccessScope  @default(READ_ONLY)
  status      SupportAccessStatus @default(REQUESTED)
  requestedAt DateTime            @default(now())
  approvedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([requestedBy])
}

model SupportSession {
  id        String              @id @default(uuid())
  requestId String?
  companyId String
  actor     String
  mode      SupportSessionMode  @default(IMPERSONATE)
  scope     SupportAccessScope  @default(READ_ONLY)
  status    SupportAccessStatus @default(ACTIVE)
  reason    String
  startedAt DateTime            @default(now())
  endedAt   DateTime?
  expiresAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([requestId])
  @@index([actor])
}

enum RunbookRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RunbookExecutionStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

model RunbookDefinition {
  id         String           @id @default(uuid())
  companyId  String?
  name       String
  actionType String
  schedule   String?
  enabled    Boolean          @default(true)
  riskLevel  RunbookRiskLevel @default(LOW)
  inputJson  String?
  createdBy  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company    Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  executions RunbookExecution[]

  @@index([companyId, enabled])
  @@index([actionType])
}

model RunbookExecution {
  id         String                 @id @default(uuid())
  runbookId  String
  companyId  String?
  status     RunbookExecutionStatus @default(QUEUED)
  dryRun     Boolean                @default(false)
  startedAt  DateTime               @default(now())
  finishedAt DateTime?
  resultJson String?
  errorJson  String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  runbook RunbookDefinition @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  company Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([runbookId, createdAt])
  @@index([companyId, createdAt])
  @@index([status])
}

model TenantSloMetricSnapshot {
  id          String    @id @default(uuid())
  companyId   String
  metricKey   String
  value       Float
  status      String    @default("OK")
  windowStart DateTime?
  windowEnd   DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, metricKey, createdAt])
}

enum HealthIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model HealthIncident {
  id             String               @id @default(uuid())
  companyId      String
  metricKey      String
  riskLevel      RunbookRiskLevel     @default(LOW)
  actionType     String
  status         HealthIncidentStatus @default(OPEN)
  message        String
  actualValue    Float?
  thresholdValue Float?
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  updatedAt      DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([riskLevel, status])
}

enum ContractAccessState {
  ACTIVE
  WARNING
  SUSPENDED
  OVERRIDE
}

model ContractEnforcementEvent {
  id          String              @id @default(uuid())
  companyId   String
  fromState   ContractAccessState
  toState     ContractAccessState
  reason      String
  overrideBy  String?
  expiresAt   DateTime?
  effectiveAt DateTime            @default(now())
  createdAt   DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model PlatformAuditEvent {
  id            String   @id @default(uuid())
  companyId     String?
  actor         String?
  eventType     String
  entityType    String?
  entityId      String?
  reason        String?
  payloadJson   String?
  eventHash     String   @unique
  prevEventHash String?
  createdAt     DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([eventType, createdAt])
}

model Site {
  id        String  @id @default(uuid())
  name      String
  code      String
  location  String?
  companyId String
