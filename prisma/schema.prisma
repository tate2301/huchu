/// How an employee is treated for PAYE.
///
/// STANDARD is the ordinary employed person on the monthly band table.
/// EXEMPT covers the handful ZIMRA does not tax through PAYE at all.
/// CONTRACTOR is paid gross with no PAYE withheld — the payment is theirs to
/// declare — which is a different thing from EXEMPT and must not be conflated
/// with it, since the NSSA treatment differs too.
/// The statutory rates a Zimbabwean payroll needs, one key each.
enum StatutoryRateKey {
  /// 3% of the PAYE figure — not of gross. A common and expensive mistake.
  AIDS_LEVY
  /// NSSA Pension and Other Benefits Scheme, employee side. 4.5% of insurable
  /// earnings up to the ceiling on the same row.
  NSSA_POBS_EMPLOYEE
  /// NSSA POBS, employer side. Same rate, same ceiling, employer's cost.
  NSSA_POBS_EMPLOYER
  /// Accident Prevention and Workers Compensation Scheme — employer only, and
  /// the rate varies by industry risk class.
  NSSA_APWCS
  /// Zimbabwe Manpower Development Fund, 1% of gross, employer only.
  ZIMDEF
  /// Standards Development Levy, employer only.
  STANDARDS_DEVELOPMENT_LEVY
  /// The portion of an annual bonus that is not taxed. Held here rather than on
  /// the PAYE table because it is revised on its own schedule.
  BONUS_EXEMPTION
}

enum TaxCreditKey {
  /// 50% of the employee's medical aid contributions.
  MEDICAL_AID
  /// The elderly persons' credit, for employees over the qualifying age.
  ELDERLY
  /// The disabled persons' credit.
  DISABILITY
}

enum EmployeeTaxStatus {
  STANDARD
  EXEMPT
  CONTRACTOR
}

enum CompensationRuleType {
  ALLOWANCE
  DEDUCTION
  /// Withheld from the employee and owed to an authority — PAYE, the AIDS
  /// levy, NSSA employee, NEC employee dues. Reduces net pay and credits a
  /// statutory payable rather than the generic deductions account.
  STATUTORY_DEDUCTION
  /// Paid by the employer on top of the wage — NSSA employer, ZIMDEF, SDL,
  /// APWCS, NEC employer dues. Cost to the company and a liability to the
  /// authority; never touches net pay.
  EMPLOYER_CONTRIBUTION
}

enum CompensationCalcMethod {
  FIXED
  PERCENT
  /// Resolved from an effective-dated `PayeTable` for the line's currency
  /// rather than from a value on the rule.
  TAX_TABLE
  /// A percentage of a named earlier stage rather than of gross — the AIDS
