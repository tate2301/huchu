  taxable        Boolean                @default(false)
  currency       String                 @default("USD")
  /// Where this rule sits in the pipeline. Order matters and cannot be
  /// inferred from the type: a pension deduction comes off before PAYE is
  /// struck and a union subscription comes off after, and both are DEDUCTION.
  sequence       Int                    @default(100)
  /// For PERCENT_OF_COMPONENT — the `statutoryKey` of the stage this is a
  /// percentage of. The AIDS levy points at PAYE.
  basedOnKey     String?
  /// Set on the rules the statutory pack owns (PAYE, NSSA, AIDS_LEVY, ZIMDEF,
  /// SDL, APWCS, NEC_*). Null on anything a company wrote itself. This is what
  /// tells the payslip and the returns which lines are the state's.
  statutoryKey   String?
  isActive       Boolean                @default(true)
  workflowStatus WorkflowStatus         @default(DRAFT)
  employeeId     String?
  departmentId   String?
  gradeId        String?
  createdById    String
  submittedById  String?
  approvedById   String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  company       Company                    @relation(fields: [companyId], references: [id])
  employee      Employee?                  @relation("CompRuleEmployeeTarget", fields: [employeeId], references: [id])
  department    Department?                @relation(fields: [departmentId], references: [id])
  grade         JobGrade?                  @relation(fields: [gradeId], references: [id])
  createdBy     User                       @relation("CompRuleCreatedBy", fields: [createdById], references: [id])
  submittedBy   User?                      @relation("CompRuleSubmittedBy", fields: [submittedById], references: [id])
  approvedBy    User?                      @relation("CompRuleApprovedBy", fields: [approvedById], references: [id])
  components    PayrollLineComponent[]
  templateLinks CompensationTemplateRule[]

  @@index([companyId, isActive])
  @@index([workflowStatus])
  @@index([employeeId])
  @@index([departmentId])
  @@index([gradeId])
}

