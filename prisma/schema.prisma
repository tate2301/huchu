model SchoolFeeInvoice {
  id             String                 @id @default(uuid())
  companyId      String
  invoiceNo      String
  studentId      String
  termId         String
  feeStructureId String?
  issueDate      DateTime
  dueDate        DateTime
  status         SchoolFeeInvoiceStatus @default(DRAFT)
  subTotal       Decimal                @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal                @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal                @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal                @default(0) @db.Decimal(14, 2)
  waivedAmount   Decimal                @default(0) @db.Decimal(14, 2)
  writeOffAmount Decimal                @default(0) @db.Decimal(14, 2)
  balanceAmount  Decimal                @default(0) @db.Decimal(14, 2)
  /// S-2.5 — what the family has settled *beyond* the bill.
  ///
  /// `balanceAmount` is clamped at zero, so before this column an invoice that
  /// ended up over-settled — a full payment followed by a bursary, most often —
  /// simply lost the difference. It is carried here instead, and it is one of
  /// the two things a refund may be drawn against. `balanceAmount` and
  /// `creditAmount` are never both positive; a CHECK constraint says so.
  creditAmount   Decimal                @default(0) @db.Decimal(14, 2)
  /// S-2.6 — the part of `creditAmount` already promised to a refund.
  ///
  /// Held from the moment a refund is requested, not from the moment it is
  /// paid, so the same over-payment cannot be requested back twice. A CHECK
  /// constraint holds it at or below `creditAmount`.
  refundedAmount Decimal                @default(0) @db.Decimal(14, 2)
  /// The currency the family is billed in, copied from the fee structure at
  /// creation so a later edit to the structure cannot restate an issued bill.
  currency       String                 @default("USD")
  /// Quote units per one base unit, the same sense as `CurrencyRate.rate`:
  /// 27.5 means 27.5 ZWG buys one USD. Always 1 for a document already in the
  /// company's base currency.
  exchangeRate   Decimal                @default(1) @db.Decimal(12, 4)
  /// `totalAmount` expressed in the company's `AccountingSettings.baseCurrency`
  /// — this is what reaches the ledger and what cross-currency reporting sums.
  baseAmount     Decimal                @default(0) @db.Decimal(14, 2)
  notes          String?
  issuedById     String?
  issuedAt       DateTime?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  company            Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student            SchoolStudent                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term               SchoolTerm                   @relation(fields: [termId], references: [id], onDelete: Cascade)
  feeStructure       SchoolFeeStructure?          @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  lines              SchoolFeeInvoiceLine[]
  receiptAllocations SchoolFeeReceiptAllocation[]
  waivers            SchoolFeeWaiver[]
  refunds            SchoolFeeRefund[]

  /// S-2.4 lives in the database, not here. "One live invoice per student, per
  /// term, per fee structure" is a **partial** unique index — voided invoices
  /// must not block the replacement that follows them — and Prisma cannot
  /// express a `WHERE` on `@@unique`. It is
  /// `SchoolFeeInvoice_live_student_term_structure_key` in migration
  /// 20260805120000_school_fee_money_decimal_currency_and_one_live_invoice.
  /// Scoped by `feeStructureId` deliberately: boarding and tuition are two
  /// structures and a boarder is legitimately billed for both in one term.
  /// `feeStructureId` is nullable and Postgres treats NULLs as distinct, so
  /// hand-written ad-hoc invoices are outside the index and stay repeatable.
  @@unique([companyId, invoiceNo])
  @@index([companyId, status])
  @@index([studentId, termId])
  @@index([companyId, studentId, termId, feeStructureId])
}

