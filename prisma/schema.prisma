enum SchoolPortalInviteSubject {
  STUDENT
  GUARDIAN
}

/// An invitation for a student or guardian to claim their portal account.
///
/// The subject is a nullable foreign key per kind rather than a type+id string
/// pair, so the database cascades a delete and refuses an invite pointing at a
/// record that does not exist — a dangling invite is how an account outlives
/// the child it belonged to. Exactly one of the two is set; `subject` says
/// which, so a query does not have to guess.
///
/// Only the sha256 hash of the token is stored. The plaintext appears once, in
/// the response to whoever issued it, and is never recoverable afterwards.
model SchoolPortalInvite {
  id            String                    @id @default(uuid())
  companyId     String
  subject       SchoolPortalInviteSubject
  studentId     String?
  guardianId    String?
  tokenHash     String                    @unique
  sentTo        String
  expiresAt     DateTime
  claimedAt     DateTime?
  claimedUserId String?
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student     SchoolStudent?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian    SchoolGuardian? @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  claimedUser User?           @relation("SchoolPortalInviteClaimedBy", fields: [claimedUserId], references: [id], onDelete: SetNull)

  @@index([companyId, subject, claimedAt])
  @@index([studentId])
  @@index([guardianId])
}

/// How this school writes its identifiers and its ID cards.
///
/// One row per company. When the format columns are null the generator keeps
/// inferring the scheme from the numbers already on the books
/// (`inferNumbering`); setting them here is the office saying "this is our
/// scheme" out loud, and the explicit answer beats the inferred one.
///
/// No Company relation on purpose: this is reference data read inside the
/// id-generator's transaction, and a settings row must never cascade anything.
/// A scheme of work: the term's teaching, written down week by week.
///
/// Keyed by week-of-term because that is how schemes are actually written — a
/// scheme is a table whose rows are weeks, not a list of topics floating free.
/// Held per subject and *level* rather than per class, because Form 2A and
/// Form 2B follow one scheme; the class is which room it happens in.
///
/// This is what "lay out this week" reads: a lesson drafted in week 4 takes
/// week 4's topic and objectives from here, and the planner stops being a
/// blank form.
model SchoolSchemeOfWork {
  id        String @id @default(uuid())
  companyId String
  subjectId String
  termId    String
  /// The class level (form) this scheme teaches, matching SchoolClass.level.
  level     Int
  /// 1-based week within the term, counted from the term's first Monday.
  weekOfTerm Int

  topic         String
  objectives    String?
  activities    String?
  resourcesNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subject SchoolSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term    SchoolTerm    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([companyId, subjectId, termId, level, weekOfTerm])
  @@index([companyId, termId, subjectId, level])
}

/// A conversation between one family and one member of staff, about one pupil.
///
/// Two-party on purpose. Both prototypes show the same thing — a parent's
/// "Messages from teachers" and a teacher's "Parent messages", each a list of
/// people rather than of rooms — and a school's messaging answers to a
/// safeguarding question that group chat makes unanswerable: who could read
/// this. Two named participants and a named child is a record the office can
/// hand to a governor.
///
/// `teacherProfileId` null means the thread is with the office rather than with
/// a teacher, which is what "Write to the school" sends.
model SchoolMessageThread {
  id               String    @id @default(uuid())
  companyId        String
  /// The pupil this is about. Null for a general enquiry to the office.
  studentId        String?
  guardianId       String
  teacherProfileId String?
  subject          String
  /// Denormalised so an inbox can sort without reading every message.
  lastMessageAt    DateTime  @default(now())
  /// When each side last opened it. Unread is derived by comparing these with
  /// message timestamps rather than kept as a counter, because a counter and
  /// the messages it counts drift apart, and the badge is the thing people
  /// trust.
  guardianReadAt   DateTime?
  staffReadAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student        SchoolStudent?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  guardian       SchoolGuardian        @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  teacherProfile SchoolTeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: SetNull)
  messages       SchoolMessage[]

  @@index([companyId, guardianId, lastMessageAt])
  @@index([companyId, teacherProfileId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([companyId, studentId])
}

/// One message in a thread. Never edited and never deleted: a school's record
/// of what a parent was told has to still be true a year later.
model SchoolMessage {
  id           String            @id @default(uuid())
  companyId    String
  threadId     String
  senderUserId String
  /// Which side sent it, kept beside the sender so a reader does not have to
  /// resolve a user to know whose message they are looking at.
  senderSide   SchoolMessageSide
  body         String
  createdAt    DateTime          @default(now())

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  thread  SchoolMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender  User                @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([companyId, threadId, createdAt])
}

enum SchoolMessageSide {
  GUARDIAN
  STAFF
}

