model BuyerReceipt {
  id                  String           @id @default(uuid())
  // legacy single-FK, prefer the join tables (batches / dispatches)
  goldDispatchId      String?
  // legacy single-FK, prefer the join tables (batches / dispatches)
  goldPourId          String?
  companyId           String?
  receiptNumber       String
  receiptDate         DateTime
  assayResult         Decimal?         @db.Decimal(5, 2) // actual purity
  paidAmount          Decimal          @db.Decimal(14, 2)
  paymentMethod       String
  paymentChannel      String?
  paymentReference    String?
  notes               String?
  goldPriceUsdPerGram Decimal?         @db.Decimal(12, 4)
  goldPriceSource     GoldPriceSource?
  valuationDate       DateTime?
  // paidValueUsd dropped in Epic 7 (duplicated paidAmount; gold is USD-only per §8 Q2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goldDispatch GoldDispatch? @relation(fields: [goldDispatchId], references: [id])
  goldPour     GoldPour?     @relation(fields: [goldPourId], references: [id])
  company      Company?      @relation("BuyerReceiptCompany", fields: [companyId], references: [id])

  // Aggregate join: a single BuyerReceipt may cover N pours and N dispatches.
  // The legacy single FKs above remain populated for backward compatibility
  // (UI fallbacks, prior reports, accounting hooks) but new code should
  // prefer iterating these.
  batches     BuyerReceiptBatch[]
  dispatches  BuyerReceiptDispatch[]
  corrections BuyerReceiptCorrection[]

  @@unique([companyId, receiptNumber])
  @@index([goldPourId])
  @@index([goldDispatchId])
  @@index([receiptDate])
  @@index([companyId, receiptDate(sort: Desc)])
}

