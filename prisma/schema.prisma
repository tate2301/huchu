model CrmApiKey {
  id                 String          @id @default(uuid())
  companyId          String
  name               String
  keyPrefix          String
  keyHash            String          @unique
  // Attribution defaults applied to every lead captured with this key
  // (e.g. a "Facebook Lead Ads" key labels its leads SOCIAL/facebook).
  defaultChannel     CrmLeadChannel?
  defaultSourceLabel String?
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdById        String?
  createdAt          DateTime        @default(now())

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("CrmApiKeyCreatedBy", fields: [createdById], references: [id])
  submissions CrmIntakeSubmission[]

  @@index([companyId, revokedAt])
}

model CrmLeadSource {
  id        String         @id @default(uuid())
  companyId String
  name      String
  channel   CrmLeadChannel @default(OTHER)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model CrmCommissionRule {
  id              String             @id @default(uuid())
  companyId       String
  name            String
  basis           CrmCommissionBasis @default(INVOICED)
  appliesToUserId String?
  isActive        Boolean            @default(true)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appliesToUser User?                @relation("CrmCommissionRuleUser", fields: [appliesToUserId], references: [id])
  tiers         CrmCommissionTier[]
  entries       CrmCommissionEntry[]

  @@index([companyId, isActive, appliesToUserId])
}

model CrmCommissionTier {
  id            String @id @default(uuid())
  ruleId        String
  thresholdFrom Float
  ratePercent   Float
  sortOrder     Int    @default(0)

  rule CrmCommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, sortOrder])
}

model CrmCommissionEntry {
  id             String                   @id @default(uuid())
  companyId      String
  repId          String
  leadId         String?
  leadDocumentId String?
  ruleId         String?
  basis          CrmCommissionBasis
  periodKey      String
  baseAmount     Float
  ratePercent    Float
  amount         Float
  currency       String                   @default("USD")
  status         CrmCommissionEntryStatus @default(PENDING)
  approvedById   String?
  paidAt         DateTime?
  notes          String?
  calculatedAt   DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rep          User               @relation("CrmCommissionEntryRep", fields: [repId], references: [id])
  lead         CrmLead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadDocument CrmLeadDocument?   @relation(fields: [leadDocumentId], references: [id], onDelete: SetNull)
  rule         CrmCommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  approvedBy   User?              @relation("CrmCommissionEntryApprovedBy", fields: [approvedById], references: [id])

  @@unique([companyId, leadDocumentId, repId, basis])
  @@index([companyId, repId, periodKey])
  @@index([companyId, status, periodKey])
}

// NEXTAUTH MODELS
// ============================================

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// CCTV / SURVEILLANCE INTEGRATION
// ============================================

model NVR {
  id            String    @id @default(uuid())
  name          String
  ipAddress     String
  port          Int       @default(554) // RTSP port
  httpPort      Int       @default(80) // ISAPI port
  username      String
  password      String // Encrypted in production
  siteId        String
  manufacturer  String    @default("Hikvision")
  model         String?
  firmware      String?
  isActive      Boolean   @default(true)
  isOnline      Boolean   @default(false)
  lastHeartbeat DateTime?

  // Network settings
  rtspPort     Int     @default(554)
  isapiEnabled Boolean @default(true)
  onvifEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site    Site        @relation(fields: [siteId], references: [id])
  cameras Camera[]
  events  CCTVEvent[]

  @@index([siteId])
  @@index([ipAddress])
}

model Camera {
  id            String @id @default(uuid())
  name          String
  channelNumber Int
  nvrId         String
  siteId        String

  // Location/Area
  area        String // "Gate", "Gold Room", "Crusher", "Processing"
  description String?

  // Stream configuration
  mainStreamId String? // e.g., "101" for channel 1 main
  subStreamId  String? // e.g., "102" for channel 1 sub

  // Camera capabilities
  hasPTZ          Boolean @default(false)
  hasAudio        Boolean @default(false)
  hasMotionDetect Boolean @default(true)
  hasLineDetect   Boolean @default(false)
  isActive        Boolean @default(true)

  // Status
  isOnline    Boolean   @default(false)
  isRecording Boolean   @default(true)
  lastSeen    DateTime?

  // Business context
  isHighSecurity Boolean @default(false) // e.g., gold room cameras
  requiredUptime Float? // percentage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nvr             NVR               @relation(fields: [nvrId], references: [id])
  site            Site              @relation(fields: [siteId], references: [id])
  events          CCTVEvent[]
  streamSessions  StreamSession[]
  playbackRecords PlaybackRecord[]
  accessLogs      CameraAccessLog[]

  @@unique([nvrId, channelNumber])
  @@index([siteId])
  @@index([nvrId])
  @@index([area])
}

enum CCTVEventType {
  MOTION_DETECTION
  LINE_CROSSING
  INTRUSION
  VIDEO_LOSS
  DISK_FULL
  DISK_ERROR
  NETWORK_DISCONNECTED
  ILLEGAL_ACCESS
  ALARM_INPUT
  TAMPERING
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum StreamProtocol {
  WEBRTC
  HLS
}

enum StreamSessionStatus {
  ACTIVE
  STOPPED
  FAILED
}

model CCTVEvent {
  id        String        @id @default(uuid())
  nvrId     String?
  cameraId  String?
  eventType CCTVEventType
  severity  EventSeverity @default(MEDIUM)
  eventTime DateTime

  // Event details
  title       String
  description String?
  snapshotUrl String? // URL to event snapshot

  // Context
  linkedIncidentId String? // Link to Incident model if escalated

  // Status
  isAcknowledged Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  notes          String?

  createdAt DateTime @default(now())

  nvr    NVR?    @relation(fields: [nvrId], references: [id])
  camera Camera? @relation(fields: [cameraId], references: [id])

  @@index([eventTime])
  @@index([cameraId])
  @@index([eventType])
  @@index([isAcknowledged])
}

model StreamSession {
  id         String              @id @default(uuid())
  cameraId   String
  siteId     String
  userId     String
  streamType String              @default("sub")
  protocol   StreamProtocol
  status     StreamSessionStatus @default(ACTIVE)
  playUrl    String?
  purpose    String?
  clientMeta String?
  startedAt  DateTime            @default(now())
  endedAt    DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  camera Camera @relation(fields: [cameraId], references: [id])
  site   Site   @relation(fields: [siteId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([cameraId, status])
  @@index([siteId, startedAt])
  @@index([userId, startedAt])
}

model PlaybackRecord {
  id        String   @id @default(uuid())
  cameraId  String
  startTime DateTime
  endTime   DateTime
  fileSize  Int? // in MB

  // Playback access
  playbackUri   String? // RTSP URI for playback
  recordingType String  @default("CONTINUOUS") // CONTINUOUS, EVENT, MANUAL

  // Metadata
  duration   Int? // in seconds
  hasAudio   Boolean @default(false)
  resolution String? // e.g., "1920x1080"

  // Access tracking
  requestedBy String? // User who requested playback
  purpose     String? // "Incident review", "Audit", etc.

  createdAt DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id])

  @@index([cameraId])
  @@index([startTime, endTime])
}

model CameraAccessLog {
  id         String    @id @default(uuid())
  cameraId   String
  userId     String?
  accessType String // "LIVE_VIEW", "PLAYBACK", "PTZ_CONTROL"
  startTime  DateTime
  endTime    DateTime?
  duration   Int? // in seconds
  ipAddress  String?

  // Business context
  purpose String?
  notes   String?

  createdAt DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id])

  @@index([cameraId])
  @@index([userId])
  @@index([startTime])
}

// ---------------------------------------------------------------------------
// CRM core records: people, companies, deals, sites.
//
// CrmClient is the company record. It predates this model set and already
// carries the link to the accounting Customer, so it is extended in place
// rather than renamed — a rename under db:push would drop the table.
// ---------------------------------------------------------------------------

enum CrmCompanyType {
  CUSTOMER
  PROSPECT
  SUPPLIER
  PARTNER
  OTHER
}

/// How a company sits under its parent. Deliberately not a corporate
/// ownership model — users only need to say "this belongs under that".
enum CrmCompanyRelation {
  HEAD_OFFICE
  BRANCH
  SUBSIDIARY
  DEPARTMENT
}

enum CrmAccountStatus {
  ACTIVE
  ON_HOLD
  INACTIVE
  BLACKLISTED
}

enum CrmContactType {
  CUSTOMER
  DECISION_MAKER
  SITE_CONTACT
  FINANCE_CONTACT
  SUPPLIER_CONTACT
  REFERRAL_PARTNER
  OTHER
}

enum CrmPreferredChannel {
  PHONE
  EMAIL
  WHATSAPP
  SMS
  IN_PERSON
}

/// A person's role on a specific deal. One person may hold several.
enum CrmDealContactRole {
  PRIMARY
  DECISION_MAKER
  FINANCE
  SITE
  TECHNICAL
  INFLUENCER
  REFERRER
}

/// Won and Lost are protected outcomes: stages are configurable, but every
/// pipeline resolves to one of these three states.
enum CrmDealStatus {
  OPEN
  WON
  LOST
}

enum CrmForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
}

model CrmPerson {
  id                  String               @id @default(uuid())
  /// A picture chosen for this record. Wins over the emoji when set.
  avatarUrl           String?
  /// A colour for this record, Notion-style. One of the design system's
  /// accent names; null means it takes its colour from its own name.
  accent              String?
  /// A single emoji standing in for this record, shown where a picture would
  /// be. Falls back to the entity's own icon when unset.
  emoji               String?
  companyId           String
  personNo            String
  firstName           String
  lastName            String?
  /// Denormalised "First Last" for search and display ordering.
  fullName            String
  jobTitle            String?
  email               String?
  emailNormalized     String?
  additionalEmails    String[]             @default([])
  phone               String?
  phoneE164           String?
  additionalPhones    String[]             @default([])
  contactType         CrmContactType       @default(CUSTOMER)
  preferredChannel    CrmPreferredChannel?
  addressLine         String?
  city                String?
  country             String?
  notes               String?
  tags                String[]             @default([])
  /// Primary employer. Additional affiliations live in CrmPersonCompany.
  clientId            String?
  assignedToId        String?
  /// Where this record came from: MANUAL, IMPORT, LEAD_CONVERSION, INTAKE_FORM.
  sourceType          String               @default("MANUAL")
  convertedFromLeadId String?
  customFields        Json?
  lastContactedAt     DateTime?
  archivedAt          DateTime?
  /// Set when this record was merged away; reads redirect to the survivor.
  mergedIntoId        String?
  createdById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         CrmClient?         @relation("CrmPersonPrimaryCompany", fields: [clientId], references: [id], onDelete: SetNull)
  assignedTo     User?              @relation("CrmPersonAssignedTo", fields: [assignedToId], references: [id])
  createdBy      User?              @relation("CrmPersonCreatedBy", fields: [createdById], references: [id])
  mergedInto     CrmPerson?         @relation("CrmPersonMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom     CrmPerson[]        @relation("CrmPersonMerge")
  companyLinks   CrmPersonCompany[]
  dealContacts   CrmDealContact[]
  dealsPrimaryOn CrmDeal[]          @relation("CrmDealPrimaryContact")
  sitesPrimaryOn CrmSite[]          @relation("CrmSitePrimaryContact")
  activities     CrmActivity[]
  leadsConverted CrmLead[]          @relation("CrmLeadConvertedPerson")
  tasks          CrmTask[]
  comments       CrmComment[]
  files          CrmRecordFile[]

  @@unique([companyId, personNo])
  @@index([companyId, fullName])
  @@index([companyId, emailNormalized])
  @@index([companyId, phoneE164])
  @@index([companyId, clientId])
  @@index([companyId, assignedToId])
  @@index([companyId, archivedAt])
}

/// Additional company affiliations beyond CrmPerson.clientId.
model CrmPersonCompany {
  id        String   @id @default(uuid())
  companyId String
  personId  String
  clientId  String
  jobTitle  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  person  CrmPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  client  CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([personId, clientId])
  @@index([companyId, clientId])
}

model CrmSite {
  id                 String    @id @default(uuid())
  /// A picture chosen for this record. Wins over the emoji when set.
  avatarUrl          String?
  /// A colour for this record, Notion-style. One of the design system's
  /// accent names; null means it takes its colour from its own name.
  accent             String?
  /// A single emoji standing in for this record. Falls back to the entity icon.
  emoji              String?
  companyId          String
  siteNo             String
  name               String
  clientId           String?
  addressLine        String?
  city               String?
  country            String?
  latitude           Float?
  longitude          Float?
  primaryContactId   String?
  accessInstructions String?
  siteConditions     String?
  photos             Json?
  notes              String?
  tags               String[]  @default([])
  customFields       Json?
  archivedAt         DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         CrmClient?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  primaryContact CrmPerson?       @relation("CrmSitePrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  createdBy      User?            @relation("CrmSiteCreatedBy", fields: [createdById], references: [id])
  deals          CrmDeal[]
  appointments   CrmAppointment[]
  tasks          CrmTask[]
  comments       CrmComment[]
  files          CrmRecordFile[]

  workOrders CrmWorkOrder[]

  @@unique([companyId, siteNo])
  @@index([companyId, name])
  @@index([companyId, clientId])
  @@index([companyId, archivedAt])
}

/// A deal is the commercial opportunity: the record that carries pipeline
/// stage, value, quotes, visits and payments. A lead is only the unqualified
/// enquiry that may produce one.
model CrmDeal {
  id                  String              @id @default(uuid())
  /// A picture chosen for this record. Wins over the emoji when set.
  avatarUrl           String?
  /// A colour for this record, Notion-style. One of the design system's
  /// accent names; null means it takes its colour from its own name.
  accent              String?
  /// A single emoji standing in for this record. Falls back to the entity icon.
  emoji               String?
  companyId           String
  dealNo              String
  title               String
  clientId            String?
  primaryContactId    String?
  siteId              String?
  pipelineId          String
  stageId             String
  status              CrmDealStatus       @default(OPEN)
  value               Float?
  currency            String              @default("USD")
  probability         Int?
  forecastCategory    CrmForecastCategory @default(PIPELINE)
  expectedCloseDate   DateTime?
  assignedToId        String?
  services            String[]            @default([])
  source              String?
  sourceChannel       CrmLeadChannel      @default(MANUAL)
  lostReason          String?
  customFields        Json?
  /// Stamped on every stage move so "days in stage" needs no timeline scan.
  stageEnteredAt      DateTime            @default(now())
  wonAt               DateTime?
  lostAt              DateTime?
  convertedFromLeadId String?
  archivedAt          DateTime?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         CrmClient?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  primaryContact CrmPerson?        @relation("CrmDealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  site           CrmSite?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  pipeline       CrmPipeline       @relation(fields: [pipelineId], references: [id])
  stage          CrmPipelineStage  @relation(fields: [stageId], references: [id])
  assignedTo     User?             @relation("CrmDealAssignedTo", fields: [assignedToId], references: [id])
  createdBy      User?             @relation("CrmDealCreatedBy", fields: [createdById], references: [id])
  contacts       CrmDealContact[]
  activities     CrmActivity[]
  followUps      CrmFollowUp[]
  appointments   CrmAppointment[]
  documents      CrmLeadDocument[]
  leadsConverted CrmLead[]         @relation("CrmLeadConvertedDeal")
  tasks          CrmTask[]
  comments       CrmComment[]
  files          CrmRecordFile[]

  workOrders CrmWorkOrder[]

  @@unique([companyId, dealNo])
  @@index([companyId, stageId])
  @@index([companyId, status, updatedAt])
  @@index([companyId, assignedToId, status])
  @@index([companyId, clientId])
  @@index([companyId, expectedCloseDate])
}

model CrmDealContact {
  id        String             @id @default(uuid())
  companyId String
  dealId    String
  personId  String
  role      CrmDealContactRole @default(PRIMARY)
  notes     String?
  createdAt DateTime           @default(now())

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal    CrmDeal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  person  CrmPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([dealId, personId, role])
  @@index([companyId, personId])
}

// ---------------------------------------------------------------------------
// Configurable pipelines. Stages are data, not code — but every pipeline
// still resolves to the three protected outcomes in CrmDealStatus.
// ---------------------------------------------------------------------------

model CrmPipeline {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  /// The pipeline new deals land in when none is chosen.
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("CrmPipelineCreatedBy", fields: [createdById], references: [id])
  stages    CrmPipelineStage[]
  deals     CrmDeal[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model CrmPipelineStage {
  id                String        @id @default(uuid())
  companyId         String
  pipelineId        String
  name              String
  position          Int           @default(0)
  /// Which protected outcome entering this stage puts the deal in. Exactly
  /// one WON and one LOST stage per pipeline; the rest are OPEN.
  status            CrmDealStatus @default(OPEN)
  probability       Int           @default(0)
  colorToken        String?
  /// Days a deal may sit here before it counts as stale. Null disables.
  inactivityDays    Int?
  /// Field keys that must be filled before a deal may leave this stage.
  requiredFields    String[]      @default([])
  /// Short "what should happen here" checklist shown on the deal.
  checklist         Json?
  requiresSiteVisit Boolean       @default(false)
  requiresQuotation Boolean       @default(false)
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    CrmDeal[]

  @@unique([pipelineId, name])
  @@index([companyId, pipelineId, position])
}

// ---------------------------------------------------------------------------
// Custom fields. Definitions are metadata; values live in a `customFields`
// JSON column on each record, keyed by CrmFieldDefinition.key. That keeps
// reads a single row fetch and avoids an EAV join on every list query.
// ---------------------------------------------------------------------------

/// Which kind of record a custom field, a list membership or a follow is about.
///
/// The `Crm` prefix is now a misnomer and is kept only because renaming a
/// Postgres enum that four features key off is a migration with no user-visible
/// payoff. It is the product's record-type discriminator: `CrmFieldDefinition`,
/// `CrmList`/`CrmListMember`, `CrmFollower` and the merge dialog all read it,
/// and S-4.4 needs school records in it so a school can add its own fields to a
/// pupil. See `lib/records/registry.ts` for the type list this mirrors.
enum CrmFieldEntity {
  PERSON
  COMPANY
  LEAD
  DEAL
  SITE
  WORK_ORDER
  STUDENT
  GUARDIAN
  TEACHER
  CLASS
  SUBJECT
  HOSTEL
  /// A member of staff, i.e. a `User`. Files hang off a rep's profile page and
  /// had their own `CrmRecordFile.userId` column before S-4.2; a rep is a
  /// record with a page, so it is a subject type like any other.
  REP
}

enum CrmFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  PERCENT
  DATE
  DATETIME
  CHECKBOX
  SINGLE_SELECT
  MULTI_SELECT
  PHONE
  EMAIL
  URL
  ADDRESS
  USER
  PERSON
  COMPANY
  SITE
}

model CrmFieldDefinition {
  id           String         @id @default(uuid())
  companyId    String
  entity       CrmFieldEntity
  /// Stable key used in the record's customFields JSON. Immutable once set.
  key          String
  label        String
  description  String?
  type         CrmFieldType
  isRequired   Boolean        @default(false)
  defaultValue Json?
  /// Choices for SINGLE_SELECT / MULTI_SELECT: [{value,label,colorToken?}].
  options      Json?
  /// Grouping on the record page, e.g. "Qualification".
  section      String?
  position     Int            @default(0)
  showInTable  Boolean        @default(false)
  archivedAt   DateTime?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CrmFieldDefinitionCreatedBy", fields: [createdById], references: [id])

  @@unique([companyId, entity, key])
  @@index([companyId, entity, archivedAt])
}

// ---------------------------------------------------------------------------
// Static lists: manual membership, as opposed to a saved view's filters.
//
// The distinction is deliberate and kept visible in the UI — a view shows
// whatever matches, a list shows what someone put in it.
// ---------------------------------------------------------------------------

model CrmList {
  id          String         @id @default(uuid())
  companyId   String
  entity      CrmFieldEntity
  name        String
  description String?
  isShared    Boolean        @default(false)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User            @relation("CrmListCreatedBy", fields: [createdById], references: [id])
  members   CrmListMember[]

  @@unique([companyId, entity, name])
  @@index([companyId, entity])
}

model CrmListMember {
  id        String   @id @default(uuid())
  companyId String
  listId    String
  /// The record's id. Which table it points at is fixed by the list's entity,
  /// so this is deliberately not a foreign key — one join table serves every
  /// record type rather than one per type.
  recordId  String
  addedById String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  list    CrmList @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("CrmListMemberAddedBy", fields: [addedById], references: [id])

  @@unique([listId, recordId])
  @@index([companyId, recordId])
}

// ---------------------------------------------------------------------------
// Tasks, collaboration and followers.
//
// CrmFollowUp remains as the lead/deal follow-up it always was; CrmTask is the
// generic work item the spec asks for, with types, priority, outcomes and
// simple recurrence.
// ---------------------------------------------------------------------------

enum CrmTaskType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  VISIT_PREP
  DOCUMENT_FOLLOW_UP
  PAYMENT_FOLLOW_UP
  GENERAL
}

enum CrmTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CrmTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// What came of a task. Which outcomes apply depends on the task type — see
/// lib/crm/tasks.ts.
enum CrmTaskOutcome {
  ANSWERED
  NO_ANSWER
  CALL_BACK_LATER
  QUALIFIED
  NOT_INTERESTED
  REPLIED
  NO_REPLY
  ATTENDED
  NO_SHOW
  DONE
}

enum CrmRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model CrmTask {
  id           String          @id @default(uuid())
  companyId    String
  title        String
  description  String?
  type         CrmTaskType     @default(GENERAL)
  priority     CrmTaskPriority @default(NORMAL)
  status       CrmTaskStatus   @default(OPEN)
  dueAt        DateTime
  /// Null when the task is due on a day rather than at a time.
  hasDueTime   Boolean         @default(false)
  remindAt     DateTime?
  outcome      CrmTaskOutcome?
  outcomeNotes String?
  completedAt  DateTime?
  assignedToId String?
  createdById  String?

  // The record this task is about. Exactly one is set in practice, but the
  // schema allows several so a task can be filed against a deal and its site.
  leadId   String?
  dealId   String?
  clientId String?
  personId String?
  siteId   String?

  recurrence         CrmRecurrence @default(NONE)
  /// Every N periods, e.g. every 2 weeks. Ignored when recurrence is NONE.
  recurrenceInterval Int           @default(1)
  /// Set on the task that produced this one, so a chain stays traceable.
  recurredFromId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo   User?      @relation("CrmTaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User?      @relation("CrmTaskCreatedBy", fields: [createdById], references: [id])
  lead         CrmLead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         CrmDeal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client       CrmClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  person       CrmPerson? @relation(fields: [personId], references: [id], onDelete: Cascade)
  site         CrmSite?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  recurredFrom CrmTask?   @relation("CrmTaskRecurrence", fields: [recurredFromId], references: [id], onDelete: SetNull)
  recurrences  CrmTask[]  @relation("CrmTaskRecurrence")
  /// S-4.2 — what this row is about, as a type and an id.
  ///
  /// Replaces the nullable-foreign-key-per-kind columns above, which could name
  /// only the five CRM record types that had a column. A student could not be
  /// the subject of anything, and adding one column per school type would have
  /// meant eighteen of them across three tables.
  ///
  /// Nullable while both schemes are live: rows written before the backfill have
  /// only the old columns, and rows about a school record have only these. Reads
  /// go through `subjectWhere` in `lib/records/subject.ts`, which matches either.
  /// The old columns come out in a migration of your choosing — this side of the
  /// change adds and backfills, and drops nothing.
  subjectType CrmFieldEntity?
  subjectId   String?


  @@index([companyId, assignedToId, status, dueAt])
  @@index([companyId, status, dueAt])
  @@index([companyId, dealId])
  @@index([companyId, leadId])
  @@index([companyId, subjectType, subjectId])
}

/// Internal collaboration, deliberately separate from the customer-facing
/// activity timeline. A comment is something the team says to itself.
model CrmComment {
  id           String    @id @default(uuid())
  companyId    String
  body         String
  /// Reply threading, one level deep. Threads of threads help nobody.
  parentId     String?
  isPinned     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  editedAt     DateTime?

  leadId   String?
  dealId   String?
  clientId String?
  personId String?
  siteId   String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User         @relation("CrmCommentCreatedBy", fields: [createdById], references: [id])
  resolvedBy User?        @relation("CrmCommentResolvedBy", fields: [resolvedById], references: [id])
  parent     CrmComment?  @relation("CrmCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    CrmComment[] @relation("CrmCommentThread")
  mentions   CrmMention[]
  lead       CrmLead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       CrmDeal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client     CrmClient?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  person     CrmPerson?   @relation(fields: [personId], references: [id], onDelete: Cascade)
  site       CrmSite?     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// S-4.2 — what this row is about, as a type and an id.
  ///
  /// Replaces the nullable-foreign-key-per-kind columns above, which could name
  /// only the five CRM record types that had a column. A student could not be
  /// the subject of anything, and adding one column per school type would have
  /// meant eighteen of them across three tables.
  ///
  /// Nullable while both schemes are live: rows written before the backfill have
  /// only the old columns, and rows about a school record have only these. Reads
  /// go through `subjectWhere` in `lib/records/subject.ts`, which matches either.
  /// The old columns come out in a migration of your choosing — this side of the
  /// change adds and backfills, and drops nothing.
  subjectType CrmFieldEntity?
  subjectId   String?


  @@index([companyId, dealId, createdAt])
  @@index([companyId, leadId, createdAt])
  @@index([companyId, parentId])
  @@index([companyId, subjectType, subjectId])
}

/// A file somebody attached to a record.
///
/// Distinct from CrmLeadDocument, which is a billing document the system
/// raised and numbered. This is the signed contract, the tax clearance, the
/// photo of the damaged unit — things that arrive from outside and belong to
/// a record rather than to an invoice.
///
/// The owner is a nullable column per kind rather than an entity+id pair, so
/// the database can cascade a delete and enforce that the record exists. A
/// string id pointing at nothing is how orphaned files outlive the customer
/// who sent them.
model CrmRecordFile {
  id          String  @id @default(uuid())
  companyId   String
  /// What it is called to a reader — the original filename unless renamed.
  name        String
  url         String
  /// Bytes, when the uploader reported it.
  size        Int?
  contentType String?
  /// Why it is here. Optional; a filename is usually enough.
  note        String?

  leadId   String?
  dealId   String?
  clientId String?
  personId String?
  siteId   String?
  /// A rep's own profile — a certificate, a licence, a signed policy.
  userId   String?

  uploadedById String?
  createdAt    DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation("CrmRecordFileUploadedBy", fields: [uploadedById], references: [id])
  lead       CrmLead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       CrmDeal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client     CrmClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  person     CrmPerson? @relation(fields: [personId], references: [id], onDelete: Cascade)
  site       CrmSite?   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user       User?      @relation("CrmRecordFileSubject", fields: [userId], references: [id], onDelete: Cascade)
  /// S-4.2 — what this row is about, as a type and an id.
  ///
  /// Replaces the nullable-foreign-key-per-kind columns above, which could name
  /// only the five CRM record types that had a column. A student could not be
  /// the subject of anything, and adding one column per school type would have
  /// meant eighteen of them across three tables.
  ///
  /// Nullable while both schemes are live: rows written before the backfill have
  /// only the old columns, and rows about a school record have only these. Reads
  /// go through `subjectWhere` in `lib/records/subject.ts`, which matches either.
  /// The old columns come out in a migration of your choosing — this side of the
  /// change adds and backfills, and drops nothing.
  subjectType CrmFieldEntity?
  subjectId   String?


  @@index([companyId, leadId, createdAt])
  @@index([companyId, dealId, createdAt])
  @@index([companyId, clientId, createdAt])
  @@index([companyId, personId, createdAt])
  @@index([companyId, siteId, createdAt])
  @@index([companyId, userId, createdAt])
  @@index([companyId, subjectType, subjectId])
}

model CrmMention {
  id        String    @id @default(uuid())
  companyId String
  commentId String
  userId    String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  comment CrmComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User       @relation("CrmMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([companyId, userId, readAt])
}

/// Following a record opts you into its notable updates — not every field edit.
model CrmFollower {
  id        String         @id @default(uuid())
  companyId String
  userId    String
  entity    CrmFieldEntity
  recordId  String
  createdAt DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation("CrmFollowerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entity, recordId])
  @@index([companyId, entity, recordId])
}

/// A rule that watches for something happening and does something about it.
/// Triggers, conditions and actions are stored as JSON rather than columns
/// because the shape changes as rules are added, and a migration per rule type
/// is a tax nobody should pay for a settings screen.
model CrmAutomation {
  id            String               @id @default(uuid())
  companyId     String
  name          String
  description   String?
  trigger       CrmAutomationTrigger
  /// Trigger-specific settings, e.g. which stage, how many days of silence.
  triggerConfig Json?
  /// All must hold for the actions to run. Empty means "always".
  conditions    Json?
  /// Run in order. A failing action is logged and the rest still run.
  actions       Json
  isEnabled     Boolean              @default(true)
  /// Bumped every time the rule fires, so a runaway rule is visible.
  runCount      Int                  @default(0)
  lastRunAt     DateTime?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("CrmAutomationCreatedBy", fields: [createdById], references: [id])
  runs      CrmAutomationRun[]

  @@index([companyId, trigger, isEnabled])
}

/// One firing of a rule. Kept so "why did this lead get assigned to me?" has an
/// answer, and so a rule that is quietly failing is visible rather than
/// mysterious.
model CrmAutomationRun {
  id           String                 @id @default(uuid())
  companyId    String
  automationId String
  /// What it fired on.
  entity       CrmFieldEntity
  recordId     String
  status       CrmAutomationRunStatus @default(SUCCEEDED)
  /// Per-action outcomes, and the message when one failed.
  result       Json?
  /// Wall-clock time the actions took. Measured rather than estimated, so
  /// "this rule is slow" is a fact somebody can check rather than a feeling.
  durationMs   Int?
  /// How many actions this firing actually carried out. The unit of work a
  /// rule spends — a rule that fires rarely but does eight things each time
  /// costs more than one that fires often and sets a field.
  actionCount  Int                    @default(0)
  createdAt    DateTime               @default(now())

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  automation CrmAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([companyId, automationId, createdAt])
  @@index([companyId, entity, recordId])
}

enum CrmAutomationTrigger {
  LEAD_CREATED
  LEAD_STAGE_CHANGED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  TASK_OVERDUE
  RECORD_IDLE
  DOCUMENT_APPROVED
  PAYMENT_RECEIVED
}

enum CrmAutomationRunStatus {
  SUCCEEDED
  PARTIAL
  FAILED
}

/// A discount a rep can't give on their own.
///
/// Kept as a request rather than a block: the rep builds the quote they think
/// will win, and a manager says yes or no. Blocking outright just gets the
/// discount hidden in the unit price.
model CrmDiscountApproval {
  id              String              @id @default(uuid())
  companyId       String
  documentId      String
  /// The discount asked for, as a percentage of the undiscounted total.
  discountPercent Float
  discountAmount  Float
  reason          String?
  status          CrmApprovalDecision @default(PENDING)
  requestedById   String
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document    CrmLeadDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy User            @relation("CrmDiscountRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?           @relation("CrmDiscountDecidedBy", fields: [decidedById], references: [id])

  @@index([companyId, status, createdAt])
  @@index([companyId, documentId])
}

/// Chasing money that is late.
///
/// A promise to pay is the thing worth recording: "they said Friday" is what
/// turns a chase list into a plan, and a broken promise is a stronger signal
/// than another day of silence.
model CrmCollectionNote {
  id             String               @id @default(uuid())
  companyId      String
  documentId     String
  invoiceId      String?
  clientId       String?
  outcome        CrmCollectionOutcome
  /// When they said they would pay.
  promisedAt     DateTime?
  promisedAmount Float?
  notes          String?
  createdById    String?
  createdAt      DateTime             @default(now())

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document  CrmLeadDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  client    CrmClient?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("CrmCollectionNoteCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, documentId, createdAt])
  @@index([companyId, promisedAt])
}

/// ============================================
/// SHARED CATALOGUE — owned by Stock & Inventory
/// ============================================
///
/// One catalogue for every module. Retail sells it over a counter, the CRM
/// quotes it, a workshop puts it on a job card. Before this, each module was
/// growing its own list of "things we sell", which meant the same pump had a
/// different price depending on which screen you opened.
///
/// `Product` is the item master: what a thing *is*, company-wide.
/// `InventoryItem` stays what it always was: how much of it is at one site.
/// That separation is deliberate — a service has a Product and no stock at all,
/// and a stocked product has one Product and one InventoryItem per site.
model Product {
  id                 String        @id @default(uuid())
  companyId          String
  /// Code or SKU. Unique per company so imports and scanners agree.
  code               String
  name               String
  description        String?
  kind               ProductKind   @default(GOODS)
  category           String?
  unit               UnitOfMeasure @default(EACH)
  /// Free text when `unit` is OTHER, e.g. "per pallet".
  unitLabel          String?
  /// The fallback price, used when no price list has an entry for this item.
  ///
  /// S-1 — `Decimal`, not `Float`. Retail resolves its shelf price out of this
  /// model from S-3 onward, and routing numbers R-1.1 made exact back through a
  /// double would undo R-1.1 by the back door.
  standardPrice      Decimal       @default(0) @db.Decimal(14, 2)
  /// The "was" price, shown struck through beside the shelf price.
  ///
  /// S-4b — a merchandising attribute of the retail profile, alongside `barcode`
  /// and `ageRestricted`. It lived on `RetailCatalogItem.compareAtPrice`, and the
  /// pricing screen edits it in the same row as the sell price; when the item
  /// master moved to `Product` it had to come with it or the column would have
  /// been deleted rather than migrated. Not on `ProductPrice`: a tenant runs one
  /// shelf list, and a per-list was-price is generality nothing has asked for.
  compareAtPrice     Decimal?      @db.Decimal(14, 2)
  costPrice          Decimal?      @db.Decimal(14, 2)
  /// A percentage, not money — hence the narrower scale.
  defaultTaxRate     Decimal       @default(0) @db.Decimal(5, 2)
  currency           String        @default("USD")
  /// The most a seller may discount without approval. Null means no ceiling.
  maxDiscountPercent Decimal?      @db.Decimal(5, 2)
  /// Scanned at the till.
  ///
  /// S-1 added it here so `Product` could become the one item master in S-4;
  /// S-4 dropped the listing table it used to live on. Indexed and deliberately
  /// *not* unique per company: the range it was backfilled from held distinct
  /// SKUs sharing a barcode inside one company and one site, and a shop that
  /// prices two sizes off one manufacturer's code is doing something ordinary.
  barcode            String?
  /// A liquor licence is not optional, and a bottle store's range is mostly
  /// things it applies to. The counter has to be told to check.
  ageRestricted      Boolean       @default(false)
  /// A Chibuku scud comes back and the empty is worth money. Ordinary Zimbabwean
  /// bottle-store trade, modelled nowhere in this repo before now.
  returnable         Boolean       @default(false)
  depositAmount      Decimal?      @db.Decimal(14, 2)
  imageUrl           String?
  notes              String?
  isActive           Boolean       @default(true)
  archivedAt         DateTime?
  /// Free-form per-module extras, so a module can carry a field the others
  /// don't need without a migration that touches everyone.
  attributes         Json?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User?               @relation("ProductCreatedBy", fields: [createdById], references: [id])
  prices         ProductPrice[]
  inventoryItems InventoryItem[]
  retailSaleLines RetailSaleLine[]

  @@unique([companyId, code])
  @@index([companyId, isActive, kind])
  @@index([companyId, category])
  /// The till scans on this and expects an answer before the next item.
  @@index([companyId, barcode])
}

/// A named price list — Standard, Wholesale, Trade, VIP, or a region's own.
/// Kept deliberately simple per the spec: a list holds a price per product,
/// optionally from a minimum quantity. No formulas, no rule engine.
model PriceList {
  id        String        @id @default(uuid())
  companyId String
  name      String
  kind      PriceListKind @default(STANDARD)
  /// Used when a customer or module asks for no list in particular.
  isDefault Boolean       @default(false)
  /// Region-specific lists say which region they serve.
  region    String?
  currency  String        @default("USD")
  /// S-1 — how `ProductPrice.unitPrice` on this list is meant to be read.
  ///
  /// A Zimbabwean shelf price is what the customer pays: VAT at 15% is already
  /// inside it, and adding 15% again at the till prints a number nobody at the
  /// counter recognises. The till derives the ex-VAT line and the VAT from the
  /// shelf figure instead. False by default, so every list that existed this
  /// morning still means exactly what it meant.
  taxInclusive Boolean    @default(false)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries ProductPrice[]

  @@unique([companyId, name])
  @@index([companyId, isActive, kind])
}

/// One product's price on one list. `minQuantity` gives simple volume breaks;
/// the row with the highest minimum at or below the quantity ordered wins.
model ProductPrice {
  id          String   @id @default(uuid())
  companyId   String
  priceListId String
  productId   String
  /// S-1 — `Decimal` at the quantity scale, so a volume break can start at a
  /// fraction the cent scale would flatten.
  minQuantity Decimal  @default(1) @db.Decimal(12, 4)
  /// S-1 — what a price list actually says a thing costs. Money, so `Decimal`.
  unitPrice   Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, minQuantity])
  @@index([companyId, productId])
}

enum ProductKind {
  GOODS
  SERVICE
  LABOUR
  MATERIAL
  BUNDLE
}

/// The units the spec calls for, plus an escape hatch.
enum UnitOfMeasure {
  EACH
  METRE
  SQUARE_METRE
  HOUR
  DAY
  PACKAGE
  INSTALLATION
  LITRE
  KILOGRAM
  OTHER
}

enum PriceListKind {
  STANDARD
  WHOLESALE
  TRADE
  VIP
  REGIONAL
  /// S-1 — the shelf price a customer at the counter is charged. Distinct from
  /// the trade lists above so the till can ask for it by name rather than guess
  /// which one was meant.
  RETAIL
}

enum CrmApprovalDecision {
  PENDING
  APPROVED
  DECLINED
}

enum CrmCollectionOutcome {
  PROMISED_TO_PAY
  DISPUTED
  NO_ANSWER
  PARTIAL_PAYMENT
  PAID
  ESCALATED
}

/// The job that follows a won deal: go to the site and do the work.
///
/// Deliberately not the maintenance `WorkOrder`, which is shaped around an
/// equipment breakdown — it requires an equipmentId, tracks downtime windows
/// and assigns an Employee technician. None of that describes installing what
/// a customer just bought at their own address.
model CrmWorkOrder {
  id          String             @id @default(uuid())
  companyId   String
  workOrderNo String
  title       String
  description String?
  status      CrmWorkOrderStatus @default(DRAFT)
  priority    CrmTaskPriority    @default(NORMAL)

  dealId     String?
  clientId   String?
  siteId     String?
  /// The quote whose lines became this job's checklist.
  documentId String?

  scheduledStart DateTime?
  scheduledEnd   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  /// Whoever is answerable for the job. The rest of the crew are users too,
  /// held as ids because a crew is assembled per job, not a standing team.
  assignedToId String?
  crewIds      String[] @default([])

  /// Client sign-off (/s/<token>). A job is not finished because the crew
  /// says so; it is finished when the person paying agrees it is. Null until
  /// somebody asks for the sign-off.
  signOffToken   String?   @unique
  signOffAskedAt DateTime?
  signOffAt      DateTime?
  /// Typed by the client on their own phone — the name IS the signature.
  signOffName    String?
  /// 1–5, optional. A job can be signed off without being rated.
  signOffRating  Int?
  signOffNotes   String?

  addressLine  String?
  accessNotes  String?
  contactName  String?
  contactPhone String?

  /// Signed off on site. A job with no signature is a job the customer can
  /// still say never happened.
  signedByName    String?
  signatureUrl    String?
  signedAt        DateTime?
  /// Out of five, asked at the door while the work is fresh.
  customerRating  Int?
  completionNotes String?
  /// Before-and-after photographs, same shape as a site visit's.
  photos          Json?
  /// Why it stalled, when it did.
  blockedReason   String?

  customFields Json?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal       CrmDeal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  client     CrmClient?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  site       CrmSite?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  document   CrmLeadDocument?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  assignedTo User?              @relation("CrmWorkOrderAssignedTo", fields: [assignedToId], references: [id])
  createdBy  User?              @relation("CrmWorkOrderCreatedBy", fields: [createdById], references: [id])
  items      CrmWorkOrderItem[]

  @@unique([companyId, workOrderNo])
  @@index([companyId, status, scheduledStart])
  @@index([companyId, assignedToId, status])
  @@index([companyId, dealId])
}

/// One thing to do or install, usually lifted from the quote that was won.
model CrmWorkOrderItem {
  id                String   @id @default(uuid())
  companyId         String
  workOrderId       String
  position          Int      @default(0)
  description       String
  quantity          Float    @default(1)
  /// How much of it is actually done, so a part-finished job is visible as
  /// part-finished rather than as either done or not started.
  completedQuantity Float    @default(0)
  unit              String?
  /// The shared catalogue item this line installs, when it came from one.
  productId         String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder CrmWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([companyId, workOrderId, position])
}

enum CrmWorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}
