  NEGOTIATION
  WON
  LOST
  CANCELED
}

enum CarSalesVehicleStatus {
  IN_STOCK
  RESERVED
  SOLD
  DELIVERED
}

enum CarSalesDealStatus {
  DRAFT
  QUOTED
  RESERVED
  CONTRACTED
  DELIVERY_READY
  DELIVERED
  CANCELED
  VOIDED
}

enum CarSalesPaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
}

enum CarSalesPaymentStatus {
  POSTED
  VOIDED
  REFUNDED
