model CarSalesLead {
  id              String             @id @default(uuid())
  companyId       String
  leadNo          String
  customerName    String
  phone           String
  email           String?
  source          String             @default("WALK_IN")
  vehicleInterest String?
  budgetMin       Float?
  budgetMax       Float?
  status          CarSalesLeadStatus @default(NEW)
  assignedToId    String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo User?          @relation("CarSalesLeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  deals      CarSalesDeal[]

  @@unique([companyId, leadNo])
  @@index([companyId, status, createdAt])
  @@index([companyId, assignedToId])
}

model CarSalesVehicle {
  id               String                @id @default(uuid())
  companyId        String
  stockNo          String
  vin              String
  make             String
  model            String
  year             Int
  color            String?
  mileageKm        Int?
  acquisitionDate  DateTime?
  acquisitionCost  Float                 @default(0)
  listingPrice     Float
  minApprovalPrice Float
  currency         String                @default("USD")
  status           CarSalesVehicleStatus @default(IN_STOCK)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals   CarSalesDeal[]

  @@unique([companyId, stockNo])
  @@unique([companyId, vin])
  @@index([companyId, status, updatedAt])
}

model CarSalesDeal {
  id             String             @id @default(uuid())
  companyId      String
  dealNo         String
  leadId         String?
  vehicleId      String
  customerName   String
  customerPhone  String
  salespersonId  String
  status         CarSalesDealStatus @default(DRAFT)
  quoteAmount    Float
  discountAmount Float              @default(0)
  taxAmount      Float              @default(0)
  netAmount      Float
  paidAmount     Float              @default(0)
  balanceAmount  Float
  reservedUntil  DateTime?
  contractedAt   DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead        CarSalesLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  vehicle     CarSalesVehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  salesperson User              @relation("CarSalesDealSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict)
  payments    CarSalesPayment[]

  @@unique([companyId, dealNo])
  @@index([companyId, status, updatedAt])
  @@index([companyId, vehicleId, status])
}

model CarSalesPayment {
  id            String                @id @default(uuid())
  companyId     String
  paymentNo     String
  dealId        String
  paymentDate   DateTime
  paymentMethod CarSalesPaymentMethod
  status        CarSalesPaymentStatus @default(POSTED)
  amount        Float
  reference     String?
  notes         String?
  receivedById  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal       CarSalesDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  receivedBy User?        @relation("CarSalesPaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@unique([companyId, paymentNo])
  @@index([companyId, paymentDate])
  @@index([companyId, dealId, status])
}

