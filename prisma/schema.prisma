  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

/// What an employee was paid against a payroll run.
///
/// `amount` is money, at money's scale. It used to be `Float` and polymorphic —
/// read in whatever `unit` said, which on a gold payout was **grams** — with
/// five more columns bolted on to carry the USD value and the weight separately.
/// Settlements own that shape now: `SettlementPayment.quantity` is the weight
/// and its `amount` is the money, so neither needs a comment explaining that it
/// means something else on Tuesdays.
///
/// There is no `type` either. Every row here is a salary payment; a settlement
/// is a `SettlementPayment`.
model EmployeePayment {
  id                  String        @id @default(uuid())
  employeeId          String
  periodStart         DateTime
  periodEnd           DateTime
  dueDate             DateTime
  amount              Decimal       @db.Decimal(14, 2)
  /// The currency `amount` is in.
  unit                String
  paidAmount          Decimal?      @db.Decimal(14, 2)
  paidAt              DateTime?
  status              PaymentStatus @default(DUE)
  notes               String?
  payrollRunId        String?
  payrollLineItemId   String?
  disbursementBatchId String?
  disbursementItemId  String?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  employee          Employee           @relation(fields: [employeeId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])
  payrollRun        PayrollRun?        @relation(fields: [payrollRunId], references: [id])
  payrollLineItem   PayrollLineItem?   @relation(fields: [payrollLineItemId], references: [id])
  disbursementBatch DisbursementBatch? @relation(fields: [disbursementBatchId], references: [id])
  disbursementItem  DisbursementItem?  @relation(fields: [disbursementItemId], references: [id])

  @@index([employeeId, dueDate])
  @@index([payrollRunId])
  @@index([payrollLineItemId])
  @@index([disbursementBatchId])
  @@index([disbursementItemId])
}

