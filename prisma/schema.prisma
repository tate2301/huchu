// ─────────────────────────────────────────────────────────────────────────────
// Zimbabwe statutory payroll tables
//
// Every one of these is effective-dated, and that is the whole point. PAYE bands
// change with each budget, the NSSA insurable-earnings ceiling is revised
// separately, and a ZWG table is revised more often than a USD one. Hard-coding
// any of it means a rate change needs a deploy, and — worse — means last
// month's payroll silently recomputes on this month's numbers the next time
// anybody opens it.
//
// So: a rate is looked up for the pay period, and when no row covers that period
// the run REFUSES rather than reaching for the nearest one. A stale table
// produces a plausible wrong number, which is the only kind of wrong number
// that reaches a payslip.
//
// The seeded pack is a STARTING SET, labelled with its date. Verify against
// ZIMRA and NSSA before relying on it.
// ─────────────────────────────────────────────────────────────────────────────

/// A PAYE band table for one currency, valid over one window.
///
/// One table per currency, per the dual-currency rule: USD earnings are taxed
/// on the USD table and ZWG earnings on the ZWG table. They are not converted
/// and pooled — ZIMRA publishes them separately because they are separate.
model PayeTable {
  id            String       @id @default(uuid())
  companyId     String
  currency      String
  cycle         PayrollCycle @default(MONTHLY)
  /// What ZIMRA calls it, e.g. "Aug 2026 monthly USD".
  label         String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  /// Free-form provenance — the circular or gazette this came from. Present so
  /// an operator correcting a rate can say where the new one came from.
  source        String?
  /// True on rows the seeded pack wrote. A company that has entered its own
  /// table should not have it quietly replaced on the next provision.
  isSeeded      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bands   PayeBand[]

  @@unique([companyId, currency, cycle, effectiveFrom])
  @@index([companyId, currency, cycle, effectiveFrom])
}

/// One band of a PAYE table.
///
/// Stored in ZIMRA's own subtract-method form — `taxableGross × ratePercent −
/// deductAmount` — rather than as a cumulative marginal calculation. That is
/// how the published tables read, so an accountant can check a payslip against
/// the circular line by line without re-deriving anything, and a transcription
/// error is visible rather than buried in arithmetic.
model PayeBand {
  id          String   @id @default(uuid())
  tableId     String
  /// Inclusive.
  lowerBound  Decimal  @db.Decimal(14, 2)
  /// Inclusive. Null on the top band, which has no ceiling.
  upperBound  Decimal? @db.Decimal(14, 2)
  ratePercent Decimal  @db.Decimal(5, 2)
  /// The published subtraction for this band. Zero on the first band.
  deductAmount Decimal @default(0) @db.Decimal(14, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  table PayeTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, lowerBound])
  @@index([tableId, sortOrder])
}

/// A single named statutory rate, effective-dated.
///
/// One model rather than a column per levy, because the list grows: NSSA, the
/// AIDS levy, ZIMDEF, the Standards Development Levy and APWCS all reduce to
/// "a percentage of something, sometimes capped, sometimes floored". A new levy
/// is a new `key`, not a migration.
model StatutoryRate {
  id            String            @id @default(uuid())
  companyId     String
  key           StatutoryRateKey
  /// Null means "applies to every currency" — the AIDS levy is 3% of PAYE
  /// whichever currency the PAYE was struck in. A currency-specific row (the
  /// NSSA ceiling) names its currency.
  currency      String?
  ratePercent   Decimal           @db.Decimal(7, 4)
  /// The insurable-earnings ceiling for NSSA: contributions are charged on
  /// earnings up to this and not beyond. Null where the levy is uncapped.
  ceilingAmount Decimal?          @db.Decimal(14, 2)
  /// A floor, where one exists.
  floorAmount   Decimal?          @db.Decimal(14, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String?
  isSeeded      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, currency, effectiveFrom])
  @@index([companyId, key, effectiveFrom])
}

/// A credit that reduces PAYE after it has been computed.
///
/// Not a deduction from gross — these come off the tax, which is why they are
/// their own model and are applied at their own stage. Medical aid is the one
/// that is a proportion of something the employee paid; the elderly and
/// disability credits are flat monthly amounts.
model TaxCredit {
  id            String        @id @default(uuid())
  companyId     String
  key           TaxCreditKey
  currency      String
  /// A flat monthly amount, for the elderly and disability credits.
  amount        Decimal?      @db.Decimal(14, 2)
  /// A proportion of a contribution the employee made — 50% for medical aid.
  ratePercent   Decimal?      @db.Decimal(7, 4)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String?
  isSeeded      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, currency, effectiveFrom])
  @@index([companyId, key, effectiveFrom])
}

/// An NEC agreement — the industry council dues an employer and employee owe.
///
/// Not seeded, and cannot be: dues are set per National Employment Council and
/// there are dozens. A company enters the one for its industry, or has none.
model NecAgreement {
  id                    String    @id @default(uuid())
  companyId             String
  /// The council, e.g. "NEC for the Commercial Sectors of Zimbabwe".
  councilName           String
  currency              String    @default("USD")
  employeeRatePercent   Decimal?  @db.Decimal(7, 4)
  employeeFixedAmount   Decimal?  @db.Decimal(14, 2)
  employerRatePercent   Decimal?  @db.Decimal(7, 4)
  employerFixedAmount   Decimal?  @db.Decimal(14, 2)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  source                String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive, effectiveFrom])
}

// ============================================
// LEAVE
// ============================================
//
// Time off, and what is left of it.
//
// The module had no model for any of this — no type, no entitlement, no request,
// no public holiday. A Zimbabwean employer is required by the Labour Act to give
// 22 days' annual leave and 12 days' sick, and the product could not record
// either, which meant it also could not tell payroll that a month contained
// unpaid leave.
//
// One rule shapes the whole design: **a balance is derived, never stored.**
// `LeaveEntitlement` holds what was granted and carried over; what has been taken
// is the sum of approved requests. Keeping a running `remaining` column means two
// numbers that disagree the first time a request is edited, and the one on screen
// is the one nobody recomputed.

enum LeaveUnit {
  DAY
  HALF_DAY
  HOUR
}

enum LeaveAccrualMethod {
  /// The whole entitlement on day one of the leave year.
  ANNUAL_GRANT
  /// A twelfth each month worked. What the Labour Act actually describes.
  MONTHLY_ACCRUAL
  /// The whole entitlement on each employment anniversary.
  ANNIVERSARY_GRANT
  /// Tracked but not limited — compassionate leave at some employers.
  UNLIMITED
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  /// Withdrawn by the employee after approval, so the days go back.
  WITHDRAWN
}

model LeaveType {
  id                       String             @id @default(uuid())
  companyId                String
  code                     String
  name                     String
  unit                     LeaveUnit          @default(DAY)
  accrualMethod            LeaveAccrualMethod @default(ANNUAL_GRANT)
  defaultEntitlement       Decimal            @default(0) @db.Decimal(6, 2)
  isPaid                   Boolean            @default(true)
  /// Sick leave needs a doctor's note from day 3. Null means never.
  requiresDocumentAfterDays Int?
  carryOverLimit           Decimal?           @db.Decimal(6, 2)
  /// `MM-DD`. Unused days expire on this date, not on a rolling anniversary —
  /// which is how the policy is actually written and displayed.
  carryOverExpiresOn       String?
  /// Shown verbatim on the balance card. The staff portal displays the rule next
  /// to the number, so the rule lives with the type rather than in the UI.
  policyNote               String?
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  source                   String?
  isSeeded                 Boolean            @default(false)
  isActive                 Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entitlements LeaveEntitlement[]
  requests     LeaveRequest[]

  @@unique([companyId, code, effectiveFrom])
  @@index([companyId, isActive, effectiveFrom])
}

/// What one employee was granted for one leave year.
///
/// `taken` and `pending` are deliberately absent: both are sums over
/// `LeaveRequest` and storing them invites the two to drift.
model LeaveEntitlement {
  id          String   @id @default(uuid())
  companyId   String
  employeeId  String
  leaveTypeId String
  /// The leave year, as a calendar year. Anniversary-granted types still record
  /// the year the grant falls in so a balance can be asked for by year.
  year        Int
  granted     Decimal  @default(0) @db.Decimal(6, 2)
  carriedOver Decimal  @default(0) @db.Decimal(6, 2)
  /// A manual correction, signed. Separate from `granted` so an adjustment is
  /// visible as an adjustment rather than folded into the entitlement.
  adjustment  Decimal  @default(0) @db.Decimal(6, 2)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([companyId, year])
}

model LeaveRequest {
  id           String             @id @default(uuid())
  companyId    String
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  /// Working days, computed at submission against the work week and the public
  /// holiday calendar, then frozen. Recomputing it later would restate a taken
  /// balance when somebody adds a holiday.
  workingDays  Decimal            @db.Decimal(6, 2)
  /// Which half, when a HALF_DAY type is taken for part of a day.
  isHalfDay    Boolean            @default(false)
  reason       String
  attachmentUrl String?
  /// Who covers the work. Nullable — not every role needs cover.
  coveringEmployeeId String?
  status       LeaveRequestStatus @default(DRAFT)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdById  String
  submittedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee         Employee  @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType        LeaveType @relation(fields: [leaveTypeId], references: [id])
  coveringEmployee Employee? @relation("LeaveRequestCover", fields: [coveringEmployeeId], references: [id])
  createdBy        User      @relation("LeaveRequestCreatedBy", fields: [createdById], references: [id])
  decidedBy        User?     @relation("LeaveRequestDecidedBy", fields: [decidedById], references: [id])

  @@index([companyId, employeeId, startDate])
  @@index([companyId, status, startDate])
}

/// A day nobody is expected to work.
///
/// `siteId` is nullable so a company-wide holiday is one row rather than one per
/// site, and a site-specific one — a local shutdown — is still expressible.
model PublicHoliday {
  id                String   @id @default(uuid())
  companyId         String
  date              DateTime
  name              String
  isPaid            Boolean  @default(true)
  /// The demo's "double pay if you work" case. Payroll reads this, not the UI.
  doublePayIfWorked Boolean  @default(false)
  siteId            String?
  isSeeded          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site?   @relation(fields: [siteId], references: [id])

  @@unique([companyId, date, siteId])
  @@index([companyId, date])
}

// ============================================
// COMMODITY & VARIABLE SETTLEMENTS
// ============================================
//
// Paying somebody for a quantity of something — grams of gold from a shift
// allocation, a scrap balance, a sales commission — rather than for a period of
// employment.
//
// This is a separate domain from payroll, and it has its own tables for a
// specific reason. Settlement used to run *through* payroll: a `PayrollRun` with
// `domain = GOLD_PAYOUT`, four gold columns bolted onto that run, and
// `PayrollLineItem.baseAmount` widened to `Decimal(14,4)` so it could carry a
// weight in grams while every other row in the table held money. A payroll
// module cannot be sold on its own while its core tables carry a mining
// discriminator, and a money column that sometimes holds grams is a rounding bug
// waiting for someone to treat it as money.
//
// So quantity is `quantity`, money is `amount`, and neither pretends to be the
// other.

enum SettlementSource {
  GOLD
  SCRAP
  COMMISSION
  OTHER
}

enum SettlementMode {
  /// Settle what the period itself produced.
  CURRENT_PERIOD
  /// Settle what falls due in the period, which may have been produced earlier.
  NEXT_PERIOD
}

/// What is owed, before anyone decides to pay it.
///
/// Gold does not use this — its source of truth is `GoldShiftAllocation`, which
/// the gold module already approves through its own workflow, and duplicating
/// those rows here would give two answers to "what does this worker have coming".
/// Scrap, commission and everything else have no such record, so an operator
/// enters one.
model SettlementIntake {
  id             String           @id @default(uuid())
  companyId      String
  source         SettlementSource
  label          String
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  currency       String           @default("USD")
  workflowStatus WorkflowStatus   @default(DRAFT)
  notes          String?
  createdById    String
  submittedById  String?
  approvedById   String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("SettlementIntakeCreatedBy", fields: [createdById], references: [id])
  submittedBy User?                  @relation("SettlementIntakeSubmittedBy", fields: [submittedById], references: [id])
  approvedBy  User?                  @relation("SettlementIntakeApprovedBy", fields: [approvedById], references: [id])
  items       SettlementIntakeItem[]
  settledInto SettlementLineOrigin[]

  @@index([companyId, source, workflowStatus, dueDate])
}

model SettlementIntakeItem {
  id         String   @id @default(uuid())
  intakeId   String
  employeeId String
  /// How much of the thing. Grams, kilos, units — whatever `unit` says.
  quantity   Decimal  @default(0) @db.Decimal(12, 4)
  unit       String   @default("unit")
  /// What it is worth. Money, always, at money's scale.
  amount     Decimal  @db.Decimal(14, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  intake   SettlementIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id])

  @@unique([intakeId, employeeId])
  @@index([employeeId])
}

/// One settlement, computed and frozen.
///
/// The payroll analogue is `PayrollRun`, and the workflow is the same shape —
/// draft, submit, approve — so the two read alike on screen. What it is not is a
/// `PayrollRun` with a flag.
model SettlementRun {
  id                   String           @id @default(uuid())
  companyId            String
  code                 String
  source               SettlementSource
  periodStart          DateTime
  periodEnd            DateTime
  dueDate              DateTime
  mode                 SettlementMode   @default(CURRENT_PERIOD)
  currency             String           @default("USD")
  /// Money per unit of quantity, weighted across the run. Four places because a
  /// gold price per gram is not a price in cents.
  ratePerUnit          Decimal?         @db.Decimal(14, 4)
  rateUnit             String           @default("unit")
  totalQuantity        Decimal          @default(0) @db.Decimal(14, 4)
  totalAmount          Decimal          @default(0) @db.Decimal(14, 2)
  status               PayrollRunStatus @default(DRAFT)
  journalEntryId       String?
  postingSkippedReason String?
  notes                String?
  createdById          String
  submittedById        String?
  approvedById         String?
  submittedAt          DateTime?
  approvedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("SettlementRunCreatedBy", fields: [createdById], references: [id])
  submittedBy User?              @relation("SettlementRunSubmittedBy", fields: [submittedById], references: [id])
  approvedBy  User?              @relation("SettlementRunApprovedBy", fields: [approvedById], references: [id])
  lines       SettlementLine[]
  batches     SettlementBatch[]
  payments    SettlementPayment[]

  @@unique([companyId, source, code])
  @@index([companyId, source, status, periodStart])
}

model SettlementLine {
  id         String  @id @default(uuid())
  runId      String
  employeeId String
  /// The quantity being settled. This is the column that used to be
  /// `PayrollLineItem.baseAmount` on a gold run.
  quantity   Decimal @default(0) @db.Decimal(12, 4)
  unit       String  @default("unit")
  unitRate   Decimal @default(0) @db.Decimal(14, 4)
  grossAmount Decimal @db.Decimal(14, 2)
  netAmount   Decimal @db.Decimal(14, 2)
  currency    String  @default("USD")
  /// Frozen at compute time, so a later rate change cannot restate a settled run.
  exchangeRate Decimal @default(1) @db.Decimal(12, 4)
  baseAmount   Decimal @default(0) @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  run      SettlementRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee              @relation(fields: [employeeId], references: [id])
  items    SettlementBatchItem[]
  payments SettlementPayment[]
  origins  SettlementLineOrigin[]

  @@unique([runId, employeeId])
  @@index([employeeId])
}

/// Which upstream records a line settled.
///
/// A line aggregates: one gold worker can have shares from six shifts in a
/// month, and they settle as one payment. Without this, "has allocation X been
/// settled?" had no answer — the code that needed it wrote
/// `AUTO_PAYOUT_FROM_SHIFT_ALLOCATION:<uuid>` into a free-text `notes` column and
/// parsed the UUID back out with a regex, which loses the link the moment anyone
/// edits the note.
model SettlementLineOrigin {
  id                    String  @id @default(uuid())
  lineId                String
  goldShiftAllocationId String?
  settlementIntakeId    String?
  /// The share of the line this origin contributed, so a partially settled
  /// upstream record can be reconciled.
  quantity              Decimal @default(0) @db.Decimal(12, 4)
  amount                Decimal @default(0) @db.Decimal(14, 2)

  line                SettlementLine       @relation(fields: [lineId], references: [id], onDelete: Cascade)
  goldShiftAllocation GoldShiftAllocation? @relation(fields: [goldShiftAllocationId], references: [id])
  settlementIntake    SettlementIntake?    @relation(fields: [settlementIntakeId], references: [id])

  @@unique([lineId, goldShiftAllocationId])
  @@unique([lineId, settlementIntakeId])
  @@index([goldShiftAllocationId])
  @@index([settlementIntakeId])
}

/// Handing the money over.
///
/// `settlementRunId` is required, which is the mirror image of
/// `DisbursementBatch.payrollRunId` being required — and the reason a gold payout
/// had to fabricate a `PayrollRun` before this model existed.
model SettlementBatch {
  id              String                    @id @default(uuid())
  companyId       String
  settlementRunId String
  code            String
  method          PayoutMethod              @default(CASH)
  cashCustodian   String?
  cashIssuedAt    DateTime?
  status          DisbursementBatchStatus   @default(DRAFT)
  totalAmount     Decimal                   @default(0) @db.Decimal(14, 2)
  currency        String                    @default("USD")
  itemCount       Int                       @default(0)
  notes           String?
  createdById     String
  submittedById   String?
  approvedById    String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run         SettlementRun         @relation(fields: [settlementRunId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("SettlementBatchCreatedBy", fields: [createdById], references: [id])
  submittedBy User?                 @relation("SettlementBatchSubmittedBy", fields: [submittedById], references: [id])
  approvedBy  User?                 @relation("SettlementBatchApprovedBy", fields: [approvedById], references: [id])
  items       SettlementBatchItem[]
  payments    SettlementPayment[]

  @@unique([companyId, code])
  @@index([companyId, status, createdAt])
  @@index([settlementRunId])
}

model SettlementBatchItem {
  id         String                  @id @default(uuid())
  batchId    String
  lineId     String
  employeeId String
  amount     Decimal                 @db.Decimal(14, 2)
  paidAmount Decimal?                @db.Decimal(14, 2)
  currency   String                  @default("USD")
  status     String                  @default("DUE")
  paidAt     DateTime?
  receiptReference String?
  notes      String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  batch    SettlementBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  line     SettlementLine      @relation(fields: [lineId], references: [id])
  employee Employee            @relation(fields: [employeeId], references: [id])
  payments SettlementPayment[]

  @@unique([batchId, employeeId])
  @@index([lineId])
  @@index([employeeId])
}

/// What an employee was actually paid, per settlement.
///
/// Replaces the gold half of `EmployeePayment`, which carried `amount Float` read
/// in whatever `unit` said — grams on a gold payout — plus five gold-specific
/// columns. Here `quantity` is the weight and `amount` is the money, so neither
/// needs a comment explaining that it means something else on Tuesdays.
model SettlementPayment {
  id                    String           @id @default(uuid())
  companyId             String
  employeeId            String
  source                SettlementSource
  settlementRunId       String?
  lineId                String?
  batchId               String?
  batchItemId           String?
  quantity              Decimal          @default(0) @db.Decimal(12, 4)
  unit                  String           @default("unit")
  valuationDate         DateTime?
  unitPrice             Decimal?         @db.Decimal(14, 4)
  amount                Decimal          @db.Decimal(14, 2)
  paidAmount            Decimal?         @db.Decimal(14, 2)
  currency              String           @default("USD")
  periodStart           DateTime
  periodEnd             DateTime
  dueDate               DateTime
  paidAt                DateTime?
  status                String           @default("DUE")
  notes                 String?
  createdById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee            Employee             @relation(fields: [employeeId], references: [id])
  run                 SettlementRun?       @relation(fields: [settlementRunId], references: [id])
  line                SettlementLine?      @relation(fields: [lineId], references: [id])
  batch               SettlementBatch?     @relation(fields: [batchId], references: [id])
  batchItem           SettlementBatchItem? @relation(fields: [batchItemId], references: [id])
  createdBy           User?                @relation("SettlementPaymentCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, employeeId, source, status])
  @@index([settlementRunId])
}

