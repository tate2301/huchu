# -----------------------------------------------------------------------------
# Huchu environment template
# Copy this file to `.env` and replace placeholder values.
# Never commit real credentials or tokens.
# -----------------------------------------------------------------------------

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/huchu_mines?schema=public"

# Optional local DB convenience variable (used by some local workflows)
DATABASE_URL_LOCAL="postgresql://user:password@localhost:5432/huchu_mines"

# NextAuth
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Multitenancy host enforcement
# Leave PLATFORM_ROOT_DOMAIN empty for local development and most preview envs.
# Set both values in production to enforce tenant subdomain login:
# PLATFORM_ROOT_DOMAIN="apps.pagka.dev"
# PLATFORM_ROOT_HOSTS="apps.pagka.dev"
# -----------------------------------------------------------------------------
PLATFORM_ROOT_DOMAIN=""
PLATFORM_ROOT_HOSTS="localhost:3000"

# -----------------------------------------------------------------------------
# Preview / staging host override
# A preview deployment answers on a generated hostname that belongs to no
# tenant, so with PLATFORM_ROOT_DOMAIN set it cannot sign anybody in. These let
# a preview be told which host to behave as, instead of unsetting the root
# domain and taking tenant routing out of the build being tested. Both are
# refused outright when VERCEL_ENV is "production" — set them on the Preview
# environment only. See docs/_start-here/STAGING_PREVIEW.md.
# -----------------------------------------------------------------------------
PREVIEW_HOST_OVERRIDE=
PREVIEW_BYPASS_HOST_ENFORCEMENT=
# Optional comma-separated host suffixes the override may name. Unset = any.
PREVIEW_HOST_ALLOWLIST=

# -----------------------------------------------------------------------------
# Admin Portal Domain
# Default is "admin.pagka.dev" which allows access via *.admin.pagka.dev
# Set this to your admin domain in production for wildcard admin access
# ADMIN_ROOT_DOMAIN="admin.pagka.dev"
# -----------------------------------------------------------------------------
ADMIN_ROOT_DOMAIN=""

# Vercel Blob (required only if uploads are enabled)
BLOB_READ_WRITE_TOKEN=""

# Inline processing controls for document queue dispatch (Next.js route handlers)
PDF_INLINE_BATCH_LIMIT="5"

# Optional Postgres/Prisma tuning knobs
# PG_POOL_MAX="10"
# PG_POOL_IDLE_MS="10000"
# PG_POOL_CONN_MS="5000"
# PRISMA_TX_MAX_WAIT_MS="10000"
# PRISMA_TX_TIMEOUT_MS="60000"
# PRISMA_PROVISION_TX_MAX_WAIT_MS="20000"
# PRISMA_PROVISION_TX_TIMEOUT_MS="180000"
# PRISMA_PROVISION_TX_RETRIES="2"

# Optional local DNS / strict tenant-host testing.
# Uncomment these only when you have matching hosts-file entries.
# NEXTAUTH_URL="http://apps.pagka.local:3000"
# PLATFORM_ROOT_DOMAIN="apps.pagka.local"
# PLATFORM_ROOT_HOSTS="apps.pagka.local,apps.pagka.local:3000"
# ADMIN_ROOT_DOMAIN="admin.pagka.local"

# Feature-gate policy and break-glass controls.
#
# `deny` refuses a route the tenant is not entitled to; `allow` lets it through.
# This mattered more than it looks: while the default was allow, every gate in
# the platform was decorative unless this variable was set, which is not a state
# you want to discover by letting a stranger sign up (SS-1.1).
#
# Set this explicitly per environment rather than relying on the default, and
# run `pnpm platform:audit-feature-gates` before changing it — an unmapped route
# is not a gated surface and stays reachable, but a route mapped to a feature no
# bundle grants will start refusing the moment this is `deny`.
FEATURE_GATE_POLICY="deny"
NEXT_PUBLIC_FEATURE_GATE_POLICY="deny"
# Break-glass. Leave empty. `FEATURE_GATES_BYPASS=1` disables gating entirely;
# `FEATURE_GATES_BYPASS_KEYS` bypasses only the named keys. Both exist for an
# incident, not for a workaround — anything relying on them is a missing bundle.
FEATURE_GATES_BYPASS=""
FEATURE_GATES_BYPASS_KEYS=""

# Optional platform domain provisioning controls.
PLATFORM_VERCEL_PROJECT_ID=""
PLATFORM_VERCEL_TEAM_ID=""
PLATFORM_VERCEL_TOKEN=""

# Optional PDF worker controls.
PDF_WORKER_INTERVAL_MS="5000"
PDF_WORKER_IDLE_MS="3000"

# Optional fiscal worker controls. Drains FiscalReceipt rows whose nextRetryAt
# is due, so a load-shedding outage recovers without anyone hitting the replay
# endpoint by hand. Run with `pnpm worker:fiscal`.
FISCAL_WORKER_INTERVAL_MS="15000"
FISCAL_WORKER_BATCH_SIZE="25"

# ---------------------------------------------------------------------------
# Marketing site
# ---------------------------------------------------------------------------
# Absolute origin of the public marketing site. Used for canonical URLs, the
# sitemap, and social cards. Falls back to https://corelith.co.zw when unset.
NEXT_PUBLIC_MARKETING_SITE_URL="https://corelith.co.zw"

# Optional external scheduler (Calendly etc). When unset, the "book a demo"
# CTA falls back to the on-site form at /home/book-demo#demo-form.
# NEXT_PUBLIC_MARKETING_DEMO_SCHEDULER_URL=""

# Optional webhook that receives demo requests as JSON. Every lead is persisted
# to `MarketingLead` first and the webhook is a side effect, so a webhook that is
# down or unset loses nothing (MK-3).
# MARKETING_DEMO_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# ZIMRA FDMS fiscalisation
# ---------------------------------------------------------------------------
# None of this is generated by the platform. A device is registered with ZIMRA,
# who issue the credentials below; the code generates the RSA keypair and the
# PKCS#10 CSR and exchanges it for the certificate, but it cannot invent an
# activation key. Until these are filled in, FD-3.3 (a fiscal invoice validated
# on ZIMRA's own portal) and FD-8 (pilot cutover) cannot be demonstrated —
# everything upstream of them is built and unit-tested against the v7.2 spec.
#
# What to obtain from ZIMRA, per environment:
#   1. A taxpayer registered on the FDMS TEST environment — TIN and VAT number.
#   2. Per virtual device: device ID, activation key, and device serial number.
#      The activation key is single-use: it is spent by the first successful
#      registration, so a fresh one is needed per environment, not per deploy.
#   3. The environment's API base URL, and the portal URL receipts are verified
#      against.
#
# Test and production are separate registrations with separate devices. Never
# point a production device at the test URL or the reverse — the certificate is
# issued for one gateway and the receipt chain it signs belongs to that device.
#
# These are per-tenant in normal operation and live on `FiscalisationProviderConfig`
# (which stores secrets by `env:NAME` reference rather than inline). The values
# here are the local development fallback and the names those references point at.
ZIMRA_FDMS_API_BASE_URL="https://fdmsapitest.zimra.co.zw"
ZIMRA_FDMS_PORTAL_URL="https://fdmstest.zimra.co.zw"
ZIMRA_FDMS_DEVICE_ID=""
ZIMRA_FDMS_DEVICE_SERIAL=""
# Single-use, spent on first successful registration.
ZIMRA_FDMS_ACTIVATION_KEY=""
# Written by the registration flow; the private key never leaves the server.
ZIMRA_FDMS_CERTIFICATE=""
ZIMRA_FDMS_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Subscription payments
# ---------------------------------------------------------------------------
# Which adapter collects subscription payments. Zimbabwe has no true recurring
# debit rail — mobile money is push-only and cards are a minority instrument —
# so the adapters differ mainly in which rails they reach and how quickly they
# settle. Choose on recurring support and settlement time, not headline rate.
#   paynow   — cards (Visa/Mastercard) alongside EcoCash, OneMoney, Telecash
#   pesepay  — the better EcoCash experience; advertises recurring payments
#   contipay — the broadest rail set: InnBucks, ZIPIT, ZimSwitch, Mukuru
PAYMENT_PROVIDER=""

# Paynow
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
# Pesepay
PESEPAY_INTEGRATION_KEY=""
PESEPAY_ENCRYPTION_KEY=""
# ContiPay
CONTIPAY_API_KEY=""
CONTIPAY_API_SECRET=""
CONTIPAY_MERCHANT_ID=""

# Shared: where the provider returns the payer, and the secret their webhook is
# signed with. The webhook is replay-protected on (provider, providerEventId),
# so a redelivered event is an observable no-op rather than a second charge.
PAYMENT_RETURN_URL="http://localhost:3000/preferences/organization/billing"
PAYMENT_WEBHOOK_SECRET=""
