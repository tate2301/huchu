enum GoldInventoryDirection {
  IN
  OUT
}

enum GoldInventorySourceType {
  POUR
  RECEIPT
  ADJUSTMENT
  SHIFT_ALLOCATION
  REVERSAL
  DISPATCH
  PURCHASE
}

/// APPEND-ONLY TABLE — do NOT UPDATE or DELETE rows from GoldInventoryEvent.
/// On rollback, insert a compensating REVERSAL event (opposite direction, same
/// sourceType/sourceId, negated grams). getOnHandGrams() sums IN minus OUT and
/// remains correct because IN + REVERSAL(OUT) cancel. Mutating or deleting rows
/// silently invalidates any reconciliation snapshot taken before the mutation.
///
/// TODO (future migration): add a Postgres trigger to enforce this at the DB level:
///
///   CREATE OR REPLACE FUNCTION gold_inventory_event_append_only()
///   RETURNS trigger LANGUAGE plpgsql AS $$
///   BEGIN
///     RAISE EXCEPTION
///       'GoldInventoryEvent is append-only. INSERT REVERSAL events instead of UPDATE/DELETE.';
///   END;
///   $$;
///
///   CREATE TRIGGER trg_gold_inventory_event_no_update
///   BEFORE UPDATE ON "GoldInventoryEvent"
///   FOR EACH ROW EXECUTE FUNCTION gold_inventory_event_append_only();
///
///   CREATE TRIGGER trg_gold_inventory_event_no_delete
///   BEFORE DELETE ON "GoldInventoryEvent"
///   FOR EACH ROW EXECUTE FUNCTION gold_inventory_event_append_only();
///
/// See docs/gold-module-review-2026-05-09.md §4.3, §4.4 C-4, §8 Q7, §13.1 P0.1.
model GoldInventoryEvent {
  id                  String                  @id @default(uuid())
  companyId           String
  siteId              String
  eventDate           DateTime
  direction           GoldInventoryDirection
  grams               Decimal                 @db.Decimal(12, 4)
  goldPriceUsdPerGram Decimal?                @db.Decimal(12, 4)
  goldPriceSource     GoldPriceSource?
  valueUsd            Decimal?                @db.Decimal(14, 2)
  sourceType          GoldInventorySourceType
  sourceId            String?
  notes               String?
  createdById         String?
  createdAt           DateTime                @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id])
  createdBy User?   @relation("GoldInventoryEventCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, siteId, eventDate])
  @@index([sourceType, sourceId])
}

enum GoldExceptionCategory {
  INVENTORY_DEFICIT
  NAME_UNMAPPED
  EXPENSE_MISMATCH
  BALANCE_DRIFT
  WITNESS_MISSING
  IMPORT_FAILURE
}

enum GoldExceptionSeverity {
  INFO
  WARNING
  CRITICAL
}

enum GoldExceptionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model GoldException {
  id               String                @id @default(uuid())
  companyId        String
  siteId           String?
  category         GoldExceptionCategory
  severity         GoldExceptionSeverity @default(WARNING)
  status           GoldExceptionStatus   @default(OPEN)
  entityType       String?
  entityId         String?
  description      String
  metadata         String? // JSON
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site           Site?   @relation(fields: [siteId], references: [id])
  acknowledgedBy User?   @relation("GoldExceptionAck", fields: [acknowledgedById], references: [id])
  resolvedBy     User?   @relation("GoldExceptionResolved", fields: [resolvedById], references: [id])
  createdBy      User?   @relation("GoldExceptionCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, status])
  @@index([category])
  @@index([entityType, entityId])
}

enum GoldLedgerImportStatus {
  DRAFT
  MAPPING
  PREVIEW
  COMMITTED
  FAILED
  ROLLED_BACK
}

enum GoldLedgerEntryStatus {
  PENDING
  CREATED
  ANOMALY
  FAILED
}

model GoldLedgerImport {
  id               String                 @id @default(uuid())
  companyId        String
  siteId           String?
  uploadedById     String
  fileName         String
  rowsTotal        Int                    @default(0)
  rowsCreated      Int                    @default(0)
  rowsAnomaly      Int                    @default(0)
  rowsFailed       Int                    @default(0)
  status           GoldLedgerImportStatus @default(DRAFT)
  mappingsJson     String? // JSON: { "Mutemeri": "shift-group-uuid", ... }
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  committedAt      DateTime?
  name             String?
  assignedToId     String?
  sourceFileSha256 String?
  tombstonedAt     DateTime?
  archivedAt       DateTime?
  presetId         String?
  sampleHeaderHash String? // SHA of the original CSV header row, used to match an import to a saved mapping preset (Epic 14)

  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site       Site?                     @relation(fields: [siteId], references: [id])
  uploadedBy User                      @relation("GoldLedgerImportUploadedBy", fields: [uploadedById], references: [id])
  assignedTo User?                     @relation("GoldLedgerImportAssignedTo", fields: [assignedToId], references: [id])
  preset     GoldLedgerImportPreset?   @relation(fields: [presetId], references: [id])
  entries    GoldLedgerEntry[]
  tags       GoldLedgerImportTag[]
  comments   GoldLedgerImportComment[]
  snapshots  GoldImportSnapshot[]

  @@index([companyId, createdAt])
  @@index([companyId, archivedAt])
  @@index([companyId, tombstonedAt])
  @@index([sourceFileSha256])
}

model GoldLedgerEntry {
  id                    String                @id @default(uuid())
  importId              String
  companyId             String?
  lineNo                Int
  rawJson               String // JSON of original CSV row
  rawLine               String? // original CSV line label or manual-sale descriptor, preserved for diagnostics (Epic 14)
  parsedDate            DateTime?
  parsedName            String?
  mappedShiftGroupId    String?
  gramsTotal            Decimal?              @db.Decimal(12, 4)
  expensesJson          String? // JSON: [{type, weight}, ...]
  boysGrams             Decimal?              @db.Decimal(12, 4)
  mdaraGrams            Decimal?              @db.Decimal(12, 4)
  balGrams              Decimal?              @db.Decimal(12, 4) // negative => sale
  status                GoldLedgerEntryStatus @default(PENDING)
  goldShiftAllocationId String?
  goldPourId            String? // bare-pour fallback OR set after auto-pour for cleanup tracking
  buyerReceiptId        String?
  errorMessage          String?
  /// Parser-origin warnings (set at parse time, never cleared on recommit
  /// cleanup). Distinct from errorMessage which is post-commit context.
  parserWarning         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  import     GoldLedgerImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  company    Company?                  @relation("GoldLedgerEntryCompany", fields: [companyId], references: [id])
  shiftGroup ShiftGroup?               @relation("GoldLedgerEntryShiftGroup", fields: [mappedShiftGroupId], references: [id])
  attendance Attendance[]              @relation("AttendanceGoldLedgerEntry")
  comments   GoldLedgerImportComment[]

  @@unique([importId, lineNo])
  @@index([importId, status])
  @@index([companyId, status])
}

