enum SupportAccessStatus {
  REQUESTED
  APPROVED
  ACTIVE
  EXPIRED
  REVOKED
  DENIED
}

enum SupportAccessScope {
  READ_ONLY
  READ_WRITE
}

enum SupportSessionMode {
  IMPERSONATE
  SHADOW
}

model SupportAccessRequest {
  id          String              @id @default(uuid())
  companyId   String
  requestedBy String
  approvedBy  String?
  reason      String
  scope       SupportAccessScope  @default(READ_ONLY)
  status      SupportAccessStatus @default(REQUESTED)
  requestedAt DateTime            @default(now())
  approvedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([requestedBy])
}

model SupportSession {
  id        String              @id @default(uuid())
  requestId String?
  companyId String
  actor     String
  mode      SupportSessionMode  @default(IMPERSONATE)
  scope     SupportAccessScope  @default(READ_ONLY)
  status    SupportAccessStatus @default(ACTIVE)
  reason    String
  startedAt DateTime            @default(now())
  endedAt   DateTime?
  expiresAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([requestId])
  @@index([actor])
}

enum RunbookRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RunbookExecutionStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

model RunbookDefinition {
  id         String           @id @default(uuid())
  companyId  String?
  name       String
  actionType String
  schedule   String?
  enabled    Boolean          @default(true)
  riskLevel  RunbookRiskLevel @default(LOW)
  inputJson  String?
  createdBy  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company    Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  executions RunbookExecution[]

  @@index([companyId, enabled])
  @@index([actionType])
}

model RunbookExecution {
  id         String                 @id @default(uuid())
  runbookId  String
  companyId  String?
  status     RunbookExecutionStatus @default(QUEUED)
  dryRun     Boolean                @default(false)
  startedAt  DateTime               @default(now())
  finishedAt DateTime?
  resultJson String?
  errorJson  String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  runbook RunbookDefinition @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  company Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([runbookId, createdAt])
  @@index([companyId, createdAt])
  @@index([status])
}

model TenantSloMetricSnapshot {
  id          String    @id @default(uuid())
  companyId   String
  metricKey   String
  value       Float
  status      String    @default("OK")
  windowStart DateTime?
  windowEnd   DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, metricKey, createdAt])
}

enum HealthIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model HealthIncident {
  id             String               @id @default(uuid())
  companyId      String
  metricKey      String
  riskLevel      RunbookRiskLevel     @default(LOW)
  actionType     String
  status         HealthIncidentStatus @default(OPEN)
  message        String
  actualValue    Float?
  thresholdValue Float?
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  updatedAt      DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([riskLevel, status])
}

enum ContractAccessState {
  ACTIVE
  WARNING
  SUSPENDED
  OVERRIDE
}

model ContractEnforcementEvent {
  id          String              @id @default(uuid())
  companyId   String
  fromState   ContractAccessState
  toState     ContractAccessState
  reason      String
  overrideBy  String?
  expiresAt   DateTime?
  effectiveAt DateTime            @default(now())
  createdAt   DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model PlatformAuditEvent {
  id            String   @id @default(uuid())
  companyId     String?
  actor         String?
  eventType     String
  entityType    String?
  entityId      String?
  reason        String?
  payloadJson   String?
  eventHash     String   @unique
  prevEventHash String?
  createdAt     DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([eventType, createdAt])
}

