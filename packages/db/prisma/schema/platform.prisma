model IdSequence {
  id         String   @id @default(uuid())
  companyId  String
  entityKey  String
  scopeKey   String   @default("GLOBAL")
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entityKey, scopeKey])
  @@index([companyId])
}

// Sequences that must be globally unique across all companies (e.g. StockMovement.referenceId).
// No companyId FK so the counter is shared across tenants.
model GlobalIdSequence {
  id         String   @id @default(uuid())
  entityKey  String
  scopeKey   String   @default("GLOBAL")
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityKey, scopeKey])
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum WorkspaceProfile {
  GOLD_MINE
  /// Retired with the scrap-metal module (ST-1.1 / ST-2.3), retained on purpose.
  ///
  /// `Company.workspaceProfile` is NOT NULL, so a tenant stored on this profile
  /// keeps holding the value until somebody migrates it deliberately. Dropping
  /// the value would fail the migration outright on any database with such a
  /// tenant, and rewriting those companies to GENERAL inside a schema migration
  /// would be a silent tenant reconfiguration nobody asked for.
  ///
  /// Nothing crashes on it: `RETIRED_WORKSPACE_PROFILES` in
  /// `lib/workspace-products.ts` lists both retired values and
  /// `toActiveWorkspaceProfile` degrades them to GENERAL at every lookup, which
  /// is what keeps a stale profile from indexing an empty record.
  SCRAP_METAL
  SCHOOLS
  /// Retired with the car-sales module (ST-1.1 / ST-2.2). See SCRAP_METAL above.
  AUTOS
  RETAIL      @map("THRIFT")
  /// A workspace that bought payroll and nothing else. Must exist here as well
  /// as in `lib/workspace-products.ts` — the TypeScript list is what the app
  /// reasons with, this is what the column can actually hold.
  PAYROLL
  GENERAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  monthlyPrice Float
  annualPrice  Float?
  currency     String   @default("USD")
  maxSites     Int?
  maxUsers     Int?
  warningDays  Int      @default(14)
  graceDays    Int      @default(7)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions CompanySubscription[]

  @@index([isActive])
}

model CompanySubscription {
  id                     String             @id @default(uuid())
  companyId              String
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  externalSubscriptionId String?            @unique
  startedAt              DateTime           @default(now())
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  endedAt                DateTime?
  effectiveMonthlyAmount Float?
  priceSnapshotJson      String?
  lastPriceComputedAt    DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@index([companyId, status])
  @@index([planId])
  @@index([currentPeriodEnd])
}

model PlatformFeature {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  description    String?
  domain         String?
  defaultEnabled Boolean  @default(false)
  isBillable     Boolean  @default(false)
  monthlyPrice   Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyFlags CompanyFeatureFlag[]
  bundleItems  FeatureBundleItem[]
  userFlags    UserFeatureFlag[]

  @@index([isActive])
}

model CompanyFeatureFlag {
  id        String    @id @default(uuid())
  companyId String
  featureId String
  isEnabled Boolean   @default(true)
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureId])
  @@index([featureId])
  @@index([companyId, isEnabled])
}

model UserFeatureFlag {
  id        String   @id @default(uuid())
  userId    String
  featureId String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
  @@index([featureId])
  @@index([userId, isEnabled])
}

/// A permission one person has, or has had taken away, against what their role
/// would otherwise give them. Feature access already has UserFeatureFlag; this
/// is its twin for the capabilities a module gates on, so the admin screen can
/// show one list instead of two systems that disagree.
model UserPermissionOverride {
  id            String   @id @default(uuid())
  companyId     String
  userId        String
  permissionKey String
  isAllowed     Boolean
  grantedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation("UserPermissionOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?   @relation("UserPermissionOverrideGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionKey])
  @@index([companyId, permissionKey])
  @@index([userId])
}

model FeatureBundle {
  id                         String   @id @default(uuid())
  code                       String   @unique
  name                       String
  description                String?
  monthlyPrice               Float    @default(0)
  additionalSiteMonthlyPrice Float    @default(0)
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  items         FeatureBundleItem[]
  companyAddons CompanySubscriptionAddon[]

  @@index([isActive])
}

model FeatureBundleItem {
  id        String   @id @default(uuid())
  bundleId  String
  featureId String
  createdAt DateTime @default(now())

  bundle  FeatureBundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([bundleId, featureId])
  @@index([featureId])
}

model CompanySubscriptionAddon {
  id        String   @id @default(uuid())
  companyId String
  bundleId  String
  isEnabled Boolean  @default(true)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bundle  FeatureBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([companyId, bundleId])
  @@index([bundleId, isEnabled])
}

/// One attempt to pay for a subscription, whichever gateway takes the money.
/// `provider` is the adapter key ("paynow", "pesepay", …) rather than an enum,
/// because SS-4.1 has not picked the gateway yet and a tenant that migrates
/// between gateways must keep its old payment rows readable — an enum would
/// force a migration on every provider added or dropped.
model SubscriptionPayment {
  id                String    @id @default(uuid())
  companyId         String
  subscriptionId    String?
  provider          String
  /// The gateway's own id for the transaction. Ours is `id`; theirs is this.
  providerReference String
  /// Money is Decimal at money's scale. A float subscription charge rounds
  /// somebody's payment into a mismatch with what the gateway settled.
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("USD")
  /// INITIATED | PENDING | PAID | FAILED | CANCELLED
  status            String
  /// 1 | 3 | 12 — monthly, quarterly, annual. Stored rather than derived from
  /// the dates because the annual discount (PR-2.1) is applied against the term
  /// that was actually bought, and the term is what the receipt has to state.
  periodMonths      Int
  idempotencyKey    String    @unique
  rawPayloadJson    String?
  paidAt            DateTime?
  failureReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: the payment ledger outlives the subscription row it
  /// paid for. A tenant that cancels and re-subscribes must not lose the record
  /// of money it already sent.
  subscription CompanySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// A replayed webhook carries the same gateway reference, so it collides here
  /// instead of creating a second payment for one transaction.
  @@unique([provider, providerReference])
  @@index([companyId, status, createdAt])
  @@index([subscriptionId])
}

/// Every webhook delivery a gateway makes, recorded before it is acted on.
/// Gateways retry until they see a 2xx and re-deliver on their own schedule, so
/// "did I already process this?" cannot be answered from the payment table
/// alone — a delivery that failed mid-processing left no payment row to find.
model PaymentWebhookEvent {
  id                String    @id @default(uuid())
  provider          String
  providerEventId   String
  /// Recorded, not assumed: an unverified delivery is stored and refused rather
  /// than dropped silently, so a signing-key rotation is visible as a run of
  /// false rows instead of as payments that never arrived.
  signatureVerified Boolean   @default(false)
  payloadJson       String
  processedAt       DateTime?
  error             String?
  createdAt         DateTime  @default(now())

  /// The whole point of this table: the second delivery of one event fails the
  /// insert and is answered 200 without re-applying the transition.
  @@unique([provider, providerEventId])
  @@index([provider, processedAt])
}

/// A stranger who raised their hand on the marketing site. Deliberately NOT
/// tenant-scoped and with no required contact field: a lead has no Company yet,
/// and a calculator submission that reaches us with only a phone number is
/// still worth more than the `console.error` it used to become (MK-3.1).
model MarketingLead {
  id          String   @id @default(uuid())
  /// DEMO_REQUEST | PENALTY_CALCULATOR | VAT_THRESHOLD | OTHER
  source      String
  name        String?
  email       String?
  phone       String?
  companyName String?
  message     String?
  /// The tool's own inputs — the calculator's till count and days are the sales
  /// context that makes the follow-up call specific instead of generic.
  payloadJson String?
  pagePath    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([source, createdAt])
}

model ProvisioningEvent {
  id          String    @id @default(uuid())
  companyId   String
  eventType   String
  status      String    @default("PENDING")
  message     String?
  payloadJson String?
  errorJson   String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([status])
}

