model SchoolTeacherProfile {
  id             String   @id @default(uuid())
  companyId      String
  userId         String
  /// The HR record for the same person.
  ///
  /// Nullable because a school can run its timetable before payroll knows the
  /// teacher exists, and unique because one employee is one teacher — without
  /// it, two profiles could point at the same member of staff and the school
  /// would have two of her.
  employeeId     String?  @unique
  employeeCode   String
  department     String?
  isClassTeacher Boolean  @default(false)
  isHod          Boolean  @default(false)
  isActive       Boolean  @default(true)
  /// S-4.3 — the record page's identity strip.
  ///
  /// A photograph when there is one; otherwise the initials `PersonAvatar`
  /// derives from the name. `accent` pins the name-derived colour so the same
  /// person is the same colour on the register, the mark sheet and the record
  /// page; null means it keeps taking its colour from the name.
  ///
  /// Deliberately no `emoji` column, unlike the CRM record types: a child or a
  /// parent is a person, and offering to stand one in as 🙂 is not a feature.
  avatarUrl       String?
  accent          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee    Employee?            @relation("SchoolTeacherProfileEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  assignments    SchoolClassSubject[]
  timetableSlots SchoolTimetableSlot[]
  coverAssignments SchoolCoverAssignment[] @relation("SchoolCoverTeacher")
  parentMeetings   SchoolParentMeeting[]   @relation("SchoolParentMeetingTeacher")
  teachingResources SchoolTeachingResource[] @relation("SchoolResourceUploader")
  messageThreads    SchoolMessageThread[]

  @@unique([companyId, userId])
  @@unique([companyId, employeeCode])
  @@index([companyId, isActive])
}

