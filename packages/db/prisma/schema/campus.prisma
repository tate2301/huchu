model SchoolStudent {
  id              String              @id @default(uuid())
  companyId       String
  /// The portal account for this student. Null until the invite is claimed.
  /// Identity used to be inferred by matching the session email's local part
  /// against studentNo, which let anyone with a chosen email read another
  /// child's records.
  userId          String?
  studentNo       String
  admissionNo     String?
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          String?
  status          SchoolStudentStatus @default(APPLICANT)
  currentClassId  String?
  currentStreamId String?
  isBoarding      Boolean             @default(false)
  admissionDate   DateTime?
  /// S-4.3 — the record page's identity strip.
  ///
  /// A photograph when there is one; otherwise the initials `PersonAvatar`
  /// derives from the name. `accent` pins the name-derived colour so the same
  /// person is the same colour on the register, the mark sheet and the record
  /// page; null means it keeps taking its colour from the name.
  ///
  /// Deliberately no `emoji` column, unlike the CRM record types: a child or a
  /// parent is a person, and offering to stand one in as 🙂 is not a feature.
  avatarUrl       String?
  accent          String?
  /// S-4.4 — the school's own fields on this record, keyed by
  /// `CrmFieldDefinition.key`.
  ///
  /// A JSON column rather than an entity-attribute-value table, matching what
  /// the CRM records already do: the definitions carry the types and the
  /// validation, `lib/crm/custom-fields.ts` owns both, and a school asking for
  /// "bus route" gets one column write rather than a join.
  customFields    Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company                Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                   User?                         @relation("SchoolStudentPortalUser", fields: [userId], references: [id], onDelete: SetNull)
  currentClass           SchoolClass?                  @relation(fields: [currentClassId], references: [id], onDelete: SetNull)
  currentStream          SchoolStream?                 @relation(fields: [currentStreamId], references: [id], onDelete: SetNull)
  guardianLinks          SchoolStudentGuardian[]
  enrollments            SchoolEnrollment[]
  boardingAllocations    SchoolBoardingAllocation[]
  leaveRequests          SchoolLeaveRequest[]
  boardingMovementLogs   SchoolBoardingMovementLog[]
  resultLines            SchoolResultLine[]
  assessmentScores       SchoolAssessmentScore[]
  application            SchoolApplication?
  healthRecord           SchoolHealthRecord?
  healthEvents           SchoolHealthEvent[]
  assignmentSubmissions  SchoolAssignmentSubmission[]
  bookLoans              SchoolBookLoan[]
  bookReservations       SchoolBookReservation[]
  goals                  SchoolStudentGoal[]
  parentMeetings         SchoolParentMeeting[]
  transportRiderships    SchoolTransportRider[]
  attendanceSessionLines SchoolAttendanceSessionLine[]
  feeInvoices            SchoolFeeInvoice[]
  feeReceipts            SchoolFeeReceipt[]
  feeWaivers             SchoolFeeWaiver[]
  feeRefunds             SchoolFeeRefund[]
  portalInvites          SchoolPortalInvite[]
  messageThreads         SchoolMessageThread[]

  @@unique([companyId, studentNo])
  @@unique([companyId, admissionNo])
  @@unique([companyId, userId])
  @@index([companyId, status])
  @@index([currentClassId])
}

