/// Partial unique index `SchoolAcademicYear_companyId_active_key` and check
/// constraint `SchoolAcademicYear_dates_ordered` are enforced in the database
/// but cannot be expressed in Prisma schema. See
/// migrations/20260804120000_school_calendar_single_active. Do not drop them.
model SchoolAcademicYear {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  terms   SchoolTerm[]
  classes SchoolClass[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

/// Partial unique index `SchoolTerm_academicYearId_active_key` and check
/// constraint `SchoolTerm_dates_ordered` are enforced in the database but
/// cannot be expressed in Prisma schema. See
/// migrations/20260804120000_school_calendar_single_active. Do not drop them.
model SchoolTerm {
  id             String   @id @default(uuid())
  companyId      String
  academicYearId String
  code           String
  name           String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  academicYear        SchoolAcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classes             SchoolClass[]
  streams             SchoolStream[]
  enrollments         SchoolEnrollment[]
  boardingAllocations SchoolBoardingAllocation[]
  resultSheets        SchoolResultSheet[]
  classSubjects          SchoolClassSubject[]
  periods                SchoolPeriod[]
  timetableSlots         SchoolTimetableSlot[]
  calendarEvents         SchoolCalendarEvent[]
  assessments            SchoolAssessment[]
  assignments            SchoolAssignment[]
  lessonPlans            SchoolLessonPlan[]
  schemesOfWork          SchoolSchemeOfWork[]
  studentGoals           SchoolStudentGoal[]
  transportRiders        SchoolTransportRider[]
  applications           SchoolApplication[]
  publishWindows      SchoolPublishWindow[]
  feeStructures       SchoolFeeStructure[]
  feeInvoices         SchoolFeeInvoice[]
  feeWaivers          SchoolFeeWaiver[]
  leaveRequests       SchoolLeaveRequest[]

  @@unique([companyId, academicYearId, code])
  @@index([companyId, isActive])
}

model SchoolClass {
  id             String   @id @default(uuid())
  companyId      String
  code           String
  name           String
  level          Int?
  capacity       Int?
  academicYearId String?
  termId         String?
  /// S-4.3 — the record page's identity strip.
  ///
  /// A thing may carry a picture, and failing that an emoji — a form room as 🔵,
  /// a subject as 📐 — which reads faster in a list than a repeated generic
  /// icon. `accent` pins its colour; null takes it from the name.
  avatarUrl      String?
  emoji          String?
  accent         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  academicYear   SchoolAcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  term           SchoolTerm?           @relation(fields: [termId], references: [id], onDelete: SetNull)
  streams        SchoolStream[]
  students       SchoolStudent[]
  applications   SchoolApplication[]
  teachingResources SchoolTeachingResource[]
  enrollments    SchoolEnrollment[]
  resultSheets   SchoolResultSheet[]
  classSubjects  SchoolClassSubject[]
  timetableSlots SchoolTimetableSlot[]
  publishWindows SchoolPublishWindow[]
  feeStructures  SchoolFeeStructure[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([termId])
}

model SchoolStream {
  id        String   @id @default(uuid())
  companyId String
