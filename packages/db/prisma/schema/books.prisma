// Books module: chart of accounts, journals, posting rules, tax, sales and purchase ledgers, banking, VAT, fiscalisation. Modules contribute source types and default accounts.

// ============================================
// PHASE 6: ACCOUNTING
// ============================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum AccountingPeriodLockPolicy {
  STRICT
  MANAGER_OVERRIDE
  SOFT_WARN
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
  VOIDED
}

enum PostingDirection {
  DEBIT
  CREDIT
}

enum PostingBasis {
  AMOUNT
  NET
  TAX
  GROSS
  DEDUCTIONS
  ALLOWANCES
  // Payroll statutory bases. Each is the sum of the `PayrollLineComponent` rows
  // carrying the matching `statutoryKey`, so the ledger balance on a payable
  // account and the return filed against it are summed from the same rows.
  PAYE
  AIDS_LEVY
  NSSA_EMPLOYEE
  NSSA_EMPLOYER
  ZIMDEF
  STANDARDS_DEVELOPMENT_LEVY
  NEC_EMPLOYEE
  NEC_EMPLOYER
  /// Employee deductions that are not statutory — pension, union, advances.
  OTHER_DEDUCTIONS
  /// Everything the employer owes on top of the wage, summed.
  EMPLOYER_CONTRIBUTIONS
}

enum AllocationType {
  PERCENT
  FIXED
}

enum AccountingSourceType {
  MANUAL
  STOCK_RECEIPT
  STOCK_ISSUE
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  PAYROLL_RUN
  PAYROLL_DISBURSEMENT
  GOLD_PURCHASE
  GOLD_RECEIPT
  GOLD_DISPATCH
  SALES_INVOICE
  SALES_RECEIPT
  SALES_CREDIT_NOTE
  SALES_WRITE_OFF
  PURCHASE_BILL
  PURCHASE_PAYMENT
  PURCHASE_DEBIT_NOTE
  PURCHASE_WRITE_OFF
  BANK_TRANSACTION
  MAINTENANCE_COMPLETION
  /// Retired with `IrregularPayoutBatch` in P-1, kept so old rows stay readable.
  ///
  /// Same rule as `ApprovalTargetType.IRREGULAR_PAYOUT_BATCH`, and pinned by the
  /// same test: Postgres refuses to drop a value any row still holds, and the
  /// two ways round that are both worse than the dead value. Nothing writes it —
  /// settlements post as `PAYROLL_DISBURSEMENT` — but a disbursement that posted
  /// under this name really did post under it, and rewriting a ledger row to say
  /// otherwise is a lie the trial balance cannot detect.
  ///
  /// ST-3.3 dropped `SCRAP_METAL_PURCHASE`, `SCRAP_METAL_BATCH` and
  /// `SCRAP_METAL_SALE` from this enum. Those three were safe to drop and this
  /// one is not, for one reason: scrap had no seeded posting rule, so its events
  /// were always breadcrumbs on the nullable `AccountingIntegrationEvent`
  /// column and could never reach a `JournalEntry`. This one was captured with
  /// status PENDING and could.
  IRREGULAR_PAYOUT_DISBURSEMENT
  RETAIL_SHIFT_OPEN
  RETAIL_GOODS_RECEIPT
  RETAIL_SALE
  RETAIL_REFUND
  RETAIL_VOID
  RETAIL_STOCK_ADJUSTMENT
  RETAIL_STOCK_TRANSFER
  RETAIL_SHIFT_VARIANCE
  GOLD_SHIFT_ALLOCATION_COMPANY
  GOLD_SHIFT_ALLOCATION_WORKER
  GOLD_SHIFT_EXPENSE
  GOLD_PAYOUT
  GOLD_INVENTORY_ADJUSTMENT
  // S-2.3. School money used to post as SALES_*, so tuition landed in "Retail
  // Sales Revenue" and a bursary was indistinguishable from bad debt. These are
  // the school's own kinds; `SCHOOLS_REQUIRED_SOURCE_TYPES` in
  // `lib/accounting/source-types.ts` is the readiness contract over them.
  SCHOOL_FEE_INVOICE
  SCHOOL_FEE_RECEIPT
  SCHOOL_FEE_RECEIPT_VOID
  SCHOOL_FEE_CREDIT_APPLIED
  SCHOOL_FEE_WAIVER
  SCHOOL_FEE_WRITE_OFF
  SCHOOL_FEE_REFUND
}

enum PostingRuleScopeType {
  COMPANY
  SITE
}

enum PostingRuleMode {
  GUIDED
  ADVANCED
}

enum PostingRuleConditionField {
  SITE_ID
  REGISTER_CODE
  TENDER_TYPE
  CURRENCY
  CUSTOMER_TAX_CATEGORY_ID
  VENDOR_TAX_CATEGORY_ID
  SALE_TYPE
  MOVEMENT_TYPE
}

enum PostingRuleOperator {
  EQ
  NEQ
  IN
  NOT_IN
  EXISTS
  NOT_EXISTS
}

enum PostingRuleLineRepeatMode {
  NONE
  TENDER
}

enum PostingRuleLineAccountSource {
  FIXED_ACCOUNT
  TENDER_MAPPING
}

enum AccountingSeedExecutionMode {
  DRY_RUN
  APPLY
}

enum AccountingSeedExecutionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOIDED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  VOIDED
}

enum BillStatus {
  DRAFT
  RECEIVED
  PAID
  VOIDED
}

enum FiscalReceiptStatus {
  PENDING
  SUCCESS
  FAILED
  VOIDED
}

enum NoteStatus {
  DRAFT
  ISSUED
  VOIDED
}

enum WriteOffStatus {
  POSTED
  VOIDED
}

enum ReconciliationStatus {
  OPEN
  CLOSED
  VOIDED
}

enum VatReturnStatus {
  DRAFT
  REVIEWED
  FINALIZED
  FILED
  VOIDED
}

enum PaymentLedgerAccountType {
  RECEIVABLE
  PAYABLE
}

enum PaymentLedgerEntryStatus {
  POSTED
  VOIDED
}

enum AccountNodeType {
  GROUP
  LEDGER
}

model AccountingSettings {
  id                        String                     @id @default(uuid())
  companyId                 String                     @unique
  baseCurrency              String                     @default("USD")
  fiscalYearStartMonth      Int                        @default(1)
  periodLockPolicy          AccountingPeriodLockPolicy @default(MANAGER_OVERRIDE)
  legalName                 String?
  tradingName               String?
  vatNumber                 String?
  taxNumber                 String?
  address                   String?
  phone                     String?
  email                     String?
  defaultTaxCodeId          String?
  defaultBankAccountId      String?
  freezeBeforeDate          DateTime?
  retainedEarningsAccountId String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultTaxCode     TaxCode?     @relation("DefaultTaxCode", fields: [defaultTaxCodeId], references: [id])
  defaultBankAccount BankAccount? @relation("DefaultBankAccount", fields: [defaultBankAccountId], references: [id])
}

model ChartOfAccount {
  id              String          @id @default(uuid())
  companyId       String
  code            String
  name            String
  type            AccountType
  nodeType        AccountNodeType @default(LEDGER)
  parentAccountId String?
  hierarchyPath   String?
  level           Int             @default(0)
  category        String?
  description     String?
  isActive        Boolean         @default(true)
  systemManaged   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company                Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentAccount          ChartOfAccount?        @relation("ChartOfAccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts          ChartOfAccount[]       @relation("ChartOfAccountHierarchy")
  journalLines           JournalLine[]
  postingLines           PostingRuleLine[]
  tenderClearingMappings TenderAccountMapping[] @relation("TenderClearingAccount")
  tenderOffsetMappings   TenderAccountMapping[] @relation("TenderOffsetAccount")

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([companyId, nodeType])
  @@index([companyId, parentAccountId])
}

model AccountingPeriod {
  id           String                 @id @default(uuid())
  companyId    String
  startDate    DateTime
  endDate      DateTime
  status       AccountingPeriodStatus @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  closedBy      User?                @relation("AccountingPeriodClosedBy", fields: [closedById], references: [id])
  reopenedBy    User?                @relation("AccountingPeriodReopenedBy", fields: [reopenedById], references: [id])
  journals      JournalEntry[]
  closeVouchers PeriodCloseVoucher[]

  @@index([companyId, startDate, endDate])
}

model JournalEntry {
  id                   String               @id @default(uuid())
  companyId            String
  entryNumber          Int
  entryDate            DateTime
  description          String
  status               JournalStatus        @default(DRAFT)
  periodId             String?
  sourceType           AccountingSourceType @default(MANUAL)
  sourceId             String?
  createdById          String
  postedById           String?
  postedAt             DateTime?
  reversedById         String?
  reversedAt           DateTime?
  voidedById           String?
  voidedAt             DateTime?
  periodOverrideReason String?
  periodOverrideById   String?
  periodOverrideAt     DateTime?
  reversalOfEntryId    String?              @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period           AccountingPeriod? @relation(fields: [periodId], references: [id])
  createdBy        User              @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  postedBy         User?             @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  reversedBy       User?             @relation("JournalEntryReversedBy", fields: [reversedById], references: [id])
  voidedBy         User?             @relation("JournalEntryVoidedBy", fields: [voidedById], references: [id])
  periodOverrideBy User?             @relation("JournalEntryPeriodOverrideBy", fields: [periodOverrideById], references: [id])
  reversalOfEntry  JournalEntry?     @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversalEntry    JournalEntry?     @relation("JournalEntryReversal")
  lines            JournalLine[]

  @@unique([companyId, entryNumber])
  @@unique([companyId, sourceType, sourceId])
  @@index([companyId, entryDate])
}

enum AccountingIntegrationStatus {
  PENDING
  POSTED
  FAILED
  IGNORED
}

model AccountingIntegrationEvent {
  id               String                      @id @default(uuid())
  companyId        String
  sourceDomain     String
  sourceAction     String
  sourceType       AccountingSourceType?
  sourceId         String?
  sourceSubtype    String?
  siteId           String?
  registerCode     String?
  causationKey     String?
  eventKey         String                      @unique
  entryDate        DateTime?
  description      String?
  amount           Float?
  netAmount        Float?
  taxAmount        Float?
  grossAmount      Float?
  deductionsAmount Float?
  allowancesAmount Float?
  currency         String?
  payloadJson      String?
  status           AccountingIntegrationStatus @default(PENDING)
  attemptCount     Int                         @default(0)
  nextRetryAt      DateTime?
  lastError        String?
  journalEntryId   String?
  createdById      String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, nextRetryAt])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, sourceType, siteId])
}

model JournalLine {
  id           String   @id @default(uuid())
  entryId      String
  accountId    String
  debit        Float    @default(0)
  credit       Float    @default(0)
  memo         String?
  costCenterId String?
  createdAt    DateTime @default(now())

  entry      JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    ChartOfAccount @relation(fields: [accountId], references: [id])
  costCenter CostCenter?    @relation(fields: [costCenterId], references: [id])

  @@index([entryId])
  @@index([accountId])
}

model PostingRule {
  id          String               @id @default(uuid())
  companyId   String
  name        String
  sourceType  AccountingSourceType
  description String?
  priority    Int                  @default(100)
  scopeType   PostingRuleScopeType @default(COMPANY)
  siteId      String?
  ruleMode    PostingRuleMode      @default(GUIDED)
  isFallback  Boolean              @default(false)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site       Site?                  @relation("PostingRuleSite", fields: [siteId], references: [id])
  lines      PostingRuleLine[]
  conditions PostingRuleCondition[]

  @@index([companyId, sourceType, isActive, priority])
  @@index([companyId, sourceType, siteId, isActive, priority])
}

model PostingRuleLine {
  id              String                       @id @default(uuid())
  ruleId          String
  accountId       String?
  direction       PostingDirection
  basis           PostingBasis                 @default(AMOUNT)
  allocationType  AllocationType               @default(PERCENT)
  allocationValue Float                        @default(100)
  taxCodeId       String?
  repeatMode      PostingRuleLineRepeatMode    @default(NONE)
  accountSource   PostingRuleLineAccountSource @default(FIXED_ACCOUNT)
  valuePath       String?
  memoTemplate    String?
  costCenterId    String?
  sortOrder       Int                          @default(0)
  createdAt       DateTime                     @default(now())

  rule       PostingRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  account    ChartOfAccount? @relation(fields: [accountId], references: [id])
  taxCode    TaxCode?        @relation(fields: [taxCodeId], references: [id])
  costCenter CostCenter?     @relation(fields: [costCenterId], references: [id])

  @@index([ruleId])
  @@index([accountId])
  @@index([costCenterId])
}

model PostingRuleCondition {
  id            String                    @id @default(uuid())
  ruleId        String
  field         PostingRuleConditionField
  operator      PostingRuleOperator       @default(EQ)
  valueString   String?
  valueListJson String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  rule PostingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, field])
}

model TaxCode {
  id            String    @id @default(uuid())
  companyId     String
  code          String
  name          String
  rate          Float     @default(0)
  type          String    @default("VAT") // VAT, WITHHOLDING, OTHER
  appliesTo     String    @default("BOTH") // SALES, PURCHASE, BOTH
  vat7OutputBox String?
  vat7InputBox  String?
  /// FD-0.2 — the numeric taxID ZIMRA uses to identify this rate.
  ///
  /// FDGA v7.2 never sends a rate name or a percentage on its own: every
  /// receipt tax line is keyed by an integer taxID drawn from the device's
  /// `getConfig` response, and the receipt signature concatenates those lines
  /// sorted by that integer. A tax code with no mapping therefore cannot be
  /// signed at all, which is why issuing against an unmapped code has to be
  /// refused rather than defaulted. Nullable because every existing tenant
  /// predates the mapping and will be filled in from `getConfig` per device.
  zimraTaxId    Int?
  scheduleType  String    @default("NONE") // NONE, FX, RTGS, WITHHOLDING
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceLines       SalesInvoiceLine[]
  quotationLines     SalesQuotationLine[]
  billLines          PurchaseBillLine[]
  creditNoteLines    CreditNoteLine[]
  debitNoteLines     DebitNoteLine[]
  postingLines       PostingRuleLine[]
  templateLines      TaxTemplateLine[]
  defaultForSettings AccountingSettings[] @relation("DefaultTaxCode")

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, code, effectiveFrom, effectiveTo])
}

model TaxCategory {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  scope     String   @default("BOTH") // CUSTOMER, VENDOR, BOTH
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers Customer[]
  vendors   Vendor[]
  rules     TaxRule[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model TaxTemplate {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   TaxTemplateLine[]
  rules   TaxRule[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model TaxTemplateLine {
  id         String   @id @default(uuid())
  templateId String
  taxCodeId  String
  sortOrder  Int      @default(0)
  appliesTo  String   @default("BOTH") // SALES, PURCHASE, BOTH
  isDefault  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template TaxTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  taxCode  TaxCode     @relation(fields: [taxCodeId], references: [id])

  @@index([templateId, sortOrder])
  @@index([taxCodeId])
}

model TaxRule {
  id            String    @id @default(uuid())
  companyId     String
  name          String
  appliesTo     String    @default("BOTH") // SALES, PURCHASE, BOTH
  priority      Int       @default(100)
  taxCategoryId String?
  templateId    String
  currency      String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxCategory TaxCategory? @relation(fields: [taxCategoryId], references: [id])
  template    TaxTemplate  @relation(fields: [templateId], references: [id])

  @@index([companyId, isActive, priority])
  @@index([companyId, appliesTo, currency])
}

model CurrencyDefinition {
  id            String   @id @default(uuid())
  companyId     String
  code          String
  name          String
  symbol        String?
  decimalPlaces Int      @default(2)
  isBase        Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId, isActive, sortOrder])
}

model Customer {
  id            String   @id @default(uuid())
  companyId     String
  taxCategoryId String?
  name          String
  contactName   String?
  phone         String?
  email         String?
  address       String?
  taxNumber     String?
  vatNumber     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxCategory     TaxCategory?     @relation(fields: [taxCategoryId], references: [id])
  invoices        SalesInvoice[]
  quotations      SalesQuotation[]
  crmClients      CrmClient[]

  @@index([companyId, isActive])
}

model Vendor {
  id            String   @id @default(uuid())
  companyId     String
  taxCategoryId String?
  name          String
  contactName   String?
  phone         String?
  email         String?
  address       String?
  taxNumber     String?
  vatNumber     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxCategory         TaxCategory?         @relation(fields: [taxCategoryId], references: [id])
  bills               PurchaseBill[]

  @@index([companyId, isActive])
}

model SalesInvoice {
  id            String               @id @default(uuid())
  companyId     String
  customerId    String
  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime?
  status        InvoiceStatus        @default(DRAFT)
  currency      String               @default("USD")
  subTotal      Float                @default(0)
  taxTotal      Float                @default(0)
  total         Float                @default(0)
  amountPaid    Float                @default(0)
  creditTotal   Float                @default(0)
  writeOffTotal Float                @default(0)
  notes         String?
  // Fiscal receipt relation is managed via FiscalReceipt.invoiceId
  fiscalStatus  FiscalReceiptStatus? @default(PENDING)
  /// The quotation this invoice was raised from, when it was. The CRM reads
  /// this to recognise its own work coming back from Accounting.
  quotationId   String?
  createdById   String?
  issuedById    String?
  issuedAt      DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer           @relation(fields: [customerId], references: [id])
  lines            SalesInvoiceLine[]
  receipts         SalesReceipt[]
  fiscalReceipt    FiscalReceipt?     @relation("SalesInvoiceFiscalReceipt")
  creditNotes      CreditNote[]
  writeOffs        SalesWriteOff[]
  crmLeadDocuments CrmLeadDocument[]  @relation("CrmLeadDocInvoice")
  createdBy        User?              @relation("SalesInvoiceCreatedBy", fields: [createdById], references: [id])
  issuedBy         User?              @relation("SalesInvoiceIssuedBy", fields: [issuedById], references: [id])

  fromQuotation SalesQuotation? @relation("SalesInvoiceFromQuotation", fields: [quotationId], references: [id], onDelete: SetNull)

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
}

model SalesInvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  taxCodeId   String?
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  lineTotal   Float    @default(0)
  debit       Float?
  credit      Float?
  createdAt   DateTime @default(now())

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxCode TaxCode?     @relation(fields: [taxCodeId], references: [id])

  @@index([invoiceId])
}

model SalesQuotation {
  id              String          @id @default(uuid())
  companyId       String
  customerId      String
  quotationNumber String
  quotationDate   DateTime
  validUntil      DateTime?
  status          QuotationStatus @default(DRAFT)
  currency        String          @default("USD")
  subTotal        Float           @default(0)
  taxTotal        Float           @default(0)
  total           Float           @default(0)
  notes           String?
  createdById     String?
  issuedById      String?
  issuedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer             @relation(fields: [customerId], references: [id])
  lines            SalesQuotationLine[]
  createdBy        User?                @relation("SalesQuotationCreatedBy", fields: [createdById], references: [id])
  issuedBy         User?                @relation("SalesQuotationIssuedBy", fields: [issuedById], references: [id])
  crmLeadDocuments CrmLeadDocument[]    @relation("CrmLeadDocQuotation")
  invoicesRaised   SalesInvoice[]       @relation("SalesInvoiceFromQuotation")

  @@unique([companyId, quotationNumber])
  @@index([companyId, status])
}

model SalesQuotationLine {
  id          String   @id @default(uuid())
  quotationId String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  taxCodeId   String?
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  lineTotal   Float    @default(0)
  createdAt   DateTime @default(now())

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  taxCode   TaxCode?       @relation(fields: [taxCodeId], references: [id])

  @@index([quotationId])
}

model SalesReceipt {
  id            String   @id @default(uuid())
  companyId     String
  invoiceId     String?
  receiptNumber String
  receivedAt    DateTime
  amount        Float
  method        String
  reference     String?
  bankAccountId String?
  createdById   String?
  createdAt     DateTime @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice          SalesInvoice?     @relation(fields: [invoiceId], references: [id])
  bankAccount      BankAccount?      @relation(fields: [bankAccountId], references: [id])
  createdBy        User?             @relation("SalesReceiptCreatedBy", fields: [createdById], references: [id])
  crmLeadDocuments CrmLeadDocument[] @relation("CrmLeadDocReceipt")

  @@unique([companyId, receiptNumber])
}

model CreditNote {
  id          String     @id @default(uuid())
  companyId   String
  invoiceId   String
  noteNumber  String
  noteDate    DateTime
  status      NoteStatus @default(DRAFT)
