+import type { Prisma } from "@prisma/client";
+
+import { sumMoney, ZERO } from "@/lib/money";
+import { prisma } from "@/lib/prisma";
+
+import { lineVat } from "./figures";
+
+/**
+ * A posted delivery's value ex VAT (Σ in stock × cost, its lines' totals),
+ * its VAT line by line, and the rate that VAT is of the value: what a bill
+ * against it is matched with (40-buying 3.2) and what clears GRNI.
+ */
+export async function deliveryFigures(
+  client: Prisma.TransactionClient | typeof prisma,
+  receiptId: string,
+): Promise<{ value: Prisma.Decimal; vat: Prisma.Decimal; rate: Prisma.Decimal }> {
+  const lines = await client.retailGoodsReceiptLine.findMany({ where: { receiptId }, select: { lineTotal: true, vatRate: true } });
+  const value = sumMoney(lines.map((line) => line.lineTotal));
+  const vat = sumMoney(lines.map((line) => lineVat(line.lineTotal, line.vatRate)));
+  const rate = value.greaterThan(0) ? vat.dividedBy(value).times(100).toDecimalPlaces(2) : ZERO;
+  return { value, vat, rate };
+}
