+import { NextRequest, NextResponse } from "next/server";
+
+import { errorResponse, successResponse } from "@/lib/api-response";
+import { previewPayment } from "@/lib/retail/buying/payments";
+import { buyingFailure } from "@/lib/retail/buying/routes";
+import { requireRetailPermission } from "@/lib/retail/permissions";
+
+import { requireRetailSession } from "../../../_helpers";
+
+const UUID = /^[0-9a-f-]{36}$/i;
+
+/** What a payment would pay, live under the Pays row: the same allocation recording it writes. */
+export async function GET(request: NextRequest) {
+  const { response, session } = await requireRetailSession(request);
+  if (response || !session) return response as NextResponse;
+  const gate = requireRetailPermission(session, "retail.bills", "create");
+  if (gate) return gate;
+  const search = request.nextUrl.searchParams;
+  const supplierId = search.get("supplierId") ?? "";
+  if (!UUID.test(supplierId)) return errorResponse("Supplier not found", 404);
+  const billId = search.get("billId");
+  try {
+    return successResponse({
+      data: await previewPayment(session.user.companyId, { supplierId, amount: search.get("amount"), billId: billId && UUID.test(billId) ? billId : null }),
+    });
+  } catch (error) {
+    return buyingFailure(error, "GET /api/v2/retail/buying/payments/preview");
+  }
+}
