--- /dev/null
+++ b/lib/retail/buying/payments.ts
@@ -0,0 +1,230 @@
+import { Prisma } from "@prisma/client";
+
+import { recalcPurchaseBillBalance } from "@/lib/accounting/balances";
+import { reserveIdentifier } from "@/lib/id-generator";
+import { money, sumMoney, toNumberOrZero, ZERO } from "@/lib/money";
+import { prisma } from "@/lib/prisma";
+import { auditAmount, RETAIL_AUDIT_EVENTS, writeRetailAuditEvent, type RetailAuditActor } from "@/lib/retail/audit";
+import { startOfDayIn } from "@/lib/reports/list-query";
+import { dayKey, DEFAULT_TIME_ZONE, formatMoney } from "@/lib/workspace/format";
+
+import { BillRefusal, lockSupplier, unpaidBills } from "./bills";
+import { currencyWords, findMoneyAccount, moneyAccountBalance } from "./money-accounts";
+import { postSupplierPayment, type AccountingResult } from "./posting";
+
+/**
+ * Paying a supplier (40-buying W-35 "Record payment", BUY-07): one payment
+ * (`PAY-0019`) from a money account settles their unpaid bills — the bill it
+ * was opened from first, then by due day, oldest first — one row a bill
+ * ("PAY-0019/1", "/2"), never past a bill's balance, and whatever is over is
+ * one row with no bill: a credit the next bill takes. The account is locked
+ * before its balance is read, so two payments from one cash account cannot
+ * spend the same money; the supplier is locked so their money is allocated
+ * once. Money leaves the account as a CREDIT; the books follow after the
+ * commit (Dr Accounts payable / Cr the account's ledger).
+ */
+
+type Client = Prisma.TransactionClient | typeof prisma;
+
+const invalid = (fieldErrors: Record<string, string>) => new BillRefusal(400, "Validation failed", fieldErrors);
+
+export const PAYMENT_HOW = ["Cash", "Bank transfer", "EcoCash"] as const;
+export type PaymentHow = (typeof PAYMENT_HOW)[number];
+
+export type Allocation = { billId: string; billNumber: string; amount: Prisma.Decimal };
+
+/** How an amount settles bills in the order given: each up to its balance; what is left is credit. */
+export function allocate(amount: Prisma.Decimal, bills: Array<{ id: string; billNumber: string; balance: Prisma.Decimal }>): { pays: Allocation[]; credit: Prisma.Decimal } {
+  let left = amount;
+  const pays: Allocation[] = [];
+  for (const bill of bills) {
+    if (!left.greaterThan(0)) break;
+    const take = left.lessThan(bill.balance) ? left : bill.balance;
+    pays.push({ billId: bill.id, billNumber: bill.billNumber, amount: take });
+    left = left.minus(take);
+  }
+  return { pays, credit: left.greaterThan(0) ? left : ZERO };
+}
+
+/** "INV-88120, INV-88504, oldest first"; a credit is named after them; nothing to pay is all credit. */
+export function paysSentence(pays: Allocation[], credit: Prisma.Decimal, currency = "USD"): string {
+  const held = `${formatMoney(toNumberOrZero(credit), currency)} held as credit`;
+  if (pays.length === 0) return credit.greaterThan(0) ? `No bills to pay: ${held}` : "No bills to pay";
+  const bills = `${pays.map((pay) => pay.billNumber).join(", ")}${pays.length > 1 ? ", oldest first" : ""}`;
+  return credit.greaterThan(0) ? `${bills}; ${held}` : bills;
+}
+
+/**
+ * What a supplier owes now: Σ balances of their bills not in the bin, less
+ * the credits they hold (payment rows with no bill). Return credits join
+ * with returns (BUY-09).
+ */
+export async function supplierOwed(client: Client, companyId: string, vendorId: string): Promise<Prisma.Decimal> {
+  const [bills, credits] = await Promise.all([
+    client.purchaseBill.findMany({
+      where: { companyId, vendorId, archivedAt: null, status: { notIn: ["DRAFT", "VOIDED"] } },
+      select: { total: true, amountPaid: true, debitNoteTotal: true, writeOffTotal: true },
+    }),
+    client.purchasePayment.findMany({ where: { companyId, vendorId, billId: null }, select: { amount: true } }),
+  ]);
+  const balances = sumMoney(bills.map((bill) => money(bill.total).minus(money(bill.amountPaid)).minus(money(bill.debitNoteTotal)).minus(money(bill.writeOffTotal))));
+  return balances.minus(sumMoney(credits.map((row) => money(row.amount))));
+}
+
+export type PaymentPreview = {
+  owed: number;
+  pays: Array<{ billId: string; billNumber: string; amount: number }>;
+  credit: number;
+  sentence: string;
+};
+
+function parseAmount(value: string | number | null | undefined): Prisma.Decimal | null {
+  const text = typeof value === "number" ? String(value) : (value ?? "").replace(/,/g, "").replace(/^US\$/, "").trim();
+  if (!text || !/^\d+(\.\d+)?$/.test(text)) return null;
+  return money(text);
+}
+
+async function supplierOf(client: Client, companyId: string, supplierId: string) {
+  const vendor = await client.vendor.findFirst({ where: { id: supplierId, companyId }, select: { id: true, name: true } });
+  if (!vendor) throw new BillRefusal(404, "Supplier not found");
+  return vendor;
+}
+
+/** What a payment of `amount` would pay (the Pays row, live): exactly what recording it writes. */
+export async function previewPayment(
+  companyId: string,
+  input: { supplierId: string; amount?: string | number | null; billId?: string | null },
+): Promise<PaymentPreview> {
+  await supplierOf(prisma, companyId, input.supplierId);
+  const [bills, owed] = await Promise.all([unpaidBills(prisma, companyId, input.supplierId, input.billId), supplierOwed(prisma, companyId, input.supplierId)]);
+  const amount = parseAmount(input.amount ?? "") ?? ZERO;
+  const { pays, credit } = allocate(amount, bills);
+  return {
+    owed: toNumberOrZero(owed),
+    pays: pays.map((pay) => ({ billId: pay.billId, billNumber: pay.billNumber, amount: toNumberOrZero(pay.amount) })),
+    credit: toNumberOrZero(credit),
+    sentence: paysSentence(pays, credit, bills[0]?.currency ?? "USD"),
+  };
+}
+
+export type PaymentInput = {
+  supplierId: string;
+  amount: string | number;
+  paidOn: string;
+  how: string;
+  fromId: string;
+  reference?: string | null;
+  firstBillId?: string | null;
+};
+
+export type PaymentDone = {
+  groupNo: string;
+  rows: Array<{ paymentNumber: string; billNumber: string | null; amount: number }>;
+  owedAfter: number;
+  message: string;
+  accountingStatus: AccountingResult["accountingStatus"];
+};
+
+/** "US$624.00 paid to Delta Beverages. Nothing owed." / "… US$120.00 still owed." / "… US$40.00 held as credit." */
+export function paidWords(amount: Prisma.Decimal, supplier: string, owedAfter: Prisma.Decimal, currency = "USD"): string {
+  const head = `${formatMoney(toNumberOrZero(amount), currency)} paid to ${supplier}.`;
+  if (owedAfter.isZero()) return `${head} Nothing owed.`;
+  return owedAfter.greaterThan(0)
+    ? `${head} ${formatMoney(toNumberOrZero(owedAfter), currency)} still owed.`
+    : `${head} ${formatMoney(toNumberOrZero(owedAfter.abs()), currency)} held as credit.`;
+}
+
+export async function recordSupplierPayment(actor: RetailAuditActor, input: PaymentInput, deps: { now?: Date } = {}): Promise<PaymentDone> {
+  const now = deps.now ?? new Date();
+  const companyId = actor.companyId;
+  const vendor = await supplierOf(prisma, companyId, input.supplierId);
+  const amount = parseAmount(input.amount);
+  if (!amount || !amount.greaterThan(0)) throw invalid({ amt: "Write an amount." });
+  const today = dayKey(now);
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(input.paidOn ?? "")) throw invalid({ date: "Choose the day it was paid." });
+  if (input.paidOn > today) throw invalid({ date: "A payment cannot be dated after today." });
+  const how = PAYMENT_HOW.find((word) => word === input.how);
+  if (!how) throw invalid({ how: "Choose how it was paid." });
+  const reference = input.reference?.replace(/\s+/g, " ").trim() || null;
+  if (reference && reference.length > 80) throw invalid({ ref: "Keep the reference to 80 characters." });
+  if (how !== "Cash" && !reference) throw invalid({ ref: "Add the reference." });
+  const from = input.fromId ? await findMoneyAccount(companyId, input.fromId) : null;
+  if (!from) throw invalid({ from: "Choose where the money comes from." });
+  const billCurrency = (await unpaidBills(prisma, companyId, vendor.id))[0]?.currency ?? "USD";
+  if (from.currency.toUpperCase() !== billCurrency.toUpperCase()) throw invalid({ from: `${from.name} holds ${currencyWords(from.currency)}.` });
+  const paidAt = input.paidOn === today ? now : startOfDayIn(input.paidOn, DEFAULT_TIME_ZONE);
+
+  let done: Omit<PaymentDone, "accountingStatus" | "message"> | null = null;
+  for (let attempt = 0; ; attempt += 1) {
+    try {
+      done = await prisma.$transaction(async (tx) => {
+        // The account's row first: a second payment from it waits here, then reads the balance this one left.
+        await tx.$queryRaw`SELECT "id" FROM "BankAccount" WHERE "id" = ${from.id} FOR UPDATE`;
+        await lockSupplier(tx, vendor.id);
+        if (from.kind === "CASH") {
+          const balance = await moneyAccountBalance(from.id, tx);
+          if (amount.greaterThan(balance)) {
+            const has = `${from.name} has ${formatMoney(toNumberOrZero(balance), from.currency)}.`;
+            throw new BillRefusal(409, has, { from: has });
+          }
+        }
+        const bills = await unpaidBills(tx, companyId, vendor.id, input.firstBillId);
+        const { pays, credit } = allocate(amount, bills);
+        const groupNo = await reserveIdentifier(tx, { companyId, entity: "RETAIL_SUPPLIER_PAYMENT" });
+        const rows: Array<{ paymentNumber: string; billId: string | null; billNumber: string | null; amount: Prisma.Decimal }> = [
+          ...pays.map((pay, index) => ({ paymentNumber: `${groupNo}/${index + 1}`, billId: pay.billId, billNumber: pay.billNumber, amount: pay.amount })),
+          ...(credit.greaterThan(0) ? [{ paymentNumber: `${groupNo}/${pays.length + 1}`, billId: null, billNumber: null, amount: credit }] : []),
+        ];
+        for (const row of rows) {
+          await tx.purchasePayment.create({
+            data: {
+              companyId,
+              billId: row.billId,
+              vendorId: vendor.id,
+              groupNo,
+              paymentNumber: row.paymentNumber,
+              paidAt,
+              amount: toNumberOrZero(row.amount),
+              method: how,
+              reference,
+              bankAccountId: from.id,
+              createdById: actor.userId,
+            },
+          });
+        }
+        for (const pay of pays) await recalcPurchaseBillBalance(pay.billId, tx);
+        await tx.bankTransaction.create({
+          data: {
+            companyId,
+            bankAccountId: from.id,
+            txnDate: paidAt,
+            description: `${groupNo} · ${vendor.name}`,
+            reference,
+            amount: toNumberOrZero(amount),
+            direction: "CREDIT",
+            sourceType: "RETAIL_SUPPLIER_PAYMENT",
+            sourceId: groupNo,
+          },
+        });
+        const payload = { groupNo, amount: auditAmount(amount), currency: from.currency, from: from.name, how, reference, bills: pays.map((pay) => pay.billNumber) };
+        await writeRetailAuditEvent(tx, { actor, eventType: RETAIL_AUDIT_EVENTS.supplierPaid, entityType: "Vendor", entityId: vendor.id, payload });
+        for (const pay of pays) {
+          await writeRetailAuditEvent(tx, { actor, eventType: RETAIL_AUDIT_EVENTS.supplierPaid, entityType: "PurchaseBill", entityId: pay.billId, payload });
+        }
+        const owedAfter = await supplierOwed(tx, companyId, vendor.id);
+        return {
+          groupNo,
+          rows: rows.map((row) => ({ paymentNumber: row.paymentNumber, billNumber: row.billNumber, amount: toNumberOrZero(row.amount) })),
+          owedAfter: toNumberOrZero(owedAfter),
+        };
+      });
+      break;
+    } catch (error) {
+      if (attempt < 4 && error instanceof Prisma.PrismaClientKnownRequestError && error.code === "P2002") continue;
+      throw error;
+    }
+  }
+  const paid = done!;
+  const accounting = await postSupplierPayment(companyId, paid.groupNo, { userId: actor.userId, userRole: actor.userRole });
+  return { ...paid, message: paidWords(amount, vendor.name, money(paid.owedAfter), from.currency), accountingStatus: accounting.accountingStatus };
+}
