+import { NextRequest, NextResponse } from "next/server";
+
+import { fieldErrorResponse } from "@/lib/api-response";
+import { billIssues, exportSchema } from "@/lib/retail/buying/bill-input";
+import { billsWorkbook } from "@/lib/retail/buying/bill-export";
+import { buyingActor, buyingFailure } from "@/lib/retail/buying/routes";
+import { requireRetailPermission } from "@/lib/retail/permissions";
+
+import { requireRetailSession } from "../../../_helpers";
+
+/** "Export for the bookkeeper": the ticked bills and their payments as an `.xlsx`. */
+export async function POST(request: NextRequest) {
+  const { response, session } = await requireRetailSession(request);
+  if (response || !session) return response as NextResponse;
+  const gate = requireRetailPermission(session, "retail.bills", "view");
+  if (gate) return gate;
+  const parsed = exportSchema.safeParse(await request.json().catch(() => ({})));
+  if (!parsed.success) return fieldErrorResponse("Validation failed", billIssues(parsed.error));
+  try {
+    const { bytes } = await billsWorkbook(buyingActor(session), parsed.data.ids);
+    return new NextResponse(new Uint8Array(bytes), {
+      headers: {
+        "Content-Type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+        "Content-Disposition": 'attachment; filename="bills-for-the-bookkeeper.xlsx"',
+      },
+    });
+  } catch (error) {
+    return buyingFailure(error, "POST /api/v2/retail/buying/bills/export");
+  }
+}
