+}
+
+/* ── The bin (W-63, kind `bill`) ────────────────────────────────────────── */
+
+/** "US$100.00 has been paid against INV-88120. It cannot go to the bin." — null when nothing is paid. */
+export function binRefusalFor(bill: { billNumber: string; amountPaid: number; currency: string }): string | null {
+  const paid = money(bill.amountPaid);
+  return paid.greaterThan(0) ? `${formatMoney(toNumberOrZero(paid), bill.currency)} has been paid against ${bill.billNumber}. It cannot go to the bin.` : null;
+}
+
+/** Overdue: not in the bin, something owed, due before today in Harare. The "1 overdue" badge. */
+export async function countOverdueBills(companyId: string, now: Date = new Date()): Promise<number> {
+  const today = dayStart(dayKey(now, DEFAULT_TIME_ZONE));
+  const bills = await prisma.purchaseBill.findMany({
+    where: { companyId, archivedAt: null, status: { notIn: ["DRAFT", "VOIDED", "PAID"] }, dueDate: { lt: today } },
+    select: { total: true, amountPaid: true, debitNoteTotal: true, writeOffTotal: true },
+  });
+  return bills.filter((bill) => money(bill.total).minus(money(bill.amountPaid)).minus(money(bill.debitNoteTotal)).minus(money(bill.writeOffTotal)).greaterThan(0)).length;
+}
