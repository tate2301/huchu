+import { NextRequest, NextResponse } from "next/server";
+
+import { fieldErrorResponse, successResponse } from "@/lib/api-response";
+import { billIssues, paymentSchema } from "@/lib/retail/buying/bill-input";
+import { recordSupplierPayment } from "@/lib/retail/buying/payments";
+import { buyingActor, buyingFailure } from "@/lib/retail/buying/routes";
+import { requireRetailPermission } from "@/lib/retail/permissions";
+
+import { requireRetailSession } from "../../_helpers";
+
+/** Pay a supplier from a money account: the named bill first, then the oldest; anything over is credit (W-35 "Record payment"). */
+export async function POST(request: NextRequest) {
+  const { response, session } = await requireRetailSession(request);
+  if (response || !session) return response as NextResponse;
+  const gate = requireRetailPermission(session, "retail.bills", "create");
+  if (gate) return gate;
+  const parsed = paymentSchema.safeParse(await request.json().catch(() => ({})));
+  if (!parsed.success) return fieldErrorResponse("Validation failed", billIssues(parsed.error));
+  try {
+    const done = await recordSupplierPayment(buyingActor(session), parsed.data);
+    return successResponse(
+      { data: { groupNo: done.groupNo, rows: done.rows, owedAfter: done.owedAfter }, accountingStatus: done.accountingStatus, message: done.message },
+      201,
+    );
+  } catch (error) {
+    return buyingFailure(error, "POST /api/v2/retail/buying/payments");
+  }
+}
