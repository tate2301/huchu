+/**
+ * A supplier's bill (BUY-07): against its delivery Dr 2300 GRNI at the
+ * delivery's value, Dr 2210 VAT input, the price difference Dr or Cr 5000,
+ * Cr 2000 the amount; with no delivery Dr 5000 the net, Dr 2210 VAT, Cr 2000.
+ * One event carries every amount (`amounts`); each rule line reads its own,
+ * and a line of nought is left off. `key` is the bill's id the first time,
+ * then a key of its own for each change or restore (the earlier entry is
+ * reversed first, inside that change's transaction).
+ */
+export async function postSupplierBill(companyId: string, billId: string, key: string, by: PostedBy): Promise<AccountingResult> {
+  const bill = await prisma.purchaseBill.findFirstOrThrow({
+    where: { id: billId, companyId },
+    select: {
+      billNumber: true,
+      billDate: true,
+      currency: true,
+      total: true,
+      taxTotal: true,
+      subTotal: true,
+      goodsReceiptId: true,
+      goodsReceipt: { select: { siteId: true, receiptNo: true } },
+      vendor: { select: { name: true } },
+    },
+  });
+  const delivery = bill.goodsReceiptId ? await deliveryFigures(prisma, bill.goodsReceiptId) : null;
+  // The VAT and the net are the bill's own, as recorded.
+  const tax = money(bill.taxTotal);
+  const net = money(bill.total).minus(tax);
+  const grni = delivery ? delivery.value : money(0);
+  const figures = {
+    amount: toNumberOrZero(money(bill.total)),
+    net: toNumberOrZero(net),
+    tax: toNumberOrZero(tax),
+    grni: toNumberOrZero(grni),
+    priceOver: delivery ? toNumberOrZero(net.greaterThan(grni) ? net.minus(grni) : money(0)) : 0,
+    priceUnder: delivery ? toNumberOrZero(grni.greaterThan(net) ? grni.minus(net) : money(0)) : 0,
+  };
+  return postRetailJournal({
+    companyId,
+    sourceType: "RETAIL_SUPPLIER_BILL",
+    sourceId: key,
+    sourceSubtype: delivery ? "DELIVERY" : "NO_DELIVERY",
+    siteId: bill.goodsReceipt?.siteId ?? null,
+    entryDate: bill.billDate,
+    description: `${bill.billNumber} · ${bill.vendor.name}`,
+    createdById: by.userId,
+    actorRole: by.userRole ?? null,
+    amount: figures.amount,
+    netAmount: figures.net,
+    grossAmount: figures.amount,
+    taxAmount: figures.tax,
+    currency: bill.currency,
+    payload: { billNumber: bill.billNumber, delivery: bill.goodsReceipt?.receiptNo ?? null, amounts: figures },
+  });
+}
