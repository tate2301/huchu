diff --git a/lib/retail/buying/bill-export.ts b/lib/retail/buying/bill-export.ts
new file mode 100644
index 00000000..8a327ff4
--- /dev/null
+++ b/lib/retail/buying/bill-export.ts
@@ -0,0 +1,100 @@
+import ExcelJS from "exceljs";
+
+import { money, toNumberOrZero } from "@/lib/money";
+import { prisma } from "@/lib/prisma";
+import { auditExportDownloaded, type RetailAuditActor } from "@/lib/retail/audit";
+import { dayKey } from "@/lib/workspace/format";
+
+
+/**
+ * "Export for the bookkeeper" (W-35): the ticked bills as a workbook with two
+ * sheets: "Bills" (each with its supplier's VAT number, its delivery, net,
+ * VAT, amount, paid, owed and the ledger entry it posted as) and "Payments"
+ * (every payment row against them). Days are shop days; money is numbers to
+ * the cent, so the bookkeeper's spreadsheet adds them up.
+ */
+
+const BILL_COLUMNS = ["Bill", "Supplier", "Supplier VAT number", "Delivery", "Billed", "Due", "Net", "VAT", "Amount", "Paid", "Owed", "Ledger entry"];
+const PAYMENT_COLUMNS = ["Payment", "Bill", "Paid on", "Paid by", "From", "Reference", "Amount"];
+
+export async function billsWorkbook(actor: RetailAuditActor, ids: string[]): Promise<{ bytes: Buffer; rows: number }> {
+  const companyId = actor.companyId;
+  const bills = await prisma.purchaseBill.findMany({
+    where: { companyId, id: { in: ids }, archivedAt: null },
+    orderBy: [{ dueDate: "asc" }, { billNumber: "asc" }],
+    select: {
+      id: true,
+      billNumber: true,
+      billDate: true,
+      dueDate: true,
+      subTotal: true,
+      taxTotal: true,
+      total: true,
+      amountPaid: true,
+      debitNoteTotal: true,
+      writeOffTotal: true,
+      goodsReceiptId: true,
+      vendor: { select: { name: true, vatNumber: true } },
+      goodsReceipt: { select: { receiptNo: true } },
+      payments: {
+        orderBy: { paymentNumber: "asc" },
+        select: { paymentNumber: true, paidAt: true, method: true, reference: true, amount: true, bankAccount: { select: { name: true } } },
+      },
+    },
+  });
+  const entries = await prisma.journalEntry.findMany({
+    where: { companyId, sourceType: "RETAIL_SUPPLIER_BILL", status: "POSTED", reversedAt: null, OR: bills.map((bill) => ({ sourceId: { startsWith: bill.id } })) },
+    select: { entryNumber: true, sourceId: true },
+  });
+  const entryOf = (billId: string) => entries.find((entry) => entry.sourceId?.startsWith(billId));
+
+  const workbook = new ExcelJS.Workbook();
+  const billSheet = workbook.addWorksheet("Bills");
+  billSheet.addRow(BILL_COLUMNS);
+  for (const bill of bills) {
+    const owed = money(bill.total).minus(money(bill.amountPaid)).minus(money(bill.debitNoteTotal)).minus(money(bill.writeOffTotal));
+    const entry = entryOf(bill.id);
+    billSheet.addRow([
+      bill.billNumber,
+      bill.vendor.name,
+      bill.vendor.vatNumber ?? "",
+      bill.goodsReceipt?.receiptNo ?? "No delivery",
+      dayKey(bill.billDate),
+      bill.dueDate ? dayKey(bill.dueDate) : "",
+      toNumberOrZero(money(bill.subTotal)),
+      toNumberOrZero(money(bill.taxTotal)),
+      toNumberOrZero(money(bill.total)),
+      toNumberOrZero(money(bill.amountPaid)),
+      toNumberOrZero(owed.greaterThan(0) ? owed : money(0)),
+      entry ? `JE-${entry.entryNumber}` : "Not posted yet",
+    ]);
+  }
+  const paymentSheet = workbook.addWorksheet("Payments");
+  paymentSheet.addRow(PAYMENT_COLUMNS);
+  let payments = 0;
+  for (const bill of bills) {
+    for (const payment of bill.payments) {
+      payments += 1;
+      paymentSheet.addRow([
+        payment.paymentNumber,
+        bill.billNumber,
+        dayKey(payment.paidAt),
+        payment.method,
+        payment.bankAccount?.name ?? "",
+        payment.reference ?? "",
+        toNumberOrZero(money(payment.amount)),
+      ]);
+    }
+  }
+  for (const sheet of [billSheet, paymentSheet]) {
+    sheet.getRow(1).font = { bold: true };
+    sheet.views = [{ state: "frozen", ySplit: 1 }];
+    sheet.columns.forEach((column) => {
+      column.width = 18;
+    });
+  }
+  for (const key of [7, 8, 9, 10, 11]) billSheet.getColumn(key).numFmt = "#,##0.00";
+  paymentSheet.getColumn(7).numFmt = "#,##0.00";
+  await auditExportDownloaded(prisma, { actor, key: "retail-bills-bookkeeper", format: "xlsx", rows: bills.length + payments });
+  return { bytes: Buffer.from(await workbook.xlsx.writeBuffer()), rows: bills.length };
+}
diff --git a/lib/retail/buying/bill-input.ts b/lib/retail/buying/bill-input.ts
new file mode 100644
index 00000000..47349963
--- /dev/null
+++ b/lib/retail/buying/bill-input.ts
@@ -0,0 +1,80 @@
+import { z } from "zod";
+
+import { parseDay } from "@/lib/workspace/format";
+
+/**
+ * The requests the bill and payment routes take (40-buying 4.6), as the
+ * sheets send them: money as a string with two decimals (or a number), days
+ * as shop days `YYYY-MM-DD` (or typed, "13 August 2026"), a file as the
+ * upload's whole answer.
+ */
+
+const day = z
+  .string()
+  .trim()
+  .transform((value, ctx) => {
+    const parsed = /^\d{4}-\d{2}-\d{2}$/.test(value) ? value : parseDay(value);
+    if (!parsed) {
+      ctx.addIssue({ code: "custom", message: "Write a date, like 13 August 2026." });
+      return z.NEVER;
+    }
+    return parsed;
+  });
+
+const amount = z.union([z.number(), z.string().trim().min(1, "Write the amount, like 216.00.")]);
+
+const file = z.object({
+  url: z.string().min(1),
+  name: z.string().trim().min(1).max(200),
+  contentType: z.string().trim().min(1).max(100),
+  size: z.number().int().positive(),
+});
+
+export const billSchema = z.object({
+  supplierId: z.string().uuid({ message: "Choose the supplier." }),
+  deliveryId: z.string().uuid().nullish(),
+  billNumber: z.string().max(200),
+  billDate: day,
+  amount,
+  dueDate: day.nullish(),
+  file: file.nullish(),
+});
+
+export const billPatchSchema = billSchema.partial().refine((patch) => Object.keys(patch).length > 0, "Change something first.");
+
+export const paymentSchema = z.object({
+  supplierId: z.string().uuid({ message: "Choose the supplier." }),
+  amount,
+  paidOn: day,
+  how: z.enum(["Cash", "Bank transfer", "EcoCash"], { message: "Choose how it was paid." }),
+  fromId: z.string().uuid({ message: "Choose where the money comes from." }),
+  reference: z.string().max(200).nullish(),
+  firstBillId: z.string().uuid().nullish(),
+});
+
+export const exportSchema = z.object({ ids: z.array(z.string().uuid()).min(1, "Tick at least one bill.").max(2000) });
+
+/** The request's keys as the bill and payment sheets' field ids (5.27–5.29). */
+const SHEET_FIELD: Record<string, string> = {
+  supplierId: "sup",
+  deliveryId: "grn",
+  billNumber: "no",
+  billDate: "date",
+  amount: "amt",
+  dueDate: "due",
+  file: "pdf",
+  paidOn: "date",
+  how: "how",
+  fromId: "from",
+  reference: "ref",
+};
+
+/** Zod's issues as the sheet's field errors, first message per field. */
+export function billIssues(error: z.ZodError): Record<string, string> {
+  const fields: Record<string, string> = {};
+  for (const issue of error.issues) {
+    const raw = String(issue.path[0] ?? "form");
+    fields[SHEET_FIELD[raw] ?? raw] ??= issue.message;
+  }
+  return fields;
+}
