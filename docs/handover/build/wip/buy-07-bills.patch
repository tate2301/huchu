+/* ── Bills (40-buying 3.2, BUY-07) ──────────────────────────────────────── */
+
+export type BillStateKey = "paid" | "overdue" | "today" | "soon" | "later";
+
+export type BillState = { key: BillStateKey; label: string; tone: "hollow" | "bad" | "warn" | "info" };
+
+/** Whole days from `today` to `due`, both shop days ("YYYY-MM-DD"): negative once past. */
+export function daysUntil(due: string, today: string): number {
+  return Math.round((Date.parse(`${due}T00:00:00Z`) - Date.parse(`${today}T00:00:00Z`)) / DAY_MS);
+}
+
+/**
+ * A bill's state: paid ("Paid in cash" when every payment row was cash, else
+ * "Paid") hollow; unpaid by its due day against today in Harare: "21 days
+ * overdue" bad, "Due today" and "Due tomorrow" warn, "Due in 3 days" warn up
+ * to a week, "Due in 23 days" info after.
+ */
+export function billState(bill: FigureBill & { paidInCash?: boolean }, now: Date): BillState {
+  if (!billBalance(bill).greaterThan(0)) return { key: "paid", label: bill.paidInCash ? "Paid in cash" : "Paid", tone: "hollow" };
+  if (!bill.dueDate) return { key: "later", label: "Not due", tone: "info" };
+  const days = daysUntil(dayKey(bill.dueDate), dayKey(now));
+  if (days < 0) return { key: "overdue", label: `${-days} ${days === -1 ? "day" : "days"} overdue`, tone: "bad" };
+  if (days === 0) return { key: "today", label: "Due today", tone: "warn" };
+  if (days === 1) return { key: "soon", label: "Due tomorrow", tone: "warn" };
+  if (days <= 7) return { key: "soon", label: `Due in ${days} days`, tone: "warn" };
+  return { key: "later", label: `Due in ${days} days`, tone: "info" };
+}
+
+/** Paid in cash: there are payments and every one was cash. */
+export function paidInCash(methods: string[]): boolean {
+  return methods.length > 0 && methods.every((method) => method.trim().toLowerCase() === "cash");
+}
+
+/**
+ * A bill's amounts (40-buying W-35): against a delivery its VAT is the
+ * delivery's share of the amount, round(amount × VAT ÷ (value + VAT)); with no
+ * delivery it is amount × r ÷ (100 + r) at the shop's rate when the supplier
+ * is registered for VAT, else nothing. What the net is over or under the
+ * delivery's value is a price difference. grni + tax + priceOver − priceUnder
+ * is the amount, to the cent.
+ */
+export function billAmounts(
+  amount: MoneyLike,
+  delivery: { value: MoneyLike; vat: MoneyLike } | null,
+  vatRate: MoneyLike,
+): { amount: Prisma.Decimal; grni: Prisma.Decimal; tax: Prisma.Decimal; net: Prisma.Decimal; priceOver: Prisma.Decimal; priceUnder: Prisma.Decimal } {
+  const total = money(amount);
+  if (delivery) {
+    const grni = money(delivery.value);
+    const vat = money(delivery.vat);
+    const base = grni.plus(vat);
+    const tax = base.greaterThan(0) ? money(total.times(vat).dividedBy(base)) : ZERO;
+    const net = total.minus(tax);
+    return {
+      amount: total,
+      grni,
+      tax,
+      net,
+      priceOver: net.greaterThan(grni) ? net.minus(grni) : ZERO,
+      priceUnder: grni.greaterThan(net) ? grni.minus(net) : ZERO,
+    };
+  }
+  const r = money(vatRate);
+  const tax = r.greaterThan(0) ? money(total.times(r).dividedBy(r.plus(100))) : ZERO;
+  return { amount: total, grni: ZERO, tax, net: total.minus(tax), priceOver: ZERO, priceUnder: ZERO };
+}
