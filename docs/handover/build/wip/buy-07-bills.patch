index 00000000..1b5f51fc
--- /dev/null
+++ b/lib/retail/buying/bill-view.ts
@@ -0,0 +1,144 @@
+import { money, toNumberOrZero } from "@/lib/money";
+import { prisma } from "@/lib/prisma";
+import { RETAIL_AUDIT_EVENTS, type RetailAuditActor } from "@/lib/retail/audit";
+import { canRetailRoleDo } from "@/lib/retail/permission-matrix";
+import { dayKey } from "@/lib/workspace/format";
+
+import { BILL_NOT_FOUND, BillRefusal, defaultDue, differenceHint, dueHint } from "./bills";
+import { deliveryFigures } from "./delivery-value";
+import { billBalance, billState, paidInCash, type BillState } from "./figures";
+import { dayMonth } from "./words";
+
+/**
+ * A bill as its sheet reads it (40-buying 4.6, 5.28): the bill has no record
+ * page, the `bill-edit` sheet is its record. "Changed by …" is the latest of
+ * its own events (recorded, a value changed, paid), else who recorded it.
+ */
+
+export type BillView = {
+  id: string;
+  billNumber: string;
+  supplier: { id: string; name: string };
+  delivery: { id: string; receiptNo: string; date: string; valueWithVat: number } | null;
+  billDate: string;
+  dueDate: string | null;
+  amount: number;
+  paid: number;
+  owed: number;
+  currency: string;
+  state: BillState;
+  binned: boolean;
+  file: { url: string; name: string; contentType: string; size: number; added: string } | null;
+  lastChange: string;
+  can: { update: boolean; pay: boolean; bin: boolean };
+};
+
+const CHANGE_EVENTS = [RETAIL_AUDIT_EVENTS.billRecorded, RETAIL_AUDIT_EVENTS.recordEdited, RETAIL_AUDIT_EVENTS.supplierPaid];
+
+/** "Changed by Tendai Mhlanga, 14 August." / "Recorded by Ruvimbo Chari, 13 August." */
+async function lastChange(companyId: string, billId: string, createdBy: string | null, createdAt: Date): Promise<string> {
+  const event = await prisma.platformAuditEvent.findFirst({
+    where: { companyId, entityType: "PurchaseBill", entityId: billId, eventType: { in: CHANGE_EVENTS } },
+    orderBy: [{ createdAt: "desc" }, { id: "desc" }],
+    select: { eventType: true, actor: true, payloadJson: true, createdAt: true },
+  });
+  let named: string | null = null;
+  try {
+    const payload = event?.payloadJson ? (JSON.parse(event.payloadJson) as Record<string, unknown>) : {};
+    named = typeof payload.actorName === "string" && payload.actorName ? payload.actorName : null;
+  } catch {
+    named = null;
+  }
+  const actorId = event?.actor ?? createdBy;
+  const who = named ?? (actorId ? ((await prisma.user.findFirst({ where: { id: actorId }, select: { name: true } }))?.name ?? null) : null) ?? "someone";
+  const changed = event && event.eventType !== RETAIL_AUDIT_EVENTS.billRecorded;
+  return `${changed ? "Changed" : "Recorded"} by ${who}, ${dayMonth(event?.createdAt ?? createdAt)}.`;
+}
+
+export async function billView(actor: RetailAuditActor, id: string, now = new Date()): Promise<BillView> {
+  const companyId = actor.companyId;
+  const bill = await prisma.purchaseBill.findFirst({
+    where: { id, companyId },
+    select: {
+      id: true,
+      billNumber: true,
+      billDate: true,
+      dueDate: true,
+      total: true,
+      amountPaid: true,
+      debitNoteTotal: true,
+      writeOffTotal: true,
+      currency: true,
+      archivedAt: true,
+      createdById: true,
+      createdAt: true,
+      vendor: { select: { id: true, name: true } },
+      goodsReceipt: { select: { id: true, receiptNo: true, createdAt: true } },
+      payments: { select: { method: true } },
+    },
+  });
+  if (!bill) throw new BillRefusal(404, BILL_NOT_FOUND);
+  const [file, delivery] = await Promise.all([
+    prisma.retailAttachment.findFirst({
+      where: { companyId, entityType: "PurchaseBill", entityId: id, kind: "BILL" },
+      orderBy: { createdAt: "desc" },
+      select: { url: true, name: true, contentType: true, size: true, createdAt: true },
+    }),
+    bill.goodsReceipt ? deliveryFigures(prisma, bill.goodsReceipt.id) : Promise.resolve(null),
+  ]);
+  const figure = { ...bill, binned: bill.archivedAt !== null, paidInCash: paidInCash(bill.payments.map((payment) => payment.method)) };
+  const owed = billBalance(figure);
+  const paid = money(bill.amountPaid);
+  const role = actor.userRole;
+  return {
+    id: bill.id,
+    billNumber: bill.billNumber,
+    supplier: bill.vendor,
+    delivery:
+      bill.goodsReceipt && delivery
+        ? {
+            id: bill.goodsReceipt.id,
+            receiptNo: bill.goodsReceipt.receiptNo,
+            date: dayKey(bill.goodsReceipt.createdAt),
+            valueWithVat: toNumberOrZero(delivery.value.plus(delivery.vat)),
+          }
+        : null,
+    billDate: dayKey(bill.billDate),
+    dueDate: bill.dueDate ? dayKey(bill.dueDate) : null,
+    amount: toNumberOrZero(money(bill.total)),
+    paid: toNumberOrZero(paid),
+    owed: toNumberOrZero(owed.greaterThan(0) ? owed : money(0)),
+    currency: bill.currency,
+    state: billState(figure, now),
+    binned: bill.archivedAt !== null,
+    file: file ? { url: file.url, name: file.name, contentType: file.contentType, size: file.size, added: file.createdAt.toISOString() } : null,
+    lastChange: await lastChange(companyId, bill.id, bill.createdById, bill.createdAt),
+    can: {
+      update: !bill.archivedAt && canRetailRoleDo(role, "retail.bills", "update"),
+      pay: !bill.archivedAt && owed.greaterThan(0) && canRetailRoleDo(role, "retail.bills", "create"),
+      bin: !bill.archivedAt && !paid.greaterThan(0) && canRetailRoleDo(role, "retail.bills", "delete"),
+    },
+  };
+}
+
+export type BillCompare = { deliveryValue: number; difference: number; hint: string | null; due: string; dueHint: string };
+
+/** The Record a bill sheet's live hints: the bill against the delivery's value with VAT, and its due day by the terms. */
+export async function compareBill(companyId: string, input: { deliveryId: string; amount?: string | null }): Promise<BillCompare> {
+  const receipt = await prisma.retailGoodsReceipt.findFirst({
+    where: { id: input.deliveryId, companyId },
+    select: { id: true, createdAt: true, vendor: { select: { payTermsDays: true } } },
+  });
+  if (!receipt) throw new BillRefusal(404, "Delivery not found");
+  const figures = await deliveryFigures(prisma, receipt.id);
+  const withVat = figures.value.plus(figures.vat);
+  const typed = (input.amount ?? "").replace(/,/g, "").trim();
+  const amount = /^\d+(\.\d+)?$/.test(typed) ? money(typed) : null;
+  return {
+    deliveryValue: toNumberOrZero(withVat),
+    difference: amount ? toNumberOrZero(amount.minus(withVat)) : 0,
+    hint: amount ? differenceHint(amount, withVat) : null,
+    due: defaultDue(dayKey(receipt.createdAt), receipt.vendor.payTermsDays),
+    dueHint: dueHint(receipt.vendor.payTermsDays, true),
+  };
+}
