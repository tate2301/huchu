+++ b/lib/retail/buying/bills-migration.test.ts
@@ -0,0 +1,62 @@
+/**
+ * Migration witness for `20261012090000_retail_bills` (BUY-07).
+ *
+ * A supplier's bill names the delivery it is for (one bill a delivery) and can
+ * go in the bin; its number is unique for the supplier, no longer for the
+ * whole company, so two suppliers can both send "INV-001"; bills are read by
+ * supplier and due date. A posting rule line can read one of several amounts
+ * the event names (`EVENT_AMOUNT`, by `eventAmountKey`), and a supplier's
+ * bill has its own source type on the books.
+ */
+import { describe, expect, it } from "vitest";
+
+import { prisma } from "@/lib/prisma";
+
+type ColumnFacts = { column_name: string; data_type: string; is_nullable: string };
+
+async function columns(table: string) {
+  const rows = await prisma.$queryRaw<ColumnFacts[]>`
+    SELECT column_name, data_type, is_nullable
+    FROM information_schema.columns
+    WHERE table_schema = 'public' AND table_name = ${table}`;
+  return new Map(rows.map((row) => [row.column_name, row]));
+}
+
+async function enumLabels(name: string) {
+  const rows = await prisma.$queryRaw<Array<{ label: string }>>`
+    SELECT e.enumlabel AS label
+    FROM pg_enum e JOIN pg_type t ON t.oid = e.enumtypid
+    JOIN pg_namespace n ON n.oid = t.typnamespace
+    WHERE t.typname = ${name} AND n.nspname = 'public'
+    ORDER BY e.enumsortorder`;
+  return rows.map((row) => row.label);
+}
+
+async function indexDef(table: string, name: string) {
+  const [row] = await prisma.$queryRaw<Array<{ indexdef: string }>>`
+    SELECT indexdef FROM pg_indexes WHERE schemaname = 'public' AND tablename = ${table} AND indexname = ${name}`;
+  return row?.indexdef ?? null;
+}
+
+describe("supplier bills, as stored", () => {
+  it("name the delivery they are for, once each, and can go in the bin", async () => {
+    const facts = await columns("PurchaseBill");
+    expect(facts.get("goodsReceiptId")).toMatchObject({ data_type: "text", is_nullable: "YES" });
+    expect(facts.get("archivedAt")).toMatchObject({ data_type: "timestamp without time zone", is_nullable: "YES" });
+    expect(await indexDef("PurchaseBill", "PurchaseBill_goodsReceiptId_key")).toMatch(/CREATE UNIQUE INDEX .*\("goodsReceiptId"\)/);
+  });
+
+  it("are numbered uniquely per supplier, not per company, and read by supplier and due date", async () => {
+    expect(await indexDef("PurchaseBill", "PurchaseBill_companyId_vendorId_billNumber_key")).toMatch(
+      /CREATE UNIQUE INDEX .*\("companyId", "vendorId", "billNumber"\)/,
+    );
+    expect(await indexDef("PurchaseBill", "PurchaseBill_companyId_billNumber_key")).toBeNull();
+    expect(await indexDef("PurchaseBill", "PurchaseBill_companyId_vendorId_dueDate_idx")).toContain('("companyId", "vendorId", "dueDate")');
+  });
+
+  it("post through their own source type, each line reading the amount the event names", async () => {
+    expect(await enumLabels("AccountingSourceType")).toContain("RETAIL_SUPPLIER_BILL");
+    expect(await enumLabels("PostingBasis")).toContain("EVENT_AMOUNT");
+    expect((await columns("PostingRuleLine")).get("eventAmountKey")).toMatchObject({ data_type: "text", is_nullable: "YES" });
+  });
+});
diff --git a/lib/retail/buying/bills.ts b/lib/retail/buying/bills.ts
new file mode 100644
index 00000000..544ed1fe
--- /dev/null
+++ b/lib/retail/buying/bills.ts
@@ -0,0 +1,529 @@
+import { Prisma } from "@prisma/client";
+
+import { recalcPurchaseBillBalance } from "@/lib/accounting/balances";
+import { JournalReversalError, reverseJournalEntry } from "@/lib/accounting/journals";
+import { money, toNumberOrZero, ZERO } from "@/lib/money";
+import { prisma } from "@/lib/prisma";
+import { auditAmount, auditRecordEdited, RETAIL_AUDIT_EVENTS, writeRetailAuditEvent, type RetailAuditActor } from "@/lib/retail/audit";
+import { STANDARD_VAT_RATE } from "@/lib/retail/category-words";
+import { startOfDayIn } from "@/lib/reports/list-query";
+import { dayKey, DEFAULT_TIME_ZONE, formatMoney } from "@/lib/workspace/format";
+
+import { AttachmentRefusal, recordAttachment, type UploadedFile } from "./attachments";
+import { deliveryFigures } from "./delivery-value";
+import { billAmounts } from "./figures";
+import { postSupplierBill, type AccountingResult } from "./posting";
+import { dayMonth } from "./words";
+
+/**
+ * A supplier's bills (40-buying W-35, BUY-07): recorded against the delivery
+ * it is for (or none), changed, moved to the bin and back. Money is worked
+ * in `Decimal` and stored rounded to the cent (the bill's columns are Float).
+ * The books follow after each commit: a bill posts `RETAIL_SUPPLIER_BILL`
+ * (Dr GRNI at the delivery's value, Dr VAT input, the price difference to
+ * cost of sales, Cr Accounts payable); a change or the bin reverses what is
+ * posted inside its own transaction, under the bill's row lock, so it is
+ * reversed once, and a change or a restore posts again under a key of its
+ * own. Credits the supplier holds (an overpayment, a requisition's cash) then
+ * settle the oldest unpaid bills.
+ */
+
+type Tx = Prisma.TransactionClient;
+type Client = Tx | typeof prisma;
+
+export class BillRefusal extends Error {
+  constructor(
+    readonly status: 400 | 403 | 404 | 409,
+    message: string,
+    readonly fieldErrors: Record<string, string> | null = null,
+  ) {
+    super(message);
+    this.name = "BillRefusal";
+  }
+}
+
+export const BILL_NOT_FOUND = "Bill not found";
+const invalid = (fieldErrors: Record<string, string>) => new BillRefusal(400, "Validation failed", fieldErrors);
+
+export type BillDeps = { now?: Date };
+
+export type BillInput = {
+  supplierId: string;
+  deliveryId?: string | null;
+  billNumber: string;
+  billDate: string;
+  amount: string | number;
+  dueDate?: string | null;
+  file?: UploadedFile | null;
+};
+
+/** "INV-88120": trimmed, single-spaced, 1–40 characters. */
+function cleanNumber(value: string): string {
+  return value.replace(/\s+/g, " ").trim();
+}
+
+function parseAmount(value: string | number | null | undefined): Prisma.Decimal | null {
+  const text = typeof value === "number" ? String(value) : (value ?? "").replace(/,/g, "").replace(/^US\$/, "").trim();
+  if (!text || !/^-?\d+(\.\d+)?$/.test(text)) return null;
+  return money(text);
+}
+
+/** A shop day's start in Harare: what a bill's dates are stored as. */
+const dayStart = (day: string) => startOfDayIn(day, DEFAULT_TIME_ZONE);
+const isDay = (value: string | null | undefined): value is string => typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value);
+const addDays = (day: string, days: number) => dayKey(new Date(Date.parse(`${day}T12:00:00Z`) + days * 86_400_000), "UTC");
+
+/** "30 days from delivery." / "On delivery." / "14 days from the bill.": what the default due day is. */
+export function dueHint(payTermsDays: number | null, fromDelivery: boolean): string {
+  if (!payTermsDays) return "On delivery.";
+  return `${payTermsDays} ${payTermsDays === 1 ? "day" : "days"} from ${fromDelivery ? "delivery" : "the bill"}.`;
+}
+
+/** The due day by the supplier's terms: the delivery's day (or the bill's) plus their days. */
+export function defaultDue(from: string, payTermsDays: number | null): string {
+  return addDays(from, payTermsDays ?? 0);
+}
+
+/**
+ * The shop's standard VAT rate: the rate most of its live products are sold
+ * at (15.5 on the demo), else the standard 15. A supplier with no VAT
+ * number charges none.
+ */
+export async function shopVatRate(companyId: string, client: Client = prisma): Promise<Prisma.Decimal> {
+  const tallies = await client.product.groupBy({
+    by: ["defaultTaxRate"],
+    where: { companyId, archivedAt: null, isActive: true },
+    _count: { _all: true },
+  });
+  const top = tallies.sort((a, b) => b._count._all - a._count._all || Number(b.defaultTaxRate) - Number(a.defaultTaxRate))[0];
+  return top ? money(top.defaultTaxRate) : money(STANDARD_VAT_RATE);
+}
+
+/** "US$1.20 more than the delivery. Accept it, or ask for a credit." / "US$1.20 less than the delivery." / null when equal. */
+export function differenceHint(amount: Prisma.Decimal, valueWithVat: Prisma.Decimal, currency = "USD"): string | null {
+  const difference = amount.minus(valueWithVat);
+  if (difference.isZero()) return null;
+  const figure = formatMoney(toNumberOrZero(difference.abs()), currency);
+  return difference.greaterThan(0) ? `${figure} more than the delivery. Accept it, or ask for a credit.` : `${figure} less than the delivery.`;
+}
+
+/* ── The delivery a bill is for ─────────────────────────────────────────── */
+
+type Delivery = { id: string; receiptNo: string; siteId: string; createdAt: Date };
+
+/** The delivery a bill names: this supplier's, posted, and not billed by another live bill. */
+async function checkDelivery(client: Client, companyId: string, vendorId: string, deliveryId: string, exceptBillId?: string): Promise<Delivery> {
+  const receipt = await client.retailGoodsReceipt.findFirst({
+    where: { id: deliveryId, companyId },
+    select: { id: true, receiptNo: true, siteId: true, createdAt: true, vendorId: true, status: true, bill: { select: { id: true, billNumber: true, archivedAt: true } } },
+  });
+  if (!receipt) throw new BillRefusal(404, "Delivery not found");
+  if (receipt.vendorId !== vendorId) throw invalid({ grn: `${receipt.receiptNo} came from another supplier.` });
+  if (receipt.status !== "POSTED") throw invalid({ grn: `${receipt.receiptNo} is not in stock yet. Post it first.` });
+  if (receipt.bill && receipt.bill.id !== exceptBillId) {
+    throw new BillRefusal(
+      409,
+      receipt.bill.archivedAt
+        ? `${receipt.receiptNo} has bill ${receipt.bill.billNumber} in the bin. Restore it, or delete it for good first.`
+        : `${receipt.receiptNo} already has bill ${receipt.bill.billNumber}.`,
+    );
+  }
+  return receipt;
+}
+
+/* ── What the bill posts ────────────────────────────────────────────────── */
+
+/**
+ * Reverses what a bill has on the books, inside the caller's transaction:
+ * every posted entry of it not yet reversed, and any posting still waiting
+ * (a shop that posts at the end of the day) is dropped so it never posts.
+ * Under the bill's row lock, so a second change waits and finds it done.
+ */
+export async function unbookBill(tx: Tx, actor: RetailAuditActor, bill: { id: string; billNumber: string }, at: Date, why: string): Promise<void> {
+  const keys = { companyId: actor.companyId, sourceType: "RETAIL_SUPPLIER_BILL" as const, sourceId: { startsWith: bill.id } };
+  const posted = await tx.journalEntry.findMany({ where: { ...keys, status: "POSTED", reversedAt: null, reversalOfEntryId: null }, select: { id: true } });
+  for (const entry of posted) {
+    try {
+      await reverseJournalEntry(tx, { companyId: actor.companyId, entryId: entry.id, actorId: actor.userId, actorRole: actor.userRole ?? null, reversalDate: at, reason: `${bill.billNumber} ${why}` });
+    } catch (error) {
+      if (error instanceof JournalReversalError) throw new BillRefusal(409, `${bill.billNumber} is in a closed period: ${error.message}.`);
+      throw error;
+    }
+  }
+  await tx.accountingIntegrationEvent.updateMany({
+    where: { ...keys, status: { in: ["PENDING", "FAILED"] } },
+    data: { status: "IGNORED", lastError: `${bill.billNumber} ${why}` },
+  });
+}
+
+/** The key a bill posts under: its id the first time, then one per change or restore. */
+export const billPostingKey = (billId: string, at?: Date) => (at ? `${billId}:${at.getTime()}` : billId);
+
+/* ── Credits the supplier holds ─────────────────────────────────────────── */
+
+/** "PAY-0019/3": the next row number of a payment group. */
+async function nextRowNumber(tx: Tx, companyId: string, groupNo: string): Promise<string> {
+  const rows = await tx.purchasePayment.findMany({ where: { companyId, groupNo }, select: { paymentNumber: true } });
+  const highest = rows.reduce((max, row) => Math.max(max, Number(/\/(\d+)$/.exec(row.paymentNumber)?.[1] ?? 0)), 0);
+  return `${groupNo}/${highest + 1}`;
+}
+
+/** Unpaid bills of a supplier, not in the bin, the named one first then by due day (oldest first). */
+export async function unpaidBills(client: Client, companyId: string, vendorId: string, firstBillId?: string | null) {
+  const bills = await client.purchaseBill.findMany({
+    where: { companyId, vendorId, archivedAt: null, status: { notIn: ["DRAFT", "VOIDED", "PAID"] } },
+    orderBy: [{ dueDate: "asc" }, { billDate: "asc" }, { billNumber: "asc" }],
+    select: { id: true, billNumber: true, total: true, amountPaid: true, debitNoteTotal: true, writeOffTotal: true, currency: true },
+  });
+  const open = bills
+    .map((bill) => ({ ...bill, balance: money(bill.total).minus(money(bill.amountPaid)).minus(money(bill.debitNoteTotal)).minus(money(bill.writeOffTotal)) }))
+    .filter((bill) => bill.balance.greaterThan(0));
+  const named = firstBillId ? open.find((bill) => bill.id === firstBillId) : undefined;
+  return named ? [named, ...open.filter((bill) => bill.id !== named.id)] : open;
+}
+
+/** Locks a supplier's row: one allocation of their money at a time. */
+export async function lockSupplier(tx: Tx, vendorId: string): Promise<void> {
+  await tx.$queryRaw`SELECT "id" FROM "Vendor" WHERE "id" = ${vendorId} FOR UPDATE`;
+}
+
+/**
+ * Credits a supplier holds (payment rows with no bill: an overpayment, a
+ * requisition's cash) settle their unpaid bills, oldest due first, never past
+ * a bill's balance. A credit that pays one bill whole moves onto it; one
+ * that is split leaves its rest as a credit and the part that pays becomes
+ * a row of the same payment ("PAY-0019/2"). No ledger entry: the money
+ * already went to Accounts payable when it was paid.
+ */
+export async function applySupplierCredits(tx: Tx, companyId: string, vendorId: string): Promise<string[]> {
+  await lockSupplier(tx, vendorId);
+  const credits = await tx.purchasePayment.findMany({
+    where: { companyId, vendorId, billId: null, amount: { gt: 0 } },
+    orderBy: [{ paidAt: "asc" }, { createdAt: "asc" }],
+  });
+  if (credits.length === 0) return [];
+  const bills = await unpaidBills(tx, companyId, vendorId);
+  const touched = new Set<string>();
+  let b = 0;
+  for (const credit of credits) {
+    let left = money(credit.amount);
+    while (left.greaterThan(0) && b < bills.length) {
+      const bill = bills[b]!;
+      const take = left.lessThan(bill.balance) ? left : bill.balance;
+      if (take.equals(left)) {
+        if (left.equals(money(credit.amount))) {
+          await tx.purchasePayment.update({ where: { id: credit.id }, data: { billId: bill.id } });
+        } else {
+          await tx.purchasePayment.update({ where: { id: credit.id }, data: { billId: bill.id, amount: toNumberOrZero(take) } });
+        }
+      } else {
+        const group = credit.groupNo ?? credit.paymentNumber.replace(/\/\d+$/, "");
+        await tx.purchasePayment.create({
+          data: {
+            companyId,
+            billId: bill.id,
+            vendorId,
+            groupNo: credit.groupNo ?? group,
+            paymentNumber: await nextRowNumber(tx, companyId, group),
+            requisitionId: credit.requisitionId,
+            paidAt: credit.paidAt,
+            amount: toNumberOrZero(take),
+            method: credit.method,
+            reference: credit.reference,
+            bankAccountId: credit.bankAccountId,
+            createdById: credit.createdById,
+          },
+        });
+        await tx.purchasePayment.update({ where: { id: credit.id }, data: { amount: toNumberOrZero(left.minus(take)) } });
+      }
+      bill.balance = bill.balance.minus(take);
+      left = left.minus(take);
+      touched.add(bill.id);
+      if (!bill.balance.greaterThan(0)) b += 1;
+    }
+    if (b >= bills.length) break;
+  }
+  for (const id of touched) await recalcPurchaseBillBalance(id, tx);
+  return [...touched];
+}
+
+/** Credits settled in a transaction of their own, after a bill is recorded or grows. */
+export async function settleSupplierCredits(companyId: string, vendorId: string): Promise<string[]> {
+  return prisma.$transaction((tx) => applySupplierCredits(tx, companyId, vendorId));
+}
+
+/* ── Record a bill (W-35 "Match to the delivery") ───────────────────────── */
+
+export type BillDone = { id: string; billNumber: string; message: string; accountingStatus: AccountingResult["accountingStatus"] };
+
+type Checked = {
+  vendor: { id: string; name: string; vatNumber: string | null; payTermsDays: number | null };
+  delivery: Delivery | null;
+  billNumber: string;
+  billDate: string;
+  dueDate: string;
+  amount: Prisma.Decimal;
+};
+
+async function checkInput(
+  client: Client,
+  actor: RetailAuditActor,
+  input: Omit<BillInput, "file">,
+  now: Date,
+  exceptBillId?: string,
+): Promise<Checked> {
+  const companyId = actor.companyId;
+  const vendor = input.supplierId
+    ? await client.vendor.findFirst({ where: { id: input.supplierId, companyId }, select: { id: true, name: true, vatNumber: true, payTermsDays: true } })
+    : null;
+  if (!vendor) throw invalid({ sup: "Choose the supplier." });
+  const billNumber = cleanNumber(input.billNumber ?? "");
+  if (!billNumber) throw invalid({ no: "Write the bill number." });
+  if (billNumber.length > 40) throw invalid({ no: "Keep the bill number to 40 characters." });
+  const amount = parseAmount(input.amount);
+  if (!amount || !amount.greaterThan(0)) throw invalid({ amt: "Write the amount on the bill." });
+  const today = dayKey(now);
+  if (!isDay(input.billDate)) throw invalid({ date: "Choose the bill date." });
+  if (input.billDate > today) throw invalid({ date: "A bill cannot be dated after today." });
+  const delivery = input.deliveryId ? await checkDelivery(client, companyId, vendor.id, input.deliveryId, exceptBillId) : null;
+  const dueDate = input.dueDate ? input.dueDate : defaultDue(delivery ? dayKey(delivery.createdAt) : input.billDate, vendor.payTermsDays);
+  if (!isDay(dueDate)) throw invalid({ due: "Choose when it is due." });
+  if (dueDate < input.billDate) throw invalid({ due: "It is due before it was billed." });
+  const clash = await client.purchaseBill.findFirst({
+    where: { companyId, vendorId: vendor.id, billNumber, ...(exceptBillId ? { id: { not: exceptBillId } } : {}) },
+    select: { id: true },
+  });
+  if (clash) throw new BillRefusal(409, `${vendor.name} already sent ${billNumber}.`, { no: `${vendor.name} already sent ${billNumber}.` });
+  return { vendor, delivery, billNumber, billDate: input.billDate, dueDate, amount };
+}
+
+/** What the bill's figures and its one line are, from the amount and the delivery. */
+async function figuresFor(client: Client, companyId: string, checked: Checked) {
+  const delivery = checked.delivery ? await deliveryFigures(client, checked.delivery.id) : null;
+  const rate = delivery ? delivery.rate : checked.vendor.vatNumber ? await shopVatRate(companyId, client) : ZERO;
+  const amounts = billAmounts(checked.amount, delivery ? { value: delivery.value, vat: delivery.vat } : null, rate);
+  return {
+    amounts,
+    bill: { subTotal: toNumberOrZero(amounts.net), taxTotal: toNumberOrZero(amounts.tax), total: toNumberOrZero(amounts.amount) },
+    line: {
+      description: checked.delivery ? `Delivery ${checked.delivery.receiptNo}` : `Bill ${checked.billNumber}`,
+      quantity: 1,
+      unitPrice: toNumberOrZero(amounts.net),
+      taxRate: toNumberOrZero(rate),
+      taxAmount: toNumberOrZero(amounts.tax),
+      lineTotal: toNumberOrZero(amounts.net),
+    },
+  };
+}
+
+async function keepFile(tx: Tx, actor: RetailAuditActor, billId: string, file: UploadedFile) {
+  try {
+    await recordAttachment(tx, actor, { entityType: "PurchaseBill", entityId: billId, kind: "BILL", file });
+  } catch (error) {
+    if (error instanceof AttachmentRefusal) throw invalid({ pdf: error.message });
+    throw error;
+  }
+}
+
+/** "Bill INV-88120 saved, due 12 September." */
+export const billSavedWords = (billNumber: string, due: string) => `Bill ${billNumber} saved, due ${dayMonth(due)}.`;
+
+export async function recordBill(actor: RetailAuditActor, input: BillInput, deps: BillDeps = {}): Promise<BillDone> {
+  const now = deps.now ?? new Date();
+  const companyId = actor.companyId;
+  const created = await prisma.$transaction(async (tx) => {
+    if (input.deliveryId) await tx.$queryRaw`SELECT "id" FROM "RetailGoodsReceipt" WHERE "id" = ${input.deliveryId} FOR UPDATE`;
+    const checked = await checkInput(tx, actor, input, now);
+    const figures = await figuresFor(tx, companyId, checked);
+    let bill: { id: string };
+    try {
+      bill = await tx.purchaseBill.create({
+        data: {
+          companyId,
+          vendorId: checked.vendor.id,
+          goodsReceiptId: checked.delivery?.id ?? null,
+          billNumber: checked.billNumber,
+          billDate: dayStart(checked.billDate),
+          dueDate: dayStart(checked.dueDate),
+          status: "RECEIVED",
+          currency: "USD",
+          ...figures.bill,
+          createdById: actor.userId,
+          issuedById: actor.userId,
+          issuedAt: now,
+          lines: { create: [figures.line] },
+        },
+        select: { id: true },
+      });
+    } catch (error) {
+      if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === "P2002") {
+        const said = `${checked.vendor.name} already sent ${checked.billNumber}.`;
+        throw new BillRefusal(409, said, { no: said });
+      }
+      throw error;
+    }
+    if (input.file) await keepFile(tx, actor, bill.id, input.file);
+    const payload = {
+      billNumber: checked.billNumber,
+      amount: auditAmount(checked.amount),
+      currency: "USD",
+      due: checked.dueDate,
+      delivery: checked.delivery?.receiptNo ?? null,
+    };
+    await writeRetailAuditEvent(tx, { actor, eventType: RETAIL_AUDIT_EVENTS.billRecorded, entityType: "PurchaseBill", entityId: bill.id, payload });
+    if (checked.delivery) {
+      await writeRetailAuditEvent(tx, { actor, eventType: RETAIL_AUDIT_EVENTS.billRecorded, entityType: "RetailGoodsReceipt", entityId: checked.delivery.id, payload });
+    }
+    return { id: bill.id, checked };
+  });
+  const accounting = await postSupplierBill(companyId, created.id, billPostingKey(created.id), { userId: actor.userId, userRole: actor.userRole });
+  await settleSupplierCredits(companyId, created.checked.vendor.id);
+  return {
+    id: created.id,
+    billNumber: created.checked.billNumber,
+    message: billSavedWords(created.checked.billNumber, created.checked.dueDate),
+    accountingStatus: accounting.accountingStatus,
+  };
+}
+
+/* ── Change a bill (W-35 "Change or bin") ───────────────────────────────── */
+
+export type BillPatch = Partial<Omit<BillInput, "file">> & { file?: UploadedFile | null };
+
+export type BillChanged = { id: string; billNumber: string; message: string; changes: Array<{ field: string; from: string | null; to: string | null }> };
+
+/** "US$100.00 is paid against INV-88120." */
+const paidAgainst = (paid: Prisma.Decimal, billNumber: string, currency: string) => `${formatMoney(toNumberOrZero(paid), currency)} is paid against ${billNumber}.`;
+
+export async function changeBill(actor: RetailAuditActor, id: string, patch: BillPatch, deps: BillDeps = {}): Promise<BillChanged> {
+  const now = deps.now ?? new Date();
+  const companyId = actor.companyId;
+  const result = await prisma.$transaction(async (tx) => {
+    await tx.$queryRaw`SELECT "id" FROM "PurchaseBill" WHERE "id" = ${id} FOR UPDATE`;
+    const bill = await tx.purchaseBill.findFirst({
+      where: { id, companyId },
+      select: {
+        id: true,
+        billNumber: true,
+        billDate: true,
+        dueDate: true,
+        total: true,
+        amountPaid: true,
+        currency: true,
+        archivedAt: true,
+        vendorId: true,
+        goodsReceiptId: true,
+        vendor: { select: { name: true } },
+        goodsReceipt: { select: { receiptNo: true } },
+      },
+    });
+    if (!bill) throw new BillRefusal(404, BILL_NOT_FOUND);
+    if (bill.archivedAt) throw new BillRefusal(409, `${bill.billNumber} is in the bin. Restore it first.`);
+    const before = {
+      supplierId: bill.vendorId,
+      deliveryId: bill.goodsReceiptId,
+      billNumber: bill.billNumber,
+      billDate: dayKey(bill.billDate),
+      amount: money(bill.total).toFixed(2),
+      dueDate: bill.dueDate ? dayKey(bill.dueDate) : null,
+    };
+    const supplierId = patch.supplierId ?? before.supplierId;
+    const next = {
+      supplierId,
+      // A new supplier's bill is not for the old supplier's delivery.
+      deliveryId: patch.deliveryId !== undefined ? patch.deliveryId : supplierId === before.supplierId ? before.deliveryId : null,
+      billNumber: patch.billNumber ?? before.billNumber,
+      billDate: patch.billDate ?? before.billDate,
+      amount: patch.amount ?? before.amount,
+      dueDate: patch.dueDate !== undefined ? patch.dueDate : before.dueDate,
+    };
+    const paid = money(bill.amountPaid);
+    if (supplierId !== before.supplierId && paid.greaterThan(0)) {
+      throw new BillRefusal(409, `${paidAgainst(paid, bill.billNumber, bill.currency)} Its supplier cannot change.`);
+    }
+    if (next.deliveryId) await tx.$queryRaw`SELECT "id" FROM "RetailGoodsReceipt" WHERE "id" = ${next.deliveryId} FOR UPDATE`;
+    const checked = await checkInput(tx, actor, { ...next, dueDate: next.dueDate ?? undefined }, now, id);
+    if (paid.greaterThan(checked.amount)) throw new BillRefusal(409, paidAgainst(paid, bill.billNumber, bill.currency), { amt: paidAgainst(paid, bill.billNumber, bill.currency) });
+
+    const after = {
+      supplierId: checked.vendor.id,
+      deliveryId: checked.delivery?.id ?? null,
+      billNumber: checked.billNumber,
+      billDate: checked.billDate,
+      amount: checked.amount.toFixed(2),
+      dueDate: checked.dueDate,
+    };
+    const rebook =
+      after.supplierId !== before.supplierId || after.deliveryId !== before.deliveryId || after.billDate !== before.billDate || after.amount !== before.amount;
+    const figures = await figuresFor(tx, companyId, checked);
+    await tx.purchaseBill.update({
+      where: { id },
+      data: {
+        vendorId: after.supplierId,
+        goodsReceiptId: after.deliveryId,
+        billNumber: after.billNumber,
+        billDate: dayStart(after.billDate),
+        dueDate: dayStart(after.dueDate),
+        ...figures.bill,
+        lines: { deleteMany: {}, create: [figures.line] },
+      },
+    });
+    await recalcPurchaseBillBalance(id, tx);
+
+    const changes: BillChanged["changes"] = [];
+    const words: Record<string, { label: string; kind?: "money"; show: (value: string | null) => Promise<string | null> | string | null }> = {
+      supplierId: { label: "Supplier", show: async (value) => (value ? ((await tx.vendor.findUnique({ where: { id: value }, select: { name: true } }))?.name ?? null) : null) },
+      deliveryId: {
+        label: "For delivery",
+        show: async (value) => (value ? ((await tx.retailGoodsReceipt.findUnique({ where: { id: value }, select: { receiptNo: true } }))?.receiptNo ?? null) : "No delivery"),
+      },
+      billNumber: { label: "Bill number", show: (value) => value },
+      billDate: { label: "Bill date", show: (value) => value },
+      amount: { label: "Amount", kind: "money", show: (value) => value },
+      dueDate: { label: "Due", show: (value) => value },
+    };
+    for (const field of Object.keys(words) as Array<keyof typeof before>) {
+      const from = before[field] ?? null;
+      const to = after[field] ?? null;
+      if (from === to) continue;
+      const word = words[field]!;
+      const shown = { from: await word.show(from), to: await word.show(to) };
+      changes.push({ field, ...shown });
+      await auditRecordEdited(tx, { actor, entityType: "PurchaseBill", entityId: id, field, label: word.label, ...shown, kind: word.kind ?? "text" });
+    }
+    if (patch.file !== undefined) {
+      const had = await tx.retailAttachment.findMany({ where: { companyId, entityType: "PurchaseBill", entityId: id, kind: "BILL" }, select: { id: true, name: true } });
+      const same = patch.file && had.some((file) => file.name === patch.file!.name);
+      if (!same) {
+        await tx.retailAttachment.deleteMany({ where: { id: { in: had.map((file) => file.id) } } });
+        if (patch.file) await keepFile(tx, actor, id, patch.file);
+        changes.push({ field: "file", from: had[0]?.name ?? null, to: patch.file?.name ?? null });
+        await auditRecordEdited(tx, { actor, entityType: "PurchaseBill", entityId: id, field: "file", label: "The bill", from: had[0]?.name ?? null, to: patch.file?.name ?? null });
+      }
+    }
