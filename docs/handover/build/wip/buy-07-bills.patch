+++ b/app/api/v2/retail/buying/bills/compare/route.ts
@@ -0,0 +1,23 @@
+import { NextRequest, NextResponse } from "next/server";
+
+import { errorResponse, successResponse } from "@/lib/api-response";
+import { compareBill } from "@/lib/retail/buying/bill-view";
+import { buyingFailure } from "@/lib/retail/buying/routes";
+import { requireRetailPermission } from "@/lib/retail/permissions";
+
+import { requireRetailSession } from "../../../_helpers";
+
+/** Record a bill's live hints: the amount against the delivery's value with VAT, and the due day by the terms. */
+export async function GET(request: NextRequest) {
+  const { response, session } = await requireRetailSession(request);
+  if (response || !session) return response as NextResponse;
+  const gate = requireRetailPermission(session, "retail.bills", "create");
+  if (gate) return gate;
+  const deliveryId = request.nextUrl.searchParams.get("deliveryId") ?? "";
+  if (!/^[0-9a-f-]{36}$/i.test(deliveryId)) return errorResponse("Delivery not found", 404);
+  try {
+    return successResponse({ data: await compareBill(session.user.companyId, { deliveryId, amount: request.nextUrl.searchParams.get("amount") }) });
+  } catch (error) {
+    return buyingFailure(error, "GET /api/v2/retail/buying/bills/compare");
+  }
+}
