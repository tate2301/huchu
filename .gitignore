# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.env
/worktrees
/.worktrees/

.vercel
.codex
.claude

# Local-only scratch: seeds and browser probes used while verifying a change.
zz-*
scripts/zz-*
# Throwaway Playwright probes — named *.tmp.mjs so a half-finished run cannot
# be committed by a sweep that stages everything.
*.tmp.mjs
test-results/

# graphify: a local knowledge-graph cache, rebuilt from the source it indexes.
# It was committed once by mistake — 274 files of machine-local absolute paths
# and extraction cache, none of it meaningful to anyone else's checkout.
graphify-out/
scratch/

# Playwright artefacts. Screenshots are a deliverable and live in
# docs/screenshots; these two are failure debris — the HTML report and the
# traces, videos and failure shots it links to.
e2e-report/
e2e-results/
# Where `scripts/e2e-coverage.mjs --api` reads its recorded API hits from.
# Deliberately not inside e2e-results/, which Playwright empties on every run.
e2e-coverage/

# Playwright storage state — signed-in sessions, regenerated by auth.setup.ts.
# Contains live session cookies for the local e2e tenants; never commit them.
e2e/.auth/
