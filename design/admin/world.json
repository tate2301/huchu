  "state_notes": {
    "workspace": {
      "Setting up": "Setup is running or a step failed. Nobody can sign in yet.",
      "Trial": "Full plan, no payment yet. Sub-line: days left and the plan it drops to.",
      "Active": "Paid up, or on Free.",
      "Past due": "The period ended unpaid. Everything works for 7 days of grace. Sub-line: the date it goes read-only.",
      "Read-only": "Grace is over. Members can read and export, not write. Paying restores it at once.",
