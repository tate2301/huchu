{
  "$comment": "The admin portal's model. Every screen is a view of this. Names, codes, figures and times here are the only ones screens may use.",
  "tenancy": {
    "unit": "workspace",
    "sub": [],
    "contexts": {
      "global": {
        "name": "All workspaces",
        "holds": [
          "Home: the queue of what waits on staff",
          "Workspaces",
          "People",
          "Payments",
          "Audit log",
          "Operators (owners)"
        ],
        "may_change": [
          "set up a new workspace",
          "operators and their roles",
          "the queue: each queue item acts on its own workspace and wears that workspace’s scope"
        ],
        "never": "changes to one workspace outside the queue"
      },
      "workspace": {
        "name": "the workspace’s own name",
        "holds": [
          "Overview",
          "Members",
          "Plan and billing",
          "Audit log, this workspace only",
          "Settings"
        ],
        "may_change": [
          "everything about this workspace, and nothing else"
        ],
        "enforced": "the server takes the workspace from the URL (/admin/w/<slug>/...) and refuses an action naming any other workspace"
      },
      "switching": "The switcher at the top of the sidebar. Enter: open any workspace, from a row, a search result, a queue item or the switcher. Leave: Esc, the switcher, or Leave workspace on the scope bar.",
      "indicators": [
        "the switcher at the top of the sidebar names the context",
        "a scope bar across the top of every page: neutral for all workspaces, tinted with the workspace’s name, address and standing inside one",
        "the sidebar shows that context’s items only",
        "search inside a workspace searches that workspace, with Search all workspaces as the way out",
        "every confirmation names the workspace it acts on"
      ]
    }
  },
  "roles": [
    {
      "role": "owner",
      "device": "laptop",
      "conditions": "between sales calls, a customer on WhatsApp at the same time",
      "can": [
        "everything support and billing can",
        "close a workspace",
        "invite, change and remove operators",
        "reset an operator's second factor",
        "export a workspace's access record"
      ],
      "cannot": [
        "see a member's password or an operator's authenticator secret"
      ]
    },
    {
      "role": "support",
      "device": "laptop",
      "conditions": "all day, WhatsApp and email open beside it, someone waiting",
      "can": [
        "find anyone",
        "sign in as a member, read-only or with changes",
        "send a password reset, resend an invite, unlock, suspend or restore a member, change a member's role, move ownership",
        "set up a workspace and retry a failed step",
        "suspend and restore a workspace"
      ],
      "cannot": [
        "confirm or reject a payment",
        "change a plan, a trial or an add-on",
        "close a workspace",
        "manage operators"
      ]
    },
    {
      "role": "billing",
      "device": "laptop",
      "conditions": "month end, and when a proof lands; merchant statements open in another tab",
      "can": [
        "find anyone",
        "sign in as a member, read-only only",
        "confirm or reject a proof of payment",
        "record a payment",
        "extend a trial",
        "change a plan or seats",
        "turn an add-on on or off",
        "refund a payment"
      ],
      "cannot": [
        "sign in as a member with changes",
        "change a member's access",
        "suspend a workspace",
        "manage operators"
      ]
    }
  ],
  "never": [
    "No operator sees a member's password, a payment card number or an authenticator secret.",
    "No operator can sign in as another operator.",
    "While signed in as a member, an operator cannot change that member's password, second factor, email or payment method."
  ],
  "records": [
    {
      "record": "workspace",
      "code": "slug, e.g. chikuru-motors",
      "written_by": [
        "setup",
        "billing",
        "operators",
        "the tenant app"
      ],
      "shown_on": [
        "home queue",
        "workspaces",
        "people",
        "payments",
        "audit log"
      ]
    },
    {
      "record": "member",
      "code": "email",
      "written_by": [
        "invites",
        "the tenant app",
        "support"
      ],
      "shown_on": [
        "workspace",
        "people",
        "sign-in-as sessions"
      ]
    },
    {
      "record": "payment",
      "code": "PAY-0000",
      "written_by": [
        "Pesepay webhook",
        "proof upload in the tenant app",
        "billing"
      ],
      "shown_on": [
        "home queue",
        "payments",
        "workspace"
      ]
    },
    {
      "record": "sign-in-as session",
      "code": "SA-000",
      "written_by": [
        "operators"
      ],
      "shown_on": [
        "home queue",
        "workspace activity",
        "member",
        "audit log",
        "the owner's email"
      ]
    },
    {
      "record": "setup",
      "code": "the workspace slug",
      "written_by": [
        "operators",
        "self-serve signup"
      ],
      "shown_on": [
        "home queue",
        "workspace"
      ]
    },
    {
      "record": "operator",
      "code": "email",
      "written_by": [
        "owner"
      ],
      "shown_on": [
        "operators",
        "audit log"
      ]
    },
    {
      "record": "audit event",
      "code": "hash, shown as its first 8 characters",
      "written_by": [
        "every operator action",
        "the system"
      ],
      "shown_on": [
        "the record it concerns",
        "audit log"
      ]
    }
  ],
