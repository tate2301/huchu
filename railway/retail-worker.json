{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node scripts/prisma-generate-if-changed.mjs"
  },
  "deploy": {
    "startCommand": "pnpm worker:retail",
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 120
  }
}
